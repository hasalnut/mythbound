<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token></Properties></Item><Item class="ReplicatedStorage" referent="RBX0000000D"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">ClassData</string><ProtectedString name="Source"><![CDATA[-- The five classes. Numbers come from docs/game-data.md, converted to studs
-- (ranges and speeds multiplied by about 3.5, walk speeds tuned for Roblox).

export type ClassInfo = {
	id: string,
	name: string,
	tagline: string,
	description: string,
	maxHealth: number,
	mana: number, -- MP at level 1
	walkSpeed: number,
	attack: number,
	damageReduction: number,
	style: string, -- "Melee" or "Ranged"
	range: number, -- melee reach in studs
	arc: number, -- melee arc in degrees
	interval: number, -- seconds between basic attacks
	projectileSpeed: number,
	projectileColor: Color3,
	arrow: boolean,
	voidMultiplier: number, -- damage multiplier against void creatures
	maxCompanions: number,
	canTameMythic: boolean,
	color: Color3, -- UI and weapon accent colour
	weapon: string,
}

local ClassData = {}

ClassData.order = { "ninja", "tank", "mage", "priest", "tamer" }

ClassData.classes = {
	ninja = {
		id = "ninja",
		name = "Ninja",
		tagline = "Silent assassin",
		description = "Slips through battle unseen. Enemies notice you from half as far away. Lightning-fast twin daggers.",
		maxHealth = 110,
		mana = 80,
		walkSpeed = 22,
		attack = 12,
		damageReduction = 0.10,
		style = "Melee",
		range = 11,
		arc = 120,
		interval = 0.33,
		projectileSpeed = 0,
		projectileColor = Color3.fromRGB(220, 220, 230),
		arrow = false,
		voidMultiplier = 1,
		maxCompanions = 1,
		canTameMythic = false,
		color = Color3.fromRGB(200, 60, 60),
		weapon = "daggers",
	},
	tank = {
		id = "tank",
		name = "Tank",
		tagline = "Unbreakable guardian",
		description = "Shrugs off blows that would fell anyone else. Takes 45% less damage and swings a heavy sword in a wide arc.",
		maxHealth = 230,
		mana = 60,
		walkSpeed = 17,
		attack = 12,
		damageReduction = 0.45,
		style = "Melee",
		range = 13,
		arc = 143,
		interval = 0.7,
		projectileSpeed = 0,
		projectileColor = Color3.fromRGB(220, 220, 230),
		arrow = false,
		voidMultiplier = 1,
		maxCompanions = 1,
		canTameMythic = false,
		color = Color3.fromRGB(90, 140, 220),
		weapon = "sword_shield",
	},
	mage = {
		id = "mage",
		name = "Mage",
		tagline = "Arcane destroyer",
		description = "Hurls bolts of violet fire from range. Fragile up close, devastating from afar.",
		maxHealth = 90,
		mana = 150,
		walkSpeed = 18,
		attack = 13,
		damageReduction = 0,
		style = "Ranged",
		range = 0,
		arc = 0,
		interval = 0.5,
		projectileSpeed = 125,
		projectileColor = Color3.fromRGB(170, 90, 255),
		arrow = false,
		voidMultiplier = 1,
		maxCompanions = 1,
		canTameMythic = false,
		color = Color3.fromRGB(150, 90, 230),
		weapon = "staff",
	},
	priest = {
		id = "priest",
		name = "Priest",
		tagline = "Light and healing",
		description = "Calls down holy light that deals double damage to creatures of the Void. Healing arrives with class skills.",
		maxHealth = 125,
		mana = 130,
		walkSpeed = 18,
		attack = 10,
		damageReduction = 0.12,
		style = "Ranged",
		range = 0,
		arc = 0,
		interval = 0.55,
		projectileSpeed = 120,
		projectileColor = Color3.fromRGB(255, 215, 110),
		arrow = false,
		voidMultiplier = 2,
		maxCompanions = 1,
		canTameMythic = false,
		color = Color3.fromRGB(240, 200, 90),
		weapon = "holy_staff",
	},
	tamer = {
		id = "tamer",
		name = "Beast Tamer",
		tagline = "Master of the wild",
		description = "Fires arrows and befriends beasts. Keeps three companions at once and is the only class that can tame mythic creatures.",
		maxHealth = 135,
		mana = 90,
		walkSpeed = 19,
		attack = 9,
		damageReduction = 0.15,
		style = "Ranged",
		range = 0,
		arc = 0,
		interval = 0.5,
		projectileSpeed = 190,
		projectileColor = Color3.fromRGB(150, 110, 70),
		arrow = true,
		voidMultiplier = 1,
		maxCompanions = 3,
		canTameMythic = true,
		color = Color3.fromRGB(90, 170, 90),
		weapon = "bow",
	},
} :: { [string]: ClassInfo }

function ClassData.get(id: any): ClassInfo?
	if typeof(id) ~= "string" then
		return nil
	end
	return ClassData.classes[id]
end

return ClassData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">CompanionData</string><ProtectedString name="Source"><![CDATA[-- Companions: limits, taming numbers and stat formulas (docs/game-data.md, CLAUDE.md > Taming).
-- A player owns up to STABLE_SIZE companions (saved in PlayerData.companions) and can have
-- LIMIT of them out at once, or TAMER_LIMIT as a Beast Tamer.

local CreatureData = require(script.Parent:WaitForChild("CreatureData"))

local CompanionData = {}

CompanionData.STABLE_SIZE = 6 -- companions a player can own
CompanionData.LIMIT = 1 -- how many can be out at once
CompanionData.TAMER_LIMIT = 3 -- ... for the Beast Tamer
CompanionData.TAMER_CLASS = "tamer"
CompanionData.MAX_NAME = 24

CompanionData.KNOCKOUT_TIME = 30 -- seconds a knocked-out companion takes to recover
CompanionData.FOCUS_TIME = 8 -- seconds a companion keeps attacking what its owner last hit
CompanionData.THREAT_TIME = 6 -- ... and what last bit its owner or itself

-- Taming by feeding (the trust meter). Distances in studs.
CompanionData.FEED_RANGE = 14 -- how close you must be for the Feed prompt
CompanionData.FEED_GAP = 2 -- seconds between feeds (it is still eating)
CompanionData.FEED_TIMEOUT = 12 -- it loses interest if not fed again within this
CompanionData.CALM_RADIUS = 10 -- stepping this far from where you started feeding fails
CompanionData.STARTLE_RADIUS = 30 -- a dash, attack or skill this close scares passive creatures
CompanionData.JUMP_SPEED = 25 -- moving upwards faster than this counts as a jump
CompanionData.WARY_TIME = 8 -- after a failed attempt it won't take food for this long

-- How many companions a class can have out at once.
function CompanionData.limit(classId: any): number
	return if classId == CompanionData.TAMER_CLASS then CompanionData.TAMER_LIMIT else CompanionData.LIMIT
end

-- Whether a class can bring this creature out. Beasts tamed with Tame Beast need a Beast Tamer.
function CompanionData.canBringOut(classId: any, creatureId: string): boolean
	local creature = CreatureData.creatures[creatureId]
	if not creature then
		return false
	end
	return not creature.tamerOnly or classId == CompanionData.TAMER_CLASS
end

-- Companion HP = creature HP x 1.6 x (1 + 0.1 x (player level - 1)).
function CompanionData.maxHealth(creature: CreatureData.CreatureInfo, level: number): number
	return math.floor(creature.maxHealth * 1.6 * (1 + 0.1 * (level - 1)) + 0.5)
end

-- Companion damage = creature damage (6 if none) x 1.5 x (1 + 0.12 x (player level - 1)),
-- x 1.25 for a Beast Tamer.
function CompanionData.damage(creature: CreatureData.CreatureInfo, level: number, classId: any): number
	local base = if creature.damage > 0 then creature.damage else 6
	local amount = base * 1.5 * (1 + 0.12 * (level - 1))
	if classId == CompanionData.TAMER_CLASS then
		amount *= 1.25
	end
	return amount
end

return CompanionData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Game-wide numbers shared by the server and the client.
-- Distances are in studs (1 stud is about 0.28 m; a default character is about 5 studs tall).

local Config = {
	-- Combat
	CRIT_CHANCE = 0.12,
	CRIT_MULT = 1.7,
	AUTO_AIM_RANGE = 95, -- ranged attacks curve towards a target this close in front of you
	AUTO_AIM_ANGLE = math.rad(35),
	PROJECTILE_LIFETIME = 1.6,
	LOCK_RANGE = 110,

	-- Dash: a short burst of speed with a moment of invulnerability
	DASH_SPEED = 75,
	DASH_TIME = 0.2,
	DASH_COOLDOWN = 2.2,
	DASH_IFRAMES = 0.3,

	RESPAWN_DELAY = 3,

	-- World (Hearthmoor is centred on 0, 0; north is -Z)
	SPAWN_POSITION = Vector3.new(0, 0.5, 49),
	VILLAGE_RADIUS = 165,
	MAP_HALF = 440,

	TAG_DAMAGEABLE = "Damageable",
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">CreatureData</string><ProtectedString name="Source"><![CDATA[-- Creatures that live around Hearthmoor. Numbers from docs/game-data.md, converted to studs.

export type CreatureInfo = {
	id: string,
	name: string,
	maxHealth: number,
	damage: number,
	walkSpeed: number,
	behaviour: string, -- "Hostile" attacks on sight, "Neutral" only fights back, "Passive" flees
	pack: boolean, -- when one is attacked or spots a player, nearby ones of the same kind join in
	aggroRange: number,
	attackRange: number,
	attackInterval: number,
	windup: number, -- seconds of red warning before a bite lands
	leash: number, -- gives up the chase this far from home
	xp: number,
	scale: number,
	color: Color3,
	accent: Color3,
	respawn: number,
	isVoid: boolean,
	fleeRange: number?, -- passive creatures run from players this close (unless calmed by food they like)
	fleeSpeed: number?, -- how fast it runs away
	tameFood: string?, -- item id any class can feed it to tame it
	tameFeeds: number?, -- feeds needed to fill the trust meter
	tamerOnly: boolean?, -- tamed only with the Beast Tamer's Tame Beast skill; only a Beast Tamer can bring it out
}

local CreatureData = {}

CreatureData.TAMED_RESPAWN = 60 -- seconds before a tamed creature's place in the wild is refilled

CreatureData.creatures = {
	wolf = {
		id = "wolf",
		name = "Wolf",
		maxHealth = 60,
		damage = 8,
		walkSpeed = 18,
		behaviour = "Hostile",
		pack = true,
		aggroRange = 55,
		attackRange = 6,
		attackInterval = 1.3,
		windup = 0.45,
		leash = 150,
		xp = 15,
		scale = 1.1,
		color = Color3.fromRGB(120, 124, 132),
		accent = Color3.fromRGB(215, 215, 220),
		respawn = 45,
		isVoid = false,
		tamerOnly = true,
	},
	boar = {
		id = "boar",
		name = "Boar",
		maxHealth = 55,
		damage = 7,
		walkSpeed = 15,
		behaviour = "Neutral",
		pack = false,
		aggroRange = 0,
		attackRange = 6,
		attackInterval = 1.4,
		windup = 0.5,
		leash = 120,
		xp = 12,
		scale = 1.0,
		color = Color3.fromRGB(105, 72, 48),
		accent = Color3.fromRGB(235, 225, 205),
		respawn = 45,
		isVoid = false,
		tamerOnly = true,
	},
	fox = {
		id = "fox",
		name = "Fox",
		maxHealth = 30,
		damage = 6,
		walkSpeed = 17,
		behaviour = "Passive",
		pack = false,
		aggroRange = 0,
		attackRange = 5,
		attackInterval = 1.2,
		windup = 0.35,
		leash = 140,
		xp = 0,
		scale = 0.7,
		color = Color3.fromRGB(214, 120, 50),
		accent = Color3.fromRGB(245, 238, 225),
		respawn = 45,
		isVoid = false,
		fleeRange = 25,
		fleeSpeed = 24,
		tameFood = "meat",
		tameFeeds = 3,
	},
} :: { [string]: CreatureInfo }

-- True for creatures that can become companions (by feeding, or with Tame Beast).
function CreatureData.tameable(id: any): boolean
	local data = if typeof(id) == "string" then CreatureData.creatures[id] else nil
	return data ~= nil and (data.tameFood ~= nil or data.tamerOnly == true)
end

return CreatureData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">ItemData</string><ProtectedString name="Source"><![CDATA[-- Items, recipes and where things come from. From docs/game-data.md.
-- Inventories are saved per player (PlayerData.inventory: { [itemId]: count }).

export type Item = {
	id: string,
	name: string,
	description: string,
	color: Color3, -- placeholder icon colour until real icons exist
	usable: boolean?, -- can be used from the inventory (or its hotkey)
}

export type Recipe = {
	id: string, -- the item it makes
	ingredients: { [string]: number },
	count: number,
}

local ItemData = {}

ItemData.MAX_STACK = 99

ItemData.items = {
	meat = { id = "meat", name = "Meat", description = "From hunted animals. Foxes love it.", color = Color3.fromRGB(190, 80, 70) },
	apple = { id = "apple", name = "Apple", description = "Crisp and red, from the village trees.", color = Color3.fromRGB(220, 50, 45) },
	wheat = { id = "wheat", name = "Wheat", description = "A golden bundle from the field.", color = Color3.fromRGB(232, 196, 92) },
	honey = { id = "honey", name = "Honey", description = "Sticky and sweet. Mind the bees.", color = Color3.fromRGB(240, 165, 40) },
	cookie = { id = "cookie", name = "Cookie", description = "Fairies adore them. The Fairy Queen wants three.", color = Color3.fromRGB(190, 135, 80) },
	healing_potion = { id = "healing_potion", name = "Healing Potion", description = "Restores 45% of your health. Use with H.", color = Color3.fromRGB(235, 70, 120), usable = true },
} :: { [string]: Item }

-- The order items are shown in the inventory.
ItemData.order = { "healing_potion", "meat", "apple", "wheat", "honey", "cookie" }

ItemData.recipes = {
	{ id = "cookie", ingredients = { wheat = 1, honey = 1 }, count = 1 },
	{ id = "healing_potion", ingredients = { apple = 1, honey = 1 }, count = 1 },
} :: { Recipe }

ItemData.POTION_HEAL = 0.45 -- fraction of max health
ItemData.POTION_COOLDOWN = 1

-- What creatures drop when defeated: item, min, max, chance (0-1).
ItemData.drops = {
	wolf = { { item = "meat", min = 1, max = 2, chance = 1 } },
	boar = { { item = "meat", min = 1, max = 2, chance = 1 } },
}

-- Gathering spots in Hearthmoor: seconds between gathers (per player).
ItemData.gather = {
	wheat = { item = "wheat", min = 1, max = 1, cooldown = 30, verb = "Harvest", object = "Wheat field" },
	honey = { item = "honey", min = 1, max = 1, cooldown = 35, verb = "Collect honey", object = "Beehive", sting = { chance = 0.25, damage = 6 } },
	apple = { item = "apple", min = 1, max = 2, cooldown = 40, verb = "Pick apples", object = "Apple tree" },
}

function ItemData.get(id: any): Item?
	return if typeof(id) == "string" then ItemData.items[id] else nil
end

function ItemData.recipe(id: any): Recipe?
	for _, recipe in ItemData.recipes do
		if recipe.id == id then
			return recipe
		end
	end
	return nil
end

return ItemData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- All RemoteEvents live in ReplicatedStorage.Remotes. The server creates them; clients wait for them.
--
-- Client -> server:  ChooseClass(classId), Attack(aimDirection, lockedTarget?), Dash(),
--                    UseSkill(slot, aimDirection, lockedTarget?)
-- Server -> client:  SkillUsed(slot, cooldown) when a skill goes off (starts the HUD cooldown)
-- Items:  client -> server UseItem(itemId), Craft(recipeId)
--         server -> client Inventory(counts), OpenCrafting(), DropSpawned(id, itemId, count, position), DropTaken(id)
-- Server -> client:  DamageNumber(model, position, amount, kind, attacker?), Effect(kind, ...),
--                    Dialogue(speaker, lines), Toast(text), QuestUpdate(quests), LevelUp(player, level)
-- Companions:  client -> server CompanionSetActive(uid, active), CompanionRelease(uid)
--              server -> client Companions(list, limit, stableSize) where each list entry is
--                { uid, id, name, active, allowed, knockedOut (seconds left) }
--              server -> client Taming(creatureModel?, trust 0-1, state, detail): state is
--                "progress" (detail = feeds left), "tamed" (detail = name) or "failed" (detail = why)
--              Feeding itself is a ProximityPrompt, which the server hears directly.
-- Level, XP, XPNext and SavedClass travel as Player attributes, not events.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = { "ChooseClass", "Attack", "Dash", "DamageNumber", "Effect", "Dialogue", "Toast", "QuestUpdate", "LevelUp", "UseSkill", "SkillUsed",
	"Inventory", "UseItem", "Craft", "OpenCrafting", "DropSpawned", "DropTaken",
	"Companions", "Taming", "CompanionSetActive", "CompanionRelease" }

local Net = {}

local isServer = RunService:IsServer()
local folder: Folder

if isServer then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.event(name: string): RemoteEvent
	if isServer then
		return folder:FindFirstChild(name) :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[-- Levels and XP. Formulas from docs/game-data.md. One level per player, shared by every class.

local Progression = {}

Progression.MAX_LEVEL = 20

-- XP needed to go from `level` to the next one.
function Progression.xpToNext(level: number): number
	return 40 + 35 * level
end

function Progression.maxHealth(classHealth: number, level: number): number
	return math.floor(classHealth * (1 + 0.12 * (level - 1)) + 0.5)
end

function Progression.maxMana(classMana: number, level: number): number
	return math.floor(classMana * (1 + 0.06 * (level - 1)) + 0.5)
end

-- MP regained per second: 5 plus 2% of max MP.
function Progression.manaRegen(maxMana: number): number
	return 5 + 0.02 * maxMana
end

function Progression.attack(classAttack: number, level: number): number
	return classAttack * (1 + 0.11 * (level - 1))
end

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">QuestData</string><ProtectedString name="Source"><![CDATA[-- Quests and the people who give them. Progress is per player and saved (see Quests.luau).
-- Objective kinds: "defeat" (target = creature id). Later: "collect" (item id), "reach" (place).

export type Quest = {
	id: string,
	title: string,
	summary: string, -- one line for the tracker
	giver: string, -- key into QuestData.givers
	objective: { kind: string, target: string, count: number },
	rewardXp: number,
	gift: { [string]: number }?, -- items handed over when the quest is given
	lines: {
		offer: { string }, -- said when the quest is given
		active: { string }, -- said while it's under way
		ready: { string }, -- said when it's handed in (the reward follows)
	},
}

local QuestData = {}

QuestData.givers = {
	elder = {
		name = "Elder Maren",
		-- Said once every quest from this giver is done.
		idle = {
			"The fence holds, thanks to you. Rest by the fire a while, traveller.",
			"When the ward at the northern gate lifts, the Crossroads will be open to you. Bring friends; the Rift is no place to go alone.",
		},
	},
}

-- Quests in the order they are offered.
QuestData.order = { "wolves_at_the_fence" }

QuestData.quests = {
	wolves_at_the_fence = {
		id = "wolves_at_the_fence",
		title = "Wolves at the Fence",
		summary = "Defeat wolves outside the fence",
		giver = "elder",
		objective = { kind = "defeat", target = "wolf", count = 4 },
		rewardXp = 50,
		gift = { healing_potion = 3 },
		lines = {
			offer = {
				"Welcome to Hearthmoor, traveller. You've arrived in troubled times.",
				"Three nights ago the eastern sky split open. Something vast coils inside the Rift.",
				"Since then the wolves have grown bold. They prowl right up to our fence, west and east of the village.",
				"Drive off four of them. When they glow red they're about to bite: dash out of the way!",
				"The training dummies east of the campfire will take any punishment while you find your feet.",
				"Take these three potions. Press H to drink one when you're hurt. The workbench by the well can make more.",
			},
			active = {
				"The wolves still circle the fence. Four of them, traveller. West or east of the village.",
			},
			ready = {
				"You're back, and in one piece! The village can sleep tonight.",
				"Take this, and my thanks. You grow stronger with every fight.",
			},
		},
	},
} :: { [string]: Quest }

return QuestData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">SkillData</string><ProtectedString name="Source"><![CDATA[-- Class skills. Numbers from docs/game-data.md; distances converted to studs (metres x 3.5).
-- Slot 1 is Q (controller L1), slot 2 is E (controller R1). Skills.luau on the server runs them.
-- `pending` marks a skill that needs a later slice (none at the moment).
-- The Beast Tamer's skills are run by Taming.luau (Tame Beast) and Companions.luau (Call of the Wild).

export type Skill = {
	id: string,
	name: string,
	mana: number,
	cooldown: number,
	pending: string?, -- message shown instead of using the skill
	[string]: any, -- skill-specific numbers below
}

local SkillData = {}

SkillData.skills = {
	-- Ninja
	vanish = { id = "vanish", name = "Vanish", mana = 25, cooldown = 10, duration = 6, speedBonus = 0.35, backstab = 3 },
	shuriken_fan = { id = "shuriken_fan", name = "Shuriken Fan", mana = 18, cooldown = 4, count = 5, spread = 10, multiplier = 1.1, speed = 150 },
	-- Tank
	taunt = { id = "taunt", name = "Taunt", mana = 15, cooldown = 8, radius = 77, duration = 6, reduction = 0.4, maxReduction = 0.8 },
	shield_slam = { id = "shield_slam", name = "Shield Slam", mana = 20, cooldown = 6, radius = 19, multiplier = 1.8, stun = 2, knockback = 10.5 },
	-- Mage
	fireball = { id = "fireball", name = "Fireball", mana = 22, cooldown = 2.5, multiplier = 3, radius = 17.5, speed = 110 },
	frost_nova = { id = "frost_nova", name = "Frost Nova", mana = 35, cooldown = 9, radius = 31.5, multiplier = 1.4, freeze = 3 },
	-- Priest (heals reach allies within healRadius)
	healing_light = { id = "healing_light", name = "Healing Light", mana = 30, cooldown = 6, healRadius = 70, heal = 0.35, regen = 0.04, regenTime = 5 },
	holy_nova = { id = "holy_nova", name = "Holy Nova", mana = 30, cooldown = 7, radius = 28, multiplier = 2.2, voidMultiplier = 2, healRadius = 70, heal = 0.10 },
	-- Beast Tamer
	-- Tame Beast: the nearest wolf or boar within `range` below `threshold` health.
	-- Chance = baseChance + missingBonus x (missing health fraction).
	tame_beast = { id = "tame_beast", name = "Tame Beast", mana = 20, cooldown = 2, range = 35, threshold = 0.5, baseChance = 0.45, missingBonus = 0.6 },
	-- Call of the Wild: companions hit harder and run faster for `duration` and are healed;
	-- a spirit wolf fights beside you for `spiritTime` (it doesn't count towards the limit).
	call_of_the_wild = { id = "call_of_the_wild", name = "Call of the Wild", mana = 30, cooldown = 14, duration = 8, damageBonus = 0.6, speedBonus = 0.3, heal = 0.3, spirit = "wolf", spiritTime = 12 },
} :: { [string]: Skill }

-- Each class's skills, in slot order (Q, E).
SkillData.byClass = {
	ninja = { "vanish", "shuriken_fan" },
	tank = { "taunt", "shield_slam" },
	mage = { "fireball", "frost_nova" },
	priest = { "healing_light", "holy_nova" },
	tamer = { "tame_beast", "call_of_the_wild" },
}

function SkillData.forClass(classId: any, slot: number): Skill?
	local ids = if typeof(classId) == "string" then SkillData.byClass[classId] else nil
	local id = ids and ids[slot]
	return if id then SkillData.skills[id] else nil
end

return SkillData
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000001F"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000001E"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Assets</string><ProtectedString name="Source"><![CDATA[-- Swappable art. The world builder asks for pieces by name. If a finished model with that name
-- is in ServerStorage.Assets (directly, or inside a zone folder such as Assets/Hearthmoor),
-- a copy of it is placed; otherwise the grey version is built from code. To change how a
-- house, tree or creature looks, drop a model with the same name into ServerStorage.Assets.
-- No code changes are needed. See docs/art-direction.md.
--
-- Rules for replacement models:
--   * Scenery (HouseSmall, Well, Pine, ...): a Model whose PrimaryPart sits at ground level,
--     with the front facing -Z. Without a PrimaryPart the bottom of its bounding box is used.
--   * Creatures (wolf, boar, ...): a Model named after the creature id, with a
--     HumanoidRootPart and a Humanoid whose HipHeight holds the body off the ground.
--     Creature.luau reads these with Assets.find.

local ServerStorage = game:GetService("ServerStorage")

local Assets = {}

export type Builder = (cframe: CFrame, parent: Instance) -> Instance

local cache: { [string]: Model | false } = {}
local warned: { [string]: boolean } = {}

function Assets.folder(): Folder
	local existing = ServerStorage:FindFirstChild("Assets")
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "Assets"
	folder.Parent = ServerStorage
	return folder
end

local function warnOnce(name: string, message: string)
	if not warned[name] then
		warned[name] = true
		warn(`[Assets] {name}: {message}`)
	end
end

-- The replacement model called `name`, or nil if there isn't one. Looks in Assets and one
-- level of zone folders below it, so models nested inside other models are never picked.
function Assets.find(name: string): Model?
	local cached = cache[name]
	if cached ~= nil then
		return if cached then cached else nil
	end
	local found: Model? = nil
	for _, child in Assets.folder():GetChildren() do
		if child:IsA("Model") and child.Name == name then
			found = child
			break
		elseif child:IsA("Folder") then
			local inner = child:FindFirstChild(name)
			if inner and inner:IsA("Model") then
				found = inner
				break
			end
		end
	end
	if found and found:FindFirstChildWhichIsA("LuaSourceContainer", true) then
		warnOnce(name, "contains scripts. Remove them unless you wrote them (free models can hide malicious code).")
	end
	cache[name] = found or false
	return found
end

-- Moves `model` so its PrimaryPart (or the bottom centre of its bounding box) lands on `cframe`.
local function standOn(model: Model, cframe: CFrame)
	if model.PrimaryPart then
		model:PivotTo(cframe)
		return
	end
	local box, size = model:GetBoundingBox()
	local bottom = box * CFrame.new(0, -size.Y / 2, 0)
	model:PivotTo(cframe * bottom:ToObjectSpace(model:GetPivot()))
end

-- Places the scenery piece `name` at `cframe` (ground level, front facing -Z) under `parent`.
-- Uses the replacement model if there is one, otherwise calls `build(cframe, parent)` for the
-- grey version. `scale` resizes a replacement model; the grey builder handles its own size.
function Assets.place(name: string, cframe: CFrame, parent: Instance, build: Builder, scale: number?): Instance
	local template = Assets.find(name)
	if not template then
		return build(cframe, parent)
	end
	local model = template:Clone()
	if scale and math.abs(scale - 1) > 0.001 then
		model:ScaleTo(model:GetScale() * scale)
	end
	standOn(model, cframe)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true -- scenery never moves
		end
	end
	model.Parent = parent
	return model
end

return Assets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[-- Small helpers for building scenery out of anchored parts.

local Build = {}

Build.WALL = Color3.fromRGB(222, 205, 168)
Build.WOOD = Color3.fromRGB(115, 78, 45)
Build.DARK_WOOD = Color3.fromRGB(85, 58, 35)
Build.STONE = Color3.fromRGB(140, 136, 128)
Build.STRAW = Color3.fromRGB(226, 196, 110)
Build.LEAF = Color3.fromRGB(70, 140, 60)
Build.PINE = Color3.fromRGB(40, 95, 55)
Build.BARK = Color3.fromRGB(100, 68, 42)

-- Creates an anchored part. `props` can hold any Part property, plus Class = "Part" | "SpawnLocation" | ...
function Build.part(props: { [string]: any }): BasePart
	local className = props.Class or "Part"
	local part = Instance.new(className) :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	for key, value in props do
		if key ~= "Class" and key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	if parent then
		part.Parent = parent
	end
	return part
end

-- A part placed relative to `base`.
function Build.at(parent: Instance, base: CFrame, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, extra: { [string]: any }?): BasePart
	local props: { [string]: any } = {
		Size = size,
		CFrame = base * offset,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	}
	if extra then
		for key, value in extra do
			props[key] = value
		end
	end
	return Build.part(props)
end

-- A vertical cylinder (Roblox cylinders lie along X, so rotate them upright).
function Build.cylinder(parent: Instance, base: CFrame, height: number, diameter: number, offset: Vector3, color: Color3, material: Enum.Material?, extra: { [string]: any }?): BasePart
	local props: { [string]: any } = {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = base * CFrame.new(offset) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	}
	if extra then
		for key, value in extra do
			props[key] = value
		end
	end
	return Build.part(props)
end

function Build.ball(parent: Instance, position: Vector3, diameter: number, color: Color3, material: Enum.Material?, extra: { [string]: any }?): BasePart
	local props: { [string]: any } = {
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = CFrame.new(position),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	}
	if extra then
		for key, value in extra do
			props[key] = value
		end
	end
	return Build.part(props)
end

-- Welds `part` to `to` where it currently is and makes it ride along without physics of its own.
function Build.weld(part: BasePart, to: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = to
	weld.Part1 = part
	weld.Parent = part
end

function Build.model(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing :: Folder
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- A floating name tag, for NPCs and signs.
function Build.nameTag(adornee: BasePart, text: string, color: Color3?, height: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, height or 2.5, 0)
	gui.MaxDistance = 60
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextColor3 = color or Color3.fromRGB(255, 225, 140)
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui
	gui.Parent = adornee
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include

-- Height of the terrain at (x, z). Ignores water so things never sit on the pond.
function Build.groundY(x: number, z: number): number
	groundParams.FilterDescendantsInstances = { workspace.Terrain }
	groundParams.IgnoreWater = true
	local result = workspace:Raycast(Vector3.new(x, 400, z), Vector3.new(0, -800, 0), groundParams)
	return if result then result.Position.Y else 0
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[-- Server-side combat: damage, player attacks (melee arcs and projectiles) and dashes.
-- Anything that can be hit is a Model tagged "Damageable" with a Humanoid and these attributes:
--   HitRadius (studs), HitHeight (studs above the root), Hostile (bool), Void (bool),
--   DamageReduction (0-1), Invulnerable (bool, set during a dash)
-- Companions are not tagged, so players can't hit, lock on to or auto-aim at them; creatures
-- bite them through Combat.damage like anything else. A model with the NeverDies attribute
-- (companions) stops at 1 health instead of dying.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local ClassData = require(Shared:WaitForChild("ClassData"))
local Net = require(Shared:WaitForChild("Net"))
local Progression = require(Shared:WaitForChild("Progression"))
local SkillData = require(Shared:WaitForChild("SkillData"))

local Combat = {}

local TAG = Config.TAG_DAMAGEABLE
local damageNumberEvent = Net.event("DamageNumber")
local effectEvent = Net.event("Effect")

type HitHandler = (source: Instance?, via: Model?) -> ()
local hitHandlers: { [Model]: HitHandler } = {}
type DamageListener = (model: Model, source: Instance?, via: Model?, dealt: number) -> ()
local damageListeners: { DamageListener } = {}
type ActionListener = (player: Player, kind: string, position: Vector3) -> ()
local actionListeners: { ActionListener } = {}

type Projectile = {
	position: Vector3,
	velocity: Vector3,
	life: number,
	shooter: Player,
	damage: number,
	crit: boolean,
	voidMultiplier: number,
	explodeRadius: number?, -- set for projectiles that burst on impact (Fireball)
	explodeColor: Color3?,
}
local projectiles: { Projectile } = {}

local lastAttack: { [Player]: number } = {}
local lastDash: { [Player]: number } = {}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- False for vectors holding NaN or infinity (a client could send one on purpose).
local function isFinite(v: Vector3): boolean
	local m = v.Magnitude
	return m == m and m < math.huge
end

function Combat.rootOf(model: Model): BasePart?
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function Combat.isAlive(model: Instance?): boolean
	if not model or not model.Parent then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

-- Lets a creature react when it is hit (for example, to chase whoever hit it).
function Combat.onHit(model: Model, handler: HitHandler)
	hitHandlers[model] = handler
	model.Destroying:Connect(function()
		hitHandlers[model] = nil
	end)
end

function Combat.flash(model: Model)
	local highlight = Instance.new("Highlight")
	highlight.Name = "HitFlash"
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.35
	highlight.OutlineTransparency = 1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	task.delay(0.1, function()
		highlight:Destroy()
	end)
end

function Combat.rollDamage(base: number): (number, boolean)
	local crit = math.random() < Config.CRIT_CHANCE
	local amount = base * (0.9 + math.random() * 0.2)
	if crit then
		amount *= Config.CRIT_MULT
	end
	return amount, crit
end

-- Deals damage after damage reduction. `source` is the attacking Player or creature Model.
-- When a player's companion does the biting, `source` is the player (who gets the credit) and
-- `via` is the companion's model.
function Combat.damage(model: Model, amount: number, source: Instance?, crit: boolean?, via: Model?): number
	if not Combat.isAlive(model) then
		return 0
	end
	if model:GetAttribute("Invulnerable") then
		return 0
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local reduction = (model:GetAttribute("DamageReduction") :: number?) or 0
	local dealt = math.max(1, math.floor(amount * (1 - reduction) + 0.5))
	local floor = if model:GetAttribute("NeverDies") then 1 else 0 -- companions are knocked out, not killed
	humanoid.Health = math.max(floor, humanoid.Health - dealt)

	local friendly = Players:GetPlayerFromCharacter(model) ~= nil or model:GetAttribute("NeverDies") == true
	local root = Combat.rootOf(model)
	if root then
		local height = (model:GetAttribute("HitHeight") :: number?) or 4
		local kind = if friendly then "hurt" elseif crit then "crit" else "normal"
		-- `attacker` moves that player's target frame; a companion's bites don't.
		local attacker = if source and source:IsA("Player") and not via then source else nil
		damageNumberEvent:FireAllClients(model, root.Position + Vector3.new(0, height, 0), dealt, kind, attacker)
	end
	if not friendly then
		Combat.flash(model)
	end
	local handler = hitHandlers[model]
	if handler then
		task.spawn(handler, source, via)
	end
	for _, listener in damageListeners do
		task.spawn(listener, model, source, via, dealt)
	end
	return dealt
end

-- Runs `listener(model, source, via, dealt)` after every hit (Companions picks targets from it,
-- Taming notices when a creature being fed is hurt).
function Combat.onDamage(listener: DamageListener)
	table.insert(damageListeners, listener)
end

-- Runs `listener(player, kind, position)` when a player attacks, dashes or uses a skill
-- (`kind` is "attack", "dash" or "skill"). Sudden moves like these startle creatures.
function Combat.onAction(listener: ActionListener)
	table.insert(actionListeners, listener)
end

function Combat.noteAction(player: Player, kind: string)
	local character = player.Character
	local root = character and Combat.rootOf(character)
	if not root then
		return
	end
	for _, listener in actionListeners do
		task.spawn(listener, player, kind, root.Position)
	end
end

function Combat.targets(): { Model }
	local list = {}
	for _, inst in CollectionService:GetTagged(TAG) do
		if inst:IsA("Model") and inst:IsDescendantOf(workspace) and Combat.isAlive(inst) then
			table.insert(list, inst)
		end
	end
	return list
end

-- Picks the best target in front of `origin`: close, near the aim line, hostile ones first.
function Combat.bestTarget(origin: Vector3, direction: Vector3, range: number, maxAngle: number): Model?
	local best: Model? = nil
	local bestScore = math.huge
	for _, model in Combat.targets() do
		local root = Combat.rootOf(model)
		if root then
			local to = flat(root.Position - origin)
			local distance = to.Magnitude
			local radius = (model:GetAttribute("HitRadius") :: number?) or 2
			if distance <= range + radius then
				local angle = if distance > 0.1 then math.acos(math.clamp(to.Unit:Dot(direction), -1, 1)) else 0
				if angle <= maxAngle or distance <= radius + 3 then
					local score = distance + angle * 20 - (if model:GetAttribute("Hostile") then 15 else 0)
					if score < bestScore then
						best = model
						bestScore = score
					end
				end
			end
		end
	end
	return best
end

local function melee(player: Player, root: BasePart, direction: Vector3, info: ClassData.ClassInfo, attack: number)
	local halfArc = math.rad(info.arc) / 2
	-- A Ninja attacking from Vanish lands a backstab on everything in the swing, then reappears.
	local character = root.Parent
	local backstab = character ~= nil and character:GetAttribute("Vanished") == true
	local hitAny = false
	for _, model in Combat.targets() do
		local targetRoot = Combat.rootOf(model)
		if targetRoot then
			local to = flat(targetRoot.Position - root.Position)
			local radius = (model:GetAttribute("HitRadius") :: number?) or 2
			local distance = to.Magnitude
			if distance <= info.range + radius then
				local inArc = distance <= radius + 1.5 or math.acos(math.clamp(to.Unit:Dot(direction), -1, 1)) <= halfArc
				if inArc then
					local amount, crit = Combat.rollDamage(attack)
					if backstab then
						amount *= SkillData.skills.vanish.backstab
					end
					Combat.damage(model, amount, player, crit or backstab)
					hitAny = true
				end
			end
		end
	end
	if backstab and hitAny and character then
		character:SetAttribute("Vanished", nil)
	end
	effectEvent:FireAllClients("swing", root.Position + direction * (info.range * 0.45), direction, info.color, info.range)
end

local function shoot(player: Player, character: Model, root: BasePart, direction: Vector3, info: ClassData.ClassInfo, locked: Model?, attack: number)
	local start = root.Position + Vector3.new(0, 1.5, 0) + direction * 2
	local target = locked or Combat.bestTarget(root.Position, direction, Config.AUTO_AIM_RANGE, Config.AUTO_AIM_ANGLE)
	local aim = direction
	if target then
		local targetRoot = Combat.rootOf(target)
		if targetRoot then
			aim = (targetRoot.Position - start).Unit
		end
	end
	local amount, crit = Combat.rollDamage(attack)
	local projectile: Projectile = {
		position = start,
		velocity = aim * info.projectileSpeed,
		life = Config.PROJECTILE_LIFETIME,
		shooter = player,
		damage = amount,
		crit = crit,
		voidMultiplier = info.voidMultiplier,
	}
	table.insert(projectiles, projectile)
	effectEvent:FireAllClients("bolt", start, projectile.velocity, info.projectileColor, Config.PROJECTILE_LIFETIME, info.arrow, character)
end

local function onAttack(player: Player, aim: any, locked: any)
	if typeof(aim) ~= "Vector3" or not isFinite(aim) then
		return
	end
	local character = player.Character
	if not character or not Combat.isAlive(character) then
		return
	end
	local info = ClassData.get(player:GetAttribute("Class"))
	if not info then
		return
	end
	local now = os.clock()
	if now - (lastAttack[player] or 0) < info.interval * 0.85 then
		return -- too soon; the client enforces the real cooldown
	end
	lastAttack[player] = now

	local root = Combat.rootOf(character)
	if not root then
		return
	end
	local direction = flat(aim)
	if direction.Magnitude < 0.01 then
		direction = flat(root.CFrame.LookVector)
	end
	direction = direction.Unit

	local lockedModel: Model? = nil
	if typeof(locked) == "Instance" and locked:IsA("Model") and CollectionService:HasTag(locked, TAG) and Combat.isAlive(locked) then
		-- Only honour a lock on something the client could really have locked on to.
		local lockedRoot = Combat.rootOf(locked)
		if lockedRoot and (lockedRoot.Position - root.Position).Magnitude <= Config.LOCK_RANGE * 1.3 then
			lockedModel = locked
		end
	end

	Combat.noteAction(player, "attack")
	local attack = Progression.attack(info.attack, (player:GetAttribute("Level") :: number?) or 1)
	if info.style == "Melee" then
		melee(player, root, direction, info, attack)
	else
		shoot(player, character, root, direction, info, lockedModel, attack)
	end
end

local function onDash(player: Player)
	local character = player.Character
	if not character or not Combat.isAlive(character) then
		return
	end
	local now = os.clock()
	if now - (lastDash[player] or -100) < Config.DASH_COOLDOWN * 0.85 then
		return
	end
	lastDash[player] = now
	Combat.noteAction(player, "dash")
	character:SetAttribute("Invulnerable", true)
	task.delay(Config.DASH_IFRAMES, function()
		if character.Parent then
			character:SetAttribute("Invulnerable", nil)
		end
	end)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function findDamageable(part: Instance): Model?
	local model = part:FindFirstAncestorWhichIsA("Model")
	while model do
		if CollectionService:HasTag(model, TAG) then
			return model
		end
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end

local function stepProjectiles(dt: number)
	if #projectiles == 0 then
		return
	end
	-- Projectiles pass through every player and companion (no friendly fire).
	local exclude: { Instance } = { workspace:FindFirstChild("Companions") }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude

	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		local step = p.velocity * dt
		local result = workspace:Raycast(p.position, step, rayParams)
		p.life -= dt
		if result then
			if p.explodeRadius then
				Combat.explode(p.shooter, result.Position, p.explodeRadius, p.damage, p.crit, p.voidMultiplier, p.explodeColor)
			else
				local model = findDamageable(result.Instance)
				if model then
					local amount = p.damage
					if model:GetAttribute("Void") then
						amount *= p.voidMultiplier
					end
					Combat.damage(model, amount, p.shooter, p.crit)
				end
			end
			table.remove(projectiles, i)
		elseif p.life <= 0 then
			table.remove(projectiles, i)
		else
			p.position += step
		end
	end
end

-- Damageable models (creatures, dummies) within `radius` studs of `position`, measured to their edge.
function Combat.targetsNear(position: Vector3, radius: number): { Model }
	local list = {}
	for _, model in Combat.targets() do
		local root = Combat.rootOf(model)
		if root then
			local size = (model:GetAttribute("HitRadius") :: number?) or 2
			if flat(root.Position - position).Magnitude <= radius + size then
				table.insert(list, model)
			end
		end
	end
	return list
end

-- Living player characters within `radius` studs of `position` (allies, for healing).
function Combat.playersNear(position: Vector3, radius: number): { Model }
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and Combat.rootOf(character)
		if character and root and Combat.isAlive(character) and (root.Position - position).Magnitude <= radius then
			table.insert(list, character)
		end
	end
	return list
end

-- An expanding ring of light that every player sees (novas, explosions, heals).
function Combat.burst(position: Vector3, radius: number, color: Color3)
	effectEvent:FireAllClients("burst", position, radius, color)
end

-- A small puff of sparks that every player sees (feeding a creature, a failed taming).
function Combat.spark(position: Vector3, color: Color3)
	effectEvent:FireAllClients("spark", position, color)
end

-- Damages everything within `radius` of `position`, with the burst effect.
function Combat.explode(shooter: Player, position: Vector3, radius: number, damage: number, crit: boolean, voidMultiplier: number, color: Color3?)
	for _, model in Combat.targetsNear(position, radius) do
		local amount = damage
		if model:GetAttribute("Void") then
			amount *= voidMultiplier
		end
		Combat.damage(model, amount, shooter, crit)
	end
	Combat.burst(position, radius, color or Color3.fromRGB(255, 140, 60))
end

export type ProjectileOptions = {
	color: Color3,
	arrow: boolean?,
	size: number?, -- diameter of the visible orb
	explodeRadius: number?,
	voidMultiplier: number?,
}

-- Launches a server projectile (it passes through players) and tells every client to draw it.
function Combat.fireProjectile(shooter: Player, start: Vector3, velocity: Vector3, damage: number, crit: boolean, options: ProjectileOptions)
	table.insert(projectiles, {
		position = start,
		velocity = velocity,
		life = Config.PROJECTILE_LIFETIME,
		shooter = shooter,
		damage = damage,
		crit = crit,
		voidMultiplier = options.voidMultiplier or 1,
		explodeRadius = options.explodeRadius,
		explodeColor = options.color,
	})
	effectEvent:FireAllClients("bolt", start, velocity, options.color, Config.PROJECTILE_LIFETIME, options.arrow == true, shooter.Character, options.size)
end

-- Heals a player character or a companion and shows a green number. Returns how much was healed.
function Combat.heal(character: Model, amount: number): number
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = Combat.rootOf(character)
	if not humanoid or humanoid.Health <= 0 or not root then
		return 0
	end
	local before = humanoid.Health
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	local healed = humanoid.Health - before
	if healed >= 1 then
		damageNumberEvent:FireAllClients(character, root.Position + Vector3.new(0, 4, 0), math.floor(healed + 0.5), "heal")
	end
	return healed
end

function Combat.start()
	Net.event("Attack").OnServerEvent:Connect(onAttack)
	Net.event("Dash").OnServerEvent:Connect(onDash)
	RunService.Heartbeat:Connect(stepProjectiles)
	Players.PlayerRemoving:Connect(function(player)
		lastAttack[player] = nil
		lastDash[player] = nil
	end)
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Companions</string><ProtectedString name="Source"><![CDATA[-- Companions: tamed creatures that follow their owner and fight for them.
--
-- Each player's companions are saved in PlayerData.companions (shared by all their classes).
-- The ones marked `active` are out: they follow the owner, attack whatever the owner last hit
-- (or whatever is biting the owner or them), and are knocked out instead of killed, getting up
-- again after CompanionData.KNOCKOUT_TIME. A class can have CompanionData.limit of them out.
-- A companion's bite is credited to its owner (XP, quest credit, loot).
--
-- Their bodies aren't tagged Damageable, so players can't hit or lock on to them, and they don't
-- collide with players or each other. Everything here runs on the server: clients get the
-- Companions event (for the panel) and read health from the replicated models, which carry the
-- attributes OwnerId, CompanionUid, CompanionName, State, KnockedOut and Spirit.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionData = require(Shared:WaitForChild("CompanionData"))
local Config = require(Shared:WaitForChild("Config"))
local CreatureData = require(Shared:WaitForChild("CreatureData"))
local Net = require(Shared:WaitForChild("Net"))
local Build = require(script.Parent:WaitForChild("Build"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Creature = require(script.Parent:WaitForChild("Creature"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local Companions = {}

local THINK_INTERVAL = 0.1
local SETTLE_TIME = 0.4 -- a new body is held still this long before physics takes over
local FOLLOW_DISTANCE = 7 -- how far behind the owner a companion waits
local FOLLOW_SLACK = 3 -- it doesn't shuffle about for less than this
local TELEPORT_DISTANCE = 90 -- further behind than this, it reappears beside the owner
local TARGET_RANGE = 80 -- targets further than this from the owner are left alone
local WINDUP = 0.35 -- seconds between deciding to bite and the bite landing
local RECOVER = 0.4
local REGEN = 0.03 -- fraction of max health regained per second out of a fight
local FALL_LIMIT = -60
local REQUEST_COOLDOWN = 0.4 -- seconds between panel requests from one player
local GROUP = "Companions"
local PLAYER_GROUP = "Players"
local SLOT_ANGLES = { 155, 205, 180, 120 } -- degrees round from straight ahead: they fan out behind the owner
local SPIRIT_SLOT = 4
local SPIRIT_COLOR = Color3.fromRGB(150, 235, 255)
local TAG = Config.TAG_DAMAGEABLE

type Entry = PlayerData.CompanionEntry
type Companion = {
	owner: Player,
	entry: Entry?, -- nil for the spirit wolf, which isn't saved
	data: CreatureData.CreatureInfo,
	name: string,
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	state: string, -- "Follow" | "Chase" | "Windup" | "Recover" | "KnockedOut"
	timer: number,
	nextAttack: number,
	target: Model?,
	threat: Model?, -- the creature that last bit it
	threatAt: number,
	settleUntil: number?,
	koUntil: number,
	expiresAt: number?, -- the spirit wolf fades at this time
	moving: boolean, -- walking back to its place behind the owner
	rootHeight: number, -- how far above the ground its root rides
	damage: number,
}
type Mark = { model: Model, at: number }
type Buff = { untilTime: number, damage: number, speed: number }

local out: { [Player]: { Companion } } = {}
local byModel: { [Model]: Companion } = {}
local focus: { [Player]: Mark } = {} -- what each player last damaged
local ownerThreat: { [Player]: Mark } = {} -- what last bit each player
local knockedUntil: { [Player]: { [number]: number } } = {} -- uid -> when it recovers (kept while it is sent home)
local buffs: { [Player]: Buff } = {} -- Call of the Wild
local lastRequest: { [Player]: number } = {}

local companionsEvent = Net.event("Companions")
local toastEvent = Net.event("Toast")

local function getFolder(): Folder
	return Build.folder("Companions", workspace)
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function listOf(player: Player): { Companion }
	local list = out[player]
	if not list then
		list = {}
		out[player] = list
	end
	return list
end

local function knockedOf(player: Player): { [number]: number }
	local map = knockedUntil[player]
	if not map then
		map = {}
		knockedUntil[player] = map
	end
	return map
end

local function rosterOf(player: Player): { Entry }?
	local data = PlayerData.get(player)
	return data and data.companions
end

-- The owner's living character, its root and its Humanoid (or nils).
local function ownerParts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character or not Combat.isAlive(character) then
		return nil, nil, nil
	end
	return character, Combat.rootOf(character), character:FindFirstChildOfClass("Humanoid")
end

local function yawOf(cframe: CFrame): number
	local _, yaw = cframe:ToOrientation()
	return yaw
end

-- The point on the ground where companion number `slot` waits: behind the owner, fanned out.
local function slotPosition(root: BasePart, slot: number): Vector3
	local angle = SLOT_ANGLES[(slot - 1) % #SLOT_ANGLES + 1]
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	local direction = CFrame.Angles(0, math.rad(angle), 0):VectorToWorldSpace(look.Unit)
	local point = root.Position + direction * FOLLOW_DISTANCE
	return Vector3.new(point.X, Build.groundY(point.X, point.Z), point.Z)
end

local function slotOf(c: Companion): number
	if not c.entry then
		return SPIRIT_SLOT
	end
	local slot = 0
	for _, other in listOf(c.owner) do
		if other.entry then
			slot += 1
		end
		if other == c then
			break
		end
	end
	return math.max(slot, 1)
end

-- How many of the player's saved companions are out (the spirit wolf doesn't count).
local function countOut(player: Player): number
	local count = 0
	for _, c in listOf(player) do
		if c.entry then
			count += 1
		end
	end
	return count
end

local function findOut(player: Player, uid: number): Companion?
	for _, c in listOf(player) do
		if c.entry and c.entry.uid == uid then
			return c
		end
	end
	return nil
end

function Companions.limit(player: Player): number
	return CompanionData.limit(player:GetAttribute("Class"))
end

-- Sends the player their list for the companion panel.
local function send(player: Player)
	local roster = rosterOf(player)
	if not roster then
		return
	end
	local now = os.clock()
	local classId = player:GetAttribute("Class")
	local knocked = knockedOf(player)
	local list = {}
	for _, entry in roster do
		local recoverAt = knocked[entry.uid]
		table.insert(list, {
			uid = entry.uid,
			id = entry.id,
			name = entry.name,
			active = entry.active,
			allowed = CompanionData.canBringOut(classId, entry.id),
			knockedOut = if recoverAt and recoverAt > now then math.ceil(recoverAt - now) else 0,
		})
	end
	companionsEvent:FireClient(player, list, CompanionData.limit(classId), CompanionData.STABLE_SIZE)
end

-- Health and damage follow the owner's level (and class, for the Beast Tamer's bonus).
local function applyStats(c: Companion, heal: boolean)
	local level = (c.owner:GetAttribute("Level") :: number?) or 1
	local maxHealth = CompanionData.maxHealth(c.data, level)
	c.humanoid.MaxHealth = maxHealth
	if heal then
		c.humanoid.Health = maxHealth
	end
	c.damage = CompanionData.damage(c.data, level, c.owner:GetAttribute("Class"))
end

local function despawn(c: Companion, poof: boolean)
	local list = out[c.owner]
	local index = list and table.find(list, c)
	if list and index then
		table.remove(list, index)
	end
	byModel[c.model] = nil
	if poof and c.root.Parent then
		Combat.burst(c.root.Position, 5, Color3.fromRGB(200, 230, 255))
	end
	c.model:Destroy()
end

local function despawnAll(player: Player)
	for _, c in table.clone(listOf(player)) do
		despawn(c, false)
	end
end

-- Stands the companion upright on the ground at `point`, keeping the way it faces.
local function standAt(c: Companion, point: Vector3)
	local y = Build.groundY(point.X, point.Z) + c.rootHeight
	c.model:PivotTo(CFrame.new(point.X, y, point.Z) * CFrame.Angles(0, yawOf(c.root.CFrame), 0))
	c.root.AssemblyLinearVelocity = Vector3.zero
end

local function face(c: Companion, position: Vector3)
	local from = c.root.Position
	local flatTarget = Vector3.new(position.X, from.Y, position.Z)
	if (flatTarget - from).Magnitude > 0.1 then
		c.root.CFrame = CFrame.lookAt(from, flatTarget)
	end
end

-- A soft outline for `seconds` (Call of the Wild).
local function glow(model: Model, seconds: number)
	local highlight = Instance.new("Highlight")
	highlight.Name = "WildGlow"
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(140, 255, 150)
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	Debris:AddItem(highlight, seconds)
end

-- Knocked out instead of killed: it lies down, can't be hit, and gets up after KNOCKOUT_TIME.
local function knockOut(c: Companion)
	if c.state == "KnockedOut" or not byModel[c.model] then
		return
	end
	local entry = c.entry
	if not entry then
		despawn(c, true) -- the spirit wolf just fades away
		return
	end
	c.state = "KnockedOut"
	c.target = nil
	c.moving = false
	c.koUntil = os.clock() + CompanionData.KNOCKOUT_TIME
	knockedOf(c.owner)[entry.uid] = c.koUntil
	c.model:SetAttribute("KnockedOut", true)
	c.model:SetAttribute("Invulnerable", true)
	c.humanoid.DisplayName = `{c.name} (knocked out)`
	c.settleUntil = nil
	c.root.Anchored = true
	-- Lie on its side on the ground.
	local position = c.root.Position
	local ground = Build.groundY(position.X, position.Z)
	c.model:PivotTo(CFrame.new(position.X, ground + c.root.Size.X / 2 + 0.2, position.Z)
		* CFrame.Angles(0, yawOf(c.root.CFrame), math.rad(90)))
	toastEvent:FireClient(c.owner, `{c.name} was knocked out. It will recover in {CompanionData.KNOCKOUT_TIME} s`)
	send(c.owner)
end

local function recover(c: Companion)
	c.state = "Follow"
	c.koUntil = 0
	if c.entry then
		knockedOf(c.owner)[c.entry.uid] = nil
	end
	c.model:SetAttribute("KnockedOut", nil)
	c.model:SetAttribute("Invulnerable", nil)
	c.humanoid.DisplayName = `{c.owner.DisplayName}'s {c.name}`
	c.humanoid.Health = c.humanoid.MaxHealth
	local _, ownerRoot = ownerParts(c.owner)
	local position = c.root.Position
	if ownerRoot and flatDistance(position, ownerRoot.Position) > TELEPORT_DISTANCE then
		position = slotPosition(ownerRoot, slotOf(c)) -- the owner moved on: get up beside them
	end
	standAt(c, position)
	c.root.Anchored = false
	c.root:SetNetworkOwner(nil)
	toastEvent:FireClient(c.owner, `{c.name} is back on its feet`)
	send(c.owner)
end

-- Builds a companion's body standing on `ground`, facing `yaw`.
local function spawn(player: Player, entry: Entry?, data: CreatureData.CreatureInfo, ground: Vector3, yaw: number?, name: string): Companion
	local model, humanoid, root = Creature.buildBody(data, ground, getFolder(), false)
	if yaw then
		model:PivotTo(CFrame.new(model:GetPivot().Position) * CFrame.Angles(0, yaw, 0))
	end
	model.Name = name
	humanoid.DisplayName = `{player.DisplayName}'s {name}`
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false) -- knocked out, never dead (see think)
	model:SetAttribute("NeverDies", true)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("CompanionUid", if entry then entry.uid else 0)
	model:SetAttribute("CompanionName", name)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = GROUP
		end
	end
	local c: Companion = {
		owner = player,
		entry = entry,
		data = data,
		name = name,
		model = model,
		humanoid = humanoid,
		root = root,
		state = "Follow",
		timer = 0,
		nextAttack = 0,
		target = nil,
		threat = nil,
		threatAt = 0,
		settleUntil = os.clock() + SETTLE_TIME,
		koUntil = 0,
		expiresAt = nil,
		moving = false,
		rootHeight = root.Position.Y - ground.Y,
		damage = 0,
	}
	applyStats(c, true)
	table.insert(listOf(player), c)
	byModel[model] = c
	Combat.onHit(model, function()
		if humanoid.Health <= 1 then
			knockOut(c)
		end
	end)
	return c
end

local function validTarget(model: Model?, ownerPosition: Vector3): boolean
	if not model or not model.Parent or not Combat.isAlive(model) or not CollectionService:HasTag(model, TAG) then
		return false
	end
	local root = Combat.rootOf(model)
	return root ~= nil and (root.Position - ownerPosition).Magnitude <= TARGET_RANGE
end

-- What to attack: whatever the owner last hit, else whatever last bit this companion, else
-- whatever last bit the owner.
local function pickTarget(c: Companion, now: number, ownerPosition: Vector3): Model?
	local mark = focus[c.owner]
	if mark and now - mark.at <= CompanionData.FOCUS_TIME and validTarget(mark.model, ownerPosition) then
		return mark.model
	end
	if c.threat and now - c.threatAt <= CompanionData.THREAT_TIME and validTarget(c.threat, ownerPosition) then
		return c.threat
	end
	local threat = ownerThreat[c.owner]
	if threat and now - threat.at <= CompanionData.THREAT_TIME and validTarget(threat.model, ownerPosition) then
		return threat.model
	end
	return nil
end

local function think(c: Companion, dt: number)
	local now = os.clock()
	local settleUntil = c.settleUntil
	if settleUntil then
		if now < settleUntil then
			return
		end
		c.settleUntil = nil
		c.root.Anchored = false
		c.root:SetNetworkOwner(nil) -- the server moves companions
	end
	if c.expiresAt and now >= c.expiresAt then
		despawn(c, true)
		return
	end
	if c.state == "KnockedOut" then
		if now >= c.koUntil then
			recover(c)
		end
		return
	end
	if c.humanoid.Health <= 1 then
		knockOut(c) -- safety net: health drained some way other than Combat.damage
		return
	end
	local _, ownerRoot, ownerHumanoid = ownerParts(c.owner)
	if not ownerRoot or not ownerHumanoid then
		c.humanoid:MoveTo(c.root.Position) -- the owner is down: wait (their companions are cleared when they fall)
		return
	end
	local position = c.root.Position
	local ownerPosition = ownerRoot.Position
	if position.Y < FALL_LIMIT or flatDistance(position, ownerPosition) > TELEPORT_DISTANCE then
		standAt(c, slotPosition(ownerRoot, slotOf(c)))
		c.state = "Follow"
		c.target = nil
		c.moving = false
		return
	end

	local buff = buffs[c.owner]
	local damageBonus, speedBonus = 1, 1
	if buff and now < buff.untilTime then
		damageBonus, speedBonus = buff.damage, buff.speed
	end

	if c.state == "Follow" or c.state == "Chase" then
		c.target = pickTarget(c, now, ownerPosition)
		c.state = if c.target then "Chase" else "Follow"
	end

	if c.state == "Follow" then
		if c.humanoid.Health < c.humanoid.MaxHealth then
			c.humanoid.Health = math.min(c.humanoid.MaxHealth, c.humanoid.Health + c.humanoid.MaxHealth * REGEN * dt)
		end
		local toOwner = flatDistance(position, ownerPosition)
		if toOwner > FOLLOW_DISTANCE + FOLLOW_SLACK + 1 then
			c.moving = true -- the owner walked off: catch up
		end
		if c.moving then
			local goal = slotPosition(ownerRoot, slotOf(c))
			if flatDistance(position, goal) <= FOLLOW_SLACK then
				c.moving = false
				c.humanoid:MoveTo(position)
			else
				local speed = math.max(c.data.walkSpeed, ownerHumanoid.WalkSpeed * 1.1) * speedBonus
				if toOwner > 30 then
					speed *= 1.5
				end
				c.humanoid.WalkSpeed = speed
				c.humanoid:MoveTo(goal)
			end
		end
	elseif c.state == "Chase" then
		local targetRoot = c.target and Combat.rootOf(c.target)
		if not targetRoot then
			c.state = "Follow"
			return
		end
		if flatDistance(position, targetRoot.Position) <= c.data.attackRange + 1.5 then
			c.humanoid:MoveTo(position) -- stop
			face(c, targetRoot.Position)
			if now >= c.nextAttack then
				c.state = "Windup"
				c.timer = WINDUP
			end
		else
			c.humanoid.WalkSpeed = math.max(c.data.walkSpeed, ownerHumanoid.WalkSpeed) * 1.1 * speedBonus
			c.humanoid:MoveTo(targetRoot.Position)
		end
	elseif c.state == "Windup" then
		local target = c.target
		local targetRoot = if target and Combat.isAlive(target) then Combat.rootOf(target) else nil
		if targetRoot then
			face(c, targetRoot.Position)
		end
		c.timer -= dt
		if c.timer <= 0 then
			if target and targetRoot and flatDistance(position, targetRoot.Position) <= c.data.attackRange + 3 then
				local amount, crit = Combat.rollDamage(c.damage * damageBonus)
				Combat.damage(target, amount, c.owner, crit, c.model) -- the owner gets the credit
			end
			c.nextAttack = now + c.data.attackInterval
			c.state = "Recover"
			c.timer = RECOVER
		end
	elseif c.state == "Recover" then
		c.timer -= dt
		if c.timer <= 0 then
			c.state = "Chase"
		end
	end
end

-- Brings out the companions marked active, as far as the player's class allows; the rest are
-- sent home. Called when the character spawns (so also after a class change).
function Companions.refresh(player: Player)
	local roster = rosterOf(player)
	if not roster then
		return
	end
	despawnAll(player)
	local _, root = ownerParts(player)
	local classId = player:GetAttribute("Class")
	local limit = CompanionData.limit(classId)
	local count = 0
	local changed = false
	for _, entry in roster do
		if entry.active then
			local data = CreatureData.creatures[entry.id]
			if data and count < limit and CompanionData.canBringOut(classId, entry.id) then
				count += 1
				if root then
					spawn(player, entry, data, slotPosition(root, count), yawOf(root.CFrame), entry.name)
				end
			else
				entry.active = false
				changed = true
			end
		end
	end
	if changed then
		PlayerData.markDirty(player)
	end
	send(player)
end

-- Whether `player` could take on a newly tamed creature of this kind. Returns false and why not.
function Companions.canTame(player: Player, data: CreatureData.CreatureInfo): (boolean, string?)
	local roster = rosterOf(player)
	if not roster then
		return false, "Your progress hasn't loaded yet"
	end
	if data.tamerOnly and player:GetAttribute("Class") ~= CompanionData.TAMER_CLASS then
		return false, `Only a Beast Tamer can tame a {string.lower(data.name)}`
	end
	if #roster >= CompanionData.STABLE_SIZE then
		return false, `You already have {CompanionData.STABLE_SIZE} companions. Release one first (P)`
	end
	return true, nil
end

-- Adds a newly tamed creature to the player's companions. It comes out at `position` facing
-- `yaw` (where the wild creature stood) if there's room; otherwise it waits at home.
function Companions.add(player: Player, data: CreatureData.CreatureInfo, position: Vector3, yaw: number?): boolean
	local save = PlayerData.get(player)
	if not save or not Companions.canTame(player, data) then
		return false
	end
	local entry: Entry = { uid = save.nextCompanionUid, id = data.id, name = data.name, active = false }
	save.nextCompanionUid += 1
	table.insert(save.companions, entry)
	local limit = Companions.limit(player)
	if countOut(player) < limit and CompanionData.canBringOut(player:GetAttribute("Class"), data.id) and ownerParts(player) then
		entry.active = true
		local ground = Vector3.new(position.X, Build.groundY(position.X, position.Z), position.Z)
		spawn(player, entry, data, ground, yaw, entry.name)
	else
		toastEvent:FireClient(player, `{entry.name} is waiting at home: only {limit} can be out. Press P to choose`)
	end
	PlayerData.markDirty(player)
	send(player)
	task.spawn(PlayerData.save, player) -- a new companion is worth saving straight away
	return true
end

-- Living companions (not knocked out) within `radius` of `position`, for heals.
function Companions.near(position: Vector3, radius: number): { Model }
	local list = {}
	for model, c in byModel do
		if c.state ~= "KnockedOut" and model.Parent and (c.root.Position - position).Magnitude <= radius then
			table.insert(list, model)
		end
	end
	return list
end

-- The Beast Tamer's Call of the Wild: the player's companions hit harder and run faster for
-- `skill.duration` and are healed, and a spirit wolf joins the fight for `skill.spiritTime`.
function Companions.callOfTheWild(player: Player, skill: { [string]: any }): boolean
	local _, root = ownerParts(player)
	if not root then
		return false
	end
	local now = os.clock()
	buffs[player] = { untilTime = now + skill.duration, damage = 1 + skill.damageBonus, speed = 1 + skill.speedBonus }
	for _, c in table.clone(listOf(player)) do
		if not c.entry then
			despawn(c, false) -- an earlier spirit wolf
		elseif c.state ~= "KnockedOut" then
			Combat.heal(c.model, c.humanoid.MaxHealth * skill.heal)
			glow(c.model, skill.duration)
		end
	end
	local data = CreatureData.creatures[skill.spirit]
	if data then
		local spirit = spawn(player, nil, data, slotPosition(root, SPIRIT_SLOT), yawOf(root.CFrame), `Spirit {data.name}`)
		spirit.expiresAt = now + skill.spiritTime
		spirit.model:SetAttribute("Spirit", true)
		for _, part in spirit.model:GetDescendants() do
			if part:IsA("BasePart") and part ~= spirit.root then
				part.Material = Enum.Material.Neon
				part.Color = SPIRIT_COLOR
				part.Transparency = 0.45
				part.CastShadow = false
			end
		end
	end
	Combat.burst(root.Position, 18, Color3.fromRGB(120, 220, 130))
	return true
end

-- Panel requests ------------------------------------------------------------------------------

local function tooSoon(player: Player): boolean
	local now = os.clock()
	if now - (lastRequest[player] or -100) < REQUEST_COOLDOWN then
		return true
	end
	lastRequest[player] = now
	return false
end

local function findEntry(player: Player, uid: any): (Entry?, number?)
	local roster = rosterOf(player)
	if not roster or typeof(uid) ~= "number" then
		return nil, nil
	end
	for index, entry in roster do
		if entry.uid == uid then
			return entry, index
		end
	end
	return nil, nil
end

local function onSetActive(player: Player, uid: any, active: any)
	if typeof(active) ~= "boolean" or tooSoon(player) then
		return
	end
	local entry = findEntry(player, uid)
	if not entry then
		return
	end
	local current = findOut(player, entry.uid)
	if active and not current then
		local _, root = ownerParts(player)
		local data = CreatureData.creatures[entry.id]
		local limit = Companions.limit(player)
		local recoverAt = knockedOf(player)[entry.uid]
		if not root or not data then
			return
		elseif not CompanionData.canBringOut(player:GetAttribute("Class"), entry.id) then
			toastEvent:FireClient(player, `Only a Beast Tamer can bring out a {string.lower(data.name)}`)
		elseif countOut(player) >= limit then
			toastEvent:FireClient(player, if limit == 1 then "Only 1 companion can be out. Send the other home first"
				else `Only {limit} companions can be out. Send one home first`)
		elseif recoverAt and recoverAt > os.clock() then
			toastEvent:FireClient(player, `{entry.name} is still recovering ({math.ceil(recoverAt - os.clock())} s)`)
		else
			entry.active = true
			spawn(player, entry, data, slotPosition(root, countOut(player) + 1), yawOf(root.CFrame), entry.name)
			PlayerData.markDirty(player)
		end
	elseif not active then
		if current then
			despawn(current, true)
		end
		if entry.active then
			entry.active = false
			PlayerData.markDirty(player)
		end
	end
	send(player)
end

local function onRelease(player: Player, uid: any)
	if tooSoon(player) then
		return
	end
	local entry, index = findEntry(player, uid)
	local roster = rosterOf(player)
	if not entry or not index or not roster then
		return
	end
	local current = findOut(player, entry.uid)
	if current then
		despawn(current, true)
	end
	table.remove(roster, index)
	knockedOf(player)[entry.uid] = nil
	PlayerData.markDirty(player)
	toastEvent:FireClient(player, `You released {entry.name} back into the wild`)
	send(player)
end

-- Players --------------------------------------------------------------------------------------

local function onCharacter(player: Player, character: Model)
	-- Players and companions don't push each other around.
	local function group(instance: Instance)
		if instance:IsA("BasePart") then
			instance.CollisionGroup = PLAYER_GROUP
		end
	end
	for _, descendant in character:GetDescendants() do
		group(descendant)
	end
	character.DescendantAdded:Connect(group)

	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.Died:Connect(function()
		despawnAll(player) -- they come back, at full health, when the owner does
	end)
	knockedUntil[player] = {}
	focus[player] = nil
	ownerThreat[player] = nil
	buffs[player] = nil
	task.wait(0.5) -- let the character land at the spawn point first
	if player.Character == character and character.Parent then
		Companions.refresh(player)
	end
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player.CharacterRemoving:Connect(function()
		despawnAll(player)
	end)
	player:GetAttributeChangedSignal("Level"):Connect(function()
		for _, c in listOf(player) do
			applyStats(c, c.state ~= "KnockedOut") -- a level-up heals companions, like their owner
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

local started = false
function Companions.start()
	if started then
		return
	end
	started = true
	for _, name in { GROUP, PLAYER_GROUP } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(GROUP, PLAYER_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(GROUP, GROUP, false)
	getFolder()

	Net.event("CompanionSetActive").OnServerEvent:Connect(onSetActive)
	Net.event("CompanionRelease").OnServerEvent:Connect(onRelease)
	PlayerData.onLoaded(send)

	-- Companions pick their targets from who hit what.
	Combat.onDamage(function(model: Model, source: Instance?, via: Model?)
		local now = os.clock()
		if source and source:IsA("Player") then
			if not via and CollectionService:HasTag(model, TAG) then
				focus[source] = { model = model, at = now }
			end
		elseif source and source:IsA("Model") then
			local c = byModel[model]
			if c then
				c.threat = source
				c.threatAt = now
			else
				local player = Players:GetPlayerFromCharacter(model)
				if player then
					ownerThreat[player] = { model = source, at = now }
				end
			end
		end
	end)

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		despawnAll(player)
		out[player] = nil
		focus[player] = nil
		ownerThreat[player] = nil
		knockedUntil[player] = nil
		buffs[player] = nil
		lastRequest[player] = nil
	end)

	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated < THINK_INTERVAL then
			return
		end
		local step = accumulated
		accumulated = 0
		for _, list in out do
			for _, c in table.clone(list) do
				local ok, err = pcall(think, c, step)
				if not ok then
					warn("Companion think failed:", err)
				end
				-- What it is doing, for anything that wants to show it (and for testing).
				if c.model.Parent and c.model:GetAttribute("State") ~= c.state then
					c.model:SetAttribute("State", c.state)
				end
			end
		end
	end)
end

return Companions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Creature</string><ProtectedString name="Source"><![CDATA[-- Wild creatures: a low-poly body welded to a Humanoid root, driven by a small state machine.
--
-- Wander -> (player in aggro range, or hit) -> Chase -> Windup (glows red) -> bite -> Recover -> Chase ...
-- Too far from home -> Return (heals on the way) -> Wander.  Health 0 -> Dead (fades, respawns later).
-- In co-op a chasing creature switches to another player who is clearly closer, and when its
-- target dies a hostile creature turns on whoever else is near instead of going home.
--
-- Passive creatures (foxes) never fight: Wander -> (a player comes close, or something sudden
-- happens nearby) -> Flee -> Return. A player carrying food the creature likes doesn't scare it
-- (the calm check, set by Taming). While it is being fed it stands still (Held).
-- A creature that is tamed leaves through Creature.remove: no XP, loot or quest credit.
-- A companion's bite counts for its owner, and can bring the creature onto the companion.
--
-- The body comes from ServerStorage.Assets.<id> if a replacement model is there (see Assets.luau),
-- otherwise it is built from grey parts.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CreatureData = require(Shared:WaitForChild("CreatureData"))
local Build = require(script.Parent:WaitForChild("Build"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Assets = require(script.Parent:WaitForChild("Assets"))

local Creature = {}
Creature.__index = Creature

local PACK_RADIUS = 50
local THINK_INTERVAL = 0.1
local RETARGET_INTERVAL = 1 -- how often a chasing creature checks for a closer player
local RETARGET_MARGIN = 12 -- another player must be this many studs closer before it switches
local FALL_LIMIT = -60 -- below this height a creature has fallen out of the world
local SPAWN_TRIES = 10
local SETTLE_TIME = 1.5 -- new creatures are held still this long: freshly made terrain needs a moment
-- before its collision is solid, and anything dropped on it straight away falls through
local FALLEN_RESPAWN = 3 -- seconds before a creature that fell out of the world is replaced
local MAX_SPAWN_SLOPE = 2.5 -- studs of ground height difference allowed under a new creature
local RESPAWN_CLEARANCE = 60 -- creatures don't (re)appear this close to a player (wolves notice at 55)
local RESPAWN_RETRY = 2 -- seconds before trying again when players are standing on the spawn area
local FLEE_STEP = 20 -- how far ahead a fleeing creature aims each think
local FLEE_SAFE = 1.6 -- it keeps running until players are this many times its flee range away
local FLEE_TURNS = { 0, 50, -50, 100, -100, 150, -150 } -- degrees to try when the way ahead is blocked
local FLEE_MAX_RISE = 5 -- studs of climb or drop over one flee step that count as blocked (hills, the pond)

local all: { any } = {}
local byModel: { [Model]: any } = {}
local defeatListeners: { (CreatureData.CreatureInfo, { Player }, Vector3) -> () } = {}
local spawnListeners: { (any) -> () } = {}
local calmCheck: ((any, Player) -> boolean)? = nil
local folder: Folder? = nil

local function getFolder(): Folder
	if not folder then
		folder = Build.folder("Creatures", workspace)
	end
	return folder :: Folder
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Builds the grey body from parts. The front of every creature is -Z, like all Roblox models.
-- Returns the model, its Humanoid and root, and the HitRadius and HitHeight to use.
local function buildGreyBody(data: CreatureData.CreatureInfo, position: Vector3): (Model, Humanoid, BasePart, number, number)
	local s = data.scale
	local legLength = 1.6 * s
	local bodyHeight = 1.9 * s
	local bodyLength = 4.2 * s
	local bodyWidth = 1.8 * s
	local bodyY = legLength + bodyHeight / 2

	local model = Instance.new("Model")
	model.Name = data.name

	local base = CFrame.new(position + Vector3.new(0, bodyY, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	local root = Build.part({
		Name = "HumanoidRootPart",
		Size = Vector3.new(bodyWidth, bodyHeight, bodyLength),
		CFrame = base,
		Transparency = 1,
		Anchored = false,
		CanCollide = true,
		Parent = model,
	})

	local function add(name: string, size: Vector3, offset: Vector3, color: Color3, rotation: CFrame?)
		local part = Build.part({
			Name = name,
			Size = size,
			CFrame = base * CFrame.new(offset) * (rotation or CFrame.identity),
			Color = color,
			Parent = model,
		})
		Build.weld(part, root)
		return part
	end

	local front = -bodyLength / 2
	add("Body", Vector3.new(bodyWidth, bodyHeight, bodyLength), Vector3.zero, data.color)
	add("Head", Vector3.new(1.5 * s, 1.5 * s, 1.7 * s), Vector3.new(0, 0.7 * s, front - 0.6 * s), data.color)
	add("Snout", Vector3.new(0.8 * s, 0.7 * s, 1.0 * s), Vector3.new(0, 0.4 * s, front - 1.8 * s), data.accent)
	add("Nose", Vector3.new(0.35 * s, 0.3 * s, 0.2 * s), Vector3.new(0, 0.65 * s, front - 2.3 * s), Color3.fromRGB(30, 28, 28))
	for _, side in { -1, 1 } do
		add("Eye", Vector3.new(0.22 * s, 0.22 * s, 0.1 * s), Vector3.new(side * 0.42 * s, 1.0 * s, front - 1.42 * s), Color3.fromRGB(25, 20, 20))
		add("Leg", Vector3.new(0.5 * s, legLength, 0.5 * s), Vector3.new(side * bodyWidth * 0.32, -bodyHeight / 2 - legLength / 2 + 0.1, front * 0.7), data.color)
		add("Leg", Vector3.new(0.5 * s, legLength, 0.5 * s), Vector3.new(side * bodyWidth * 0.32, -bodyHeight / 2 - legLength / 2 + 0.1, -front * 0.7), data.color)
		if data.id == "wolf" or data.id == "fox" then
			add("Ear", Vector3.new(0.4 * s, 0.7 * s, 0.25 * s), Vector3.new(side * 0.45 * s, 1.75 * s, front - 0.4 * s), data.color)
		elseif data.id == "boar" then
			add("Tusk", Vector3.new(0.15 * s, 0.45 * s, 0.15 * s), Vector3.new(side * 0.42 * s, 0.25 * s, front - 2.1 * s), data.accent)
		end
	end
	if data.id == "wolf" then
		add("Tail", Vector3.new(0.45 * s, 0.45 * s, 1.8 * s), Vector3.new(0, 0.35 * s, -front + 0.7 * s), data.accent, CFrame.Angles(math.rad(25), 0, 0))
		add("Chest", Vector3.new(bodyWidth * 0.9, bodyHeight * 0.7, 0.3 * s), Vector3.new(0, -0.1 * s, front - 0.05), data.accent)
	elseif data.id == "fox" then
		-- A bushy tail held up, with a pale tip.
		local lift = CFrame.Angles(math.rad(-25), 0, 0)
		add("Tail", Vector3.new(0.75 * s, 0.75 * s, 2.2 * s), Vector3.new(0, 0.5 * s, -front + 0.9 * s), data.color, lift)
		add("TailTip", Vector3.new(0.65 * s, 0.65 * s, 0.8 * s), Vector3.new(0, 1.1 * s, -front + 2.2 * s), data.accent, lift)
		add("Chest", Vector3.new(bodyWidth * 0.9, bodyHeight * 0.7, 0.3 * s), Vector3.new(0, -0.1 * s, front - 0.05), data.accent)
	else
		add("Tail", Vector3.new(0.2 * s, 0.2 * s, 0.6 * s), Vector3.new(0, 0.4 * s, -front + 0.25 * s), data.color)
		add("Mane", Vector3.new(0.5 * s, 0.4 * s, bodyLength * 0.7), Vector3.new(0, bodyHeight / 2 + 0.15 * s, 0), Color3.fromRGB(60, 42, 30))
	end

	local humanoid = Instance.new("Humanoid")
	-- R15 makes the Humanoid hold the root at HipHeight above the ground, which custom bodies need.
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = legLength
	humanoid.Parent = model
	model.PrimaryPart = root
	return model, humanoid, root, math.max(bodyWidth, bodyLength) * 0.45, bodyHeight / 2 + 1.6 * s
end

-- A copy of the replacement model ServerStorage.Assets.<id>, standing on `position`, or nil.
local function buildFromAsset(data: CreatureData.CreatureInfo, position: Vector3): (Model?, Humanoid?, BasePart?, number, number)
	local template = Assets.find(data.id)
	if not template then
		return nil, nil, nil, 0, 0
	end
	local model = template:Clone()
	local root = model:FindFirstChild("HumanoidRootPart")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid then
		warn(`[Creature] ServerStorage.Assets model "{data.id}" needs a HumanoidRootPart and a Humanoid; using the grey body instead.`)
		model:Destroy()
		return nil, nil, nil, 0, 0
	end
	model.Name = data.name
	model.PrimaryPart = root
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
		end
	end
	-- Stand it on the ground with the root held at HipHeight, facing a random way.
	local rootY = position.Y + humanoid.HipHeight + root.Size.Y / 2
	local target = CFrame.new(position.X, rootY, position.Z) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	model:PivotTo(target * root.CFrame:ToObjectSpace(model:GetPivot()))
	local box, size = model:GetBoundingBox()
	local top = box.Position.Y + size.Y / 2 - root.Position.Y
	return model, humanoid, root, math.max(size.X, size.Z) * 0.45, top + 0.5
end

-- Builds a creature's body under `parent`: the replacement model if there is one, otherwise the
-- grey body. `wild` ones are tagged Damageable, so players can attack and lock on to them;
-- companions (Companions.luau) are built with `wild` false and can't be hit by players.
-- The root starts anchored: whoever owns the body releases it once the ground is solid.
function Creature.buildBody(data: CreatureData.CreatureInfo, position: Vector3, parent: Instance, wild: boolean): (Model, Humanoid, BasePart)
	local model: Model, humanoid: Humanoid, root: BasePart, hitRadius: number, hitHeight: number
	local assetModel, assetHumanoid, assetRoot, assetRadius, assetHeight = buildFromAsset(data, position)
	if assetModel and assetHumanoid and assetRoot then
		model, humanoid, root, hitRadius, hitHeight = assetModel, assetHumanoid, assetRoot, assetRadius, assetHeight
	else
		model, humanoid, root, hitRadius, hitHeight = buildGreyBody(data, position)
	end

	humanoid.MaxHealth = data.maxHealth
	humanoid.Health = data.maxHealth
	humanoid.WalkSpeed = data.walkSpeed
	humanoid.DisplayName = data.name
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	model:SetAttribute("CreatureId", data.id)
	model:SetAttribute("HitRadius", hitRadius)
	model:SetAttribute("HitHeight", hitHeight)
	model:SetAttribute("Hostile", wild and data.behaviour == "Hostile")
	model:SetAttribute("Void", data.isVoid)
	if wild then
		CollectionService:AddTag(model, Config.TAG_DAMAGEABLE)
	end
	root.Anchored = true -- released by think() once SETTLE_TIME has passed
	model.Parent = parent
	return model, humanoid, root
end

export type Creature = typeof(setmetatable(
	{} :: {
		data: CreatureData.CreatureInfo,
		home: Vector3,
		state: string,
		timer: number,
		nextAttack: number,
		retargetAt: number,
		target: Model?,
		lastAttacker: Player?,
		damagers: { [Player]: boolean }, -- everyone who hit it; they share XP and quest credit
		wanderPoint: Vector3,
		model: Model,
		humanoid: Humanoid,
		root: BasePart,
		warning: Highlight,
		settleUntil: number?,
		stunnedUntil: number, -- Shield Slam, Frost Nova
		tauntedUntil: number, -- Taunt: keeps its target and won't switch
		fleeFrom: Vector3, -- what a fleeing creature is running from
		fleeUntil: number,
		holder: Model?, -- the character feeding it (Held)
		onDespawn: ((reason: string) -> ())?,
	},
	Creature
))

-- `onDespawn(reason)` runs when the body has been removed. `reason` is "defeated", "fell" (out of
-- the world) or "tamed".
function Creature.spawn(data: CreatureData.CreatureInfo, position: Vector3, onDespawn: ((reason: string) -> ())?): Creature
	local model, humanoid, root = Creature.buildBody(data, position, getFolder(), true)
	local warning = Instance.new("Highlight")
	warning.Name = "WindupWarning"
	warning.FillColor = Color3.fromRGB(255, 40, 30)
	warning.FillTransparency = 0.35
	warning.OutlineColor = Color3.fromRGB(255, 90, 60)
	warning.OutlineTransparency = 0.2
	warning.Enabled = false
	warning.Parent = model

	local self = setmetatable({
		data = data,
		home = position,
		state = "Wander",
		timer = 0,
		nextAttack = 0,
		retargetAt = 0,
		target = nil,
		lastAttacker = nil,
		damagers = {},
		wanderPoint = position,
		model = model,
		humanoid = humanoid,
		root = root,
		warning = warning,
		settleUntil = os.clock() + SETTLE_TIME,
		stunnedUntil = 0,
		tauntedUntil = 0,
		fleeFrom = position,
		fleeUntil = 0,
		holder = nil,
		onDespawn = onDespawn,
	}, Creature)

	Combat.onHit(model, function(source, via)
		self:provoke(source, via)
	end)
	humanoid.Died:Connect(function()
		self:die()
	end)
	table.insert(all, self)
	byModel[model] = self
	for _, listener in spawnListeners do
		task.spawn(listener, self)
	end
	return self
end

-- Runs `listener(creature)` for every creature spawned from now on (Taming adds feed prompts).
function Creature.onSpawned(listener: (any) -> ())
	table.insert(spawnListeners, listener)
end

-- `check(creature, player)` returns true when `player` doesn't scare a passive `creature`
-- (Taming: they carry food it likes).
function Creature.setCalmCheck(check: (any, Player) -> boolean)
	calmCheck = check
end

-- The living wild creature closest to `position` within `radius` that `accept` says yes to.
function Creature.nearest(position: Vector3, radius: number, accept: (any) -> boolean): Creature?
	local best: Creature? = nil
	local bestDistance = radius
	for _, creature in all do
		if creature.state ~= "Dead" then
			local distance = (creature.root.Position - position).Magnitude
			if distance <= bestDistance and accept(creature) then
				best = creature
				bestDistance = distance
			end
		end
	end
	return best
end

-- The creature object for a model, if it is one.
function Creature.find(model: Model): Creature?
	return byModel[model]
end

-- Stops it in place for `seconds`, tinted `color` (blue for frozen, white for stunned).
function Creature.stun(self: Creature, seconds: number, color: Color3)
	if self.state == "Dead" then
		return
	end
	local untilTime = os.clock() + seconds
	if untilTime <= self.stunnedUntil then
		return
	end
	self.stunnedUntil = untilTime
	self.warning.Enabled = false
	self.humanoid:MoveTo(self.root.Position)
	local tint = self.model:FindFirstChild("StunTint") :: Highlight?
	if not tint then
		local highlight = Instance.new("Highlight")
		highlight.Name = "StunTint"
		highlight.FillTransparency = 0.45
		highlight.OutlineTransparency = 0.3
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = self.model
		tint = highlight
	end
	(tint :: Highlight).FillColor = color;
	(tint :: Highlight).OutlineColor = color
	task.delay(seconds, function()
		if os.clock() >= self.stunnedUntil - 0.01 and tint and tint.Parent then
			tint:Destroy()
		end
	end)
end

-- Shoves it `distance` studs along `direction`, stopping short of anything solid.
function Creature.knockback(self: Creature, direction: Vector3, distance: number)
	if self.state == "Dead" or self.root.Anchored then
		return
	end
	local flatDirection = Vector3.new(direction.X, 0, direction.Z)
	if flatDirection.Magnitude < 0.01 then
		return
	end
	flatDirection = flatDirection.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.model }
	local hit = workspace:Raycast(self.root.Position, flatDirection * distance, params)
	local travel = if hit then math.max(0, (hit.Position - self.root.Position).Magnitude - 2) else distance
	self.model:PivotTo(self.model:GetPivot() + flatDirection * travel)
end

-- Tank Taunt: every creature within `radius` of `position` turns on `character` for `seconds`.
function Creature.taunt(character: Model, position: Vector3, radius: number, seconds: number): number
	local count = 0
	local now = os.clock()
	for _, creature in all do
		if creature.state ~= "Dead" and (creature.root.Position - position).Magnitude <= radius then
			creature:setTarget(character)
			creature.tauntedUntil = now + seconds
			count += 1
		end
	end
	return count
end

function Creature.setTarget(self: Creature, character: Model)
	self.target = character
	self.state = "Chase"
end

-- How far away this creature notices `player`. Ninjas move quietly and are noticed at half range.
function Creature.noticeRange(self: Creature, player: Player): number
	local range = self.data.aggroRange
	if player:GetAttribute("Class") == "ninja" then
		range *= 0.5
	end
	return range
end

-- The living player character closest to this creature, and how far away it is. With
-- `noticing`, only players inside the notice range count; otherwise those within `maxDistance`.
function Creature.nearestPlayer(self: Creature, noticing: boolean, maxDistance: number?): (Model?, number)
	local best: Model? = nil
	local bestDistance = math.huge
	local position = self.root.Position
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and Combat.isAlive(character) and not character:GetAttribute("Vanished") then
			local root = Combat.rootOf(character)
			if root then
				local distance = (root.Position - position).Magnitude
				local limit = if noticing then self:noticeRange(player) else (maxDistance or math.huge)
				if distance < limit and distance < bestDistance then
					best = character
					bestDistance = distance
				end
			end
		end
	end
	return best, bestDistance
end

-- Pack animals (wolves) join the fight. Each goes for the player closest to itself, so in co-op
-- a pack spreads out between players who stand apart and gangs up on players who stand together.
function Creature.alertPack(self: Creature, character: Model)
	if not self.data.pack then
		return
	end
	for _, other in all do
		if other ~= self and other.data.id == self.data.id and other.state == "Wander"
			and (other.root.Position - self.root.Position).Magnitude < PACK_RADIUS then
			local nearest = other:nearestPlayer(false, other.data.aggroRange * 1.5)
			other:setTarget(nearest or character)
		end
	end
end

-- `source` is the player who gets the credit. `via` is their companion when it did the biting:
-- the creature then goes for the companion rather than the player.
function Creature.provoke(self: Creature, source: Instance?, via: Model?)
	if self.state == "Dead" then
		return
	end
	if source and source:IsA("Player") then
		self.lastAttacker = source
		self.damagers[source] = true
		local attacker = via or source.Character
		if not attacker or not Combat.isAlive(attacker) then
			return
		end
		if self.data.behaviour == "Passive" then
			local attackerRoot = Combat.rootOf(attacker)
			if attackerRoot then
				self:flee(attackerRoot.Position, 4)
			end
		elseif self.state == "Wander" or self.state == "Return" then
			self:setTarget(attacker)
			self:alertPack(attacker)
		elseif via and self.target ~= via and (self.state == "Chase" or self.state == "Recover")
			and os.clock() >= self.tauntedUntil and math.random() < 0.5 then
			self.target = via -- sometimes turns on the companion that bit it
		end
	end
end

-- For passive creatures: the nearest player close enough to scare it, or nil. Players the calm
-- check vouches for (they carry food it likes) and vanished Ninjas don't count.
function Creature.nearestThreat(self: Creature, rangeScale: number?): Model?
	local range = self.data.fleeRange
	if not range then
		return nil
	end
	local best: Model? = nil
	local bestDistance = range * (rangeScale or 1)
	local position = self.root.Position
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and Combat.isAlive(character) and not character:GetAttribute("Vanished") then
			local root = Combat.rootOf(character)
			if root then
				local distance = (root.Position - position).Magnitude
				if distance < bestDistance and not (calmCheck and calmCheck(self, player)) then
					best = character
					bestDistance = distance
				end
			end
		end
	end
	return best
end

-- Runs away from `from` for at least `seconds`.
function Creature.flee(self: Creature, from: Vector3, seconds: number)
	if self.state == "Dead" then
		return
	end
	self.fleeFrom = from
	self.fleeUntil = math.max(self.fleeUntil, os.clock() + seconds)
	self.target = nil
	self.holder = nil
	self.warning.Enabled = false
	self.state = "Flee"
end

-- Something sudden happened at `position` (a dash, an attack, a skill): passive creatures
-- within `radius` bolt, even from a player carrying food.
function Creature.startle(position: Vector3, radius: number)
	for _, creature in all do
		if creature.data.behaviour == "Passive" and creature.state ~= "Dead"
			and (creature.root.Position - position).Magnitude <= radius then
			creature:flee(position, 3)
		end
	end
end

-- Stands still facing `character` while it is being fed (Taming). `unhold` lets it wander again.
function Creature.hold(self: Creature, character: Model)
	if self.state == "Dead" then
		return
	end
	self.holder = character
	self.target = nil
	self.state = "Held"
	self.humanoid:MoveTo(self.root.Position)
end

function Creature.unhold(self: Creature)
	if self.state == "Held" then
		self.holder = nil
		self.state = "Wander"
		self.timer = 1
	end
end

function Creature.lookForTarget(self: Creature)
	if self.data.behaviour ~= "Hostile" then
		return
	end
	local character = self:nearestPlayer(true)
	if character then
		self:setTarget(character)
		self:alertPack(character)
	end
end

function Creature.targetRoot(self: Creature): BasePart?
	local target = self.target
	-- A vanished Ninja can't be followed, and a knocked-out companion is left alone.
	if target and Combat.isAlive(target) and not target:GetAttribute("Vanished") and not target:GetAttribute("KnockedOut") then
		return Combat.rootOf(target)
	end
	return nil
end

function Creature.loseTarget(self: Creature)
	self.target = nil
	self.warning.Enabled = false
	self.state = "Return"
end

function Creature.faceTowards(self: Creature, position: Vector3)
	local from = self.root.Position
	local flatTarget = Vector3.new(position.X, from.Y, position.Z)
	if (flatTarget - from).Magnitude > 0.1 then
		self.root.CFrame = CFrame.lookAt(from, flatTarget)
	end
end

function Creature.think(self: Creature, dt: number)
	local state = self.state
	if state == "Dead" then
		return
	end
	local settleUntil = self.settleUntil
	if settleUntil then
		if os.clock() < settleUntil then
			return
		end
		self.settleUntil = nil
		self.root.Anchored = false
		self.root:SetNetworkOwner(nil) -- the server moves creatures
	end
	if not self.root.Parent or self.root.Position.Y < FALL_LIMIT then
		self:die(true) -- flung or fell out of the world: remove it so the spawner replaces it
		return
	end
	local now = os.clock()
	local position = self.root.Position

	if now < self.stunnedUntil then
		self.humanoid:MoveTo(position)
		if state == "Windup" then
			self.warning.Enabled = false -- a stun cancels the bite
			self.state = "Chase"
		end
		return
	end

	if self.data.fleeRange and (state == "Wander" or state == "Return") then
		local threat = self:nearestThreat()
		local threatRoot = threat and Combat.rootOf(threat)
		if threatRoot then
			self:flee(threatRoot.Position, 2)
			return
		end
	end

	if state == "Flee" then
		local threat = self:nearestThreat(FLEE_SAFE)
		local threatRoot = threat and Combat.rootOf(threat)
		if threatRoot then
			self.fleeFrom = threatRoot.Position
			self.fleeUntil = math.max(self.fleeUntil, now + 1)
		end
		if now >= self.fleeUntil then
			-- Safe: stop and catch its breath, then wander as before.
			self.state = "Wander"
			self.timer = 2 + math.random() * 2
			self.humanoid:MoveTo(position)
			return
		end
		local away = Vector3.new(position.X - self.fleeFrom.X, 0, position.Z - self.fleeFrom.Z)
		if away.Magnitude < 0.5 then
			local angle = math.random() * math.pi * 2
			away = Vector3.new(math.cos(angle), 0, math.sin(angle))
		end
		away = away.Unit
		-- Stay inside the map, within reach of home and off steep ground (the hills around the
		-- map slow a creature to a crawl): when the way ahead is blocked, turn and run along
		-- the edge instead of stopping there.
		local edge = Config.MAP_HALF - 20
		local goal = position + away * FLEE_STEP
		local groundHere = Build.groundY(position.X, position.Z)
		for _, degrees in FLEE_TURNS do
			local direction = CFrame.Angles(0, math.rad(degrees), 0):VectorToWorldSpace(away)
			local candidate = position + direction * FLEE_STEP
			if math.abs(candidate.X) <= edge and math.abs(candidate.Z) <= edge
				and flatDistance(candidate, self.home) <= self.data.leash
				and math.abs(Build.groundY(candidate.X, candidate.Z) - groundHere) <= FLEE_MAX_RISE then
				goal = candidate
				break
			end
		end
		self.humanoid.WalkSpeed = self.data.fleeSpeed or self.data.walkSpeed
		self.humanoid:MoveTo(goal)
	elseif state == "Held" then
		local holder = self.holder
		local holderRoot = if holder and Combat.isAlive(holder) then Combat.rootOf(holder) else nil
		if not holderRoot then
			self:unhold()
			return
		end
		self.humanoid:MoveTo(position)
		self:faceTowards(holderRoot.Position)
	elseif state == "Wander" then
		self:lookForTarget()
		if self.state ~= "Wander" then
			return
		end
		if self.data.behaviour == "Passive" and self.humanoid.Health < self.humanoid.MaxHealth then
			-- Passive creatures don't walk home to heal (that could lead them back to whoever
			-- scared them); they recover slowly wherever they are.
			self.humanoid.Health = math.min(self.humanoid.MaxHealth, self.humanoid.Health + self.humanoid.MaxHealth * 0.05 * dt)
			if self.humanoid.Health >= self.humanoid.MaxHealth then
				table.clear(self.damagers)
			end
		end
		self.timer -= dt
		if self.timer <= 0 then
			self.timer = 2.5 + math.random() * 3.5
			if math.random() < 0.35 then
				self.wanderPoint = position
			else
				local angle = math.random() * math.pi * 2
				local radius = math.random() * 30
				self.wanderPoint = self.home + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			end
			self.humanoid.WalkSpeed = self.data.walkSpeed * 0.35
			self.humanoid:MoveTo(self.wanderPoint)
		end
	elseif state == "Chase" then
		if (position - self.home).Magnitude > self.data.leash then
			self:loseTarget()
			return
		end
		local targetRoot = self:targetRoot()
		if not targetRoot then
			-- The target died or left. Hostile creatures turn on whoever else is close.
			local nextTarget = if self.data.behaviour == "Hostile" then self:nearestPlayer(true) else nil
			if nextTarget then
				self.target = nextTarget
			else
				self:loseTarget()
			end
			return
		end
		if now >= self.retargetAt and now >= self.tauntedUntil then
			-- In co-op, switch to another player who is clearly closer. Neutral creatures
			-- (aggro range 0) never switch: they stay on whoever hit them.
			self.retargetAt = now + RETARGET_INTERVAL
			local closest, closestDistance = self:nearestPlayer(false, self.data.aggroRange)
			if closest and closest ~= self.target
				and closestDistance + RETARGET_MARGIN < (targetRoot.Position - position).Magnitude then
				self.target = closest
				return
			end
		end
		local distance = flatDistance(position, targetRoot.Position)
		if distance <= self.data.attackRange + 1.5 then
			self.humanoid:MoveTo(position) -- stop
			self:faceTowards(targetRoot.Position)
			if now >= self.nextAttack then
				self.state = "Windup"
				self.timer = self.data.windup
				self.warning.Enabled = true
			end
		else
			self.humanoid.WalkSpeed = self.data.walkSpeed
			self.humanoid:MoveTo(targetRoot.Position)
		end
	elseif state == "Windup" then
		local targetRoot = self:targetRoot()
		if targetRoot then
			self:faceTowards(targetRoot.Position)
		end
		self.timer -= dt
		if self.timer <= 0 then
			self.warning.Enabled = false
			-- The bite lands only if the player didn't dash or step away in time.
			if targetRoot and self.target and flatDistance(position, targetRoot.Position) <= self.data.attackRange + 3 then
				Combat.damage(self.target, self.data.damage, self.model, false)
			end
			self.nextAttack = now + self.data.attackInterval
			self.state = "Recover"
			self.timer = 0.5
		end
	elseif state == "Recover" then
		self.timer -= dt
		if self.timer <= 0 then
			self.state = "Chase"
		end
	elseif state == "Return" then
		self.humanoid.WalkSpeed = self.data.walkSpeed
		self.humanoid:MoveTo(self.home)
		self.humanoid.Health = math.min(self.humanoid.MaxHealth, self.humanoid.Health + self.humanoid.MaxHealth * 0.3 * dt)
		if flatDistance(position, self.home) < 8 then
			self.humanoid.Health = self.humanoid.MaxHealth
			table.clear(self.damagers) -- fully healed: earlier hits no longer count
			self.state = "Wander"
			self.timer = 0
		end
	end
end

-- `fell` is true when it dropped out of the world rather than being defeated.
function Creature.die(self: Creature, fell: boolean?)
	if self.state == "Dead" then
		return
	end
	self.state = "Dead"
	self.warning.Enabled = false
	CollectionService:RemoveTag(self.model, Config.TAG_DAMAGEABLE)
	local index = table.find(all, self)
	if index then
		table.remove(all, index)
	end
	byModel[self.model] = nil
	if not fell then
		local players = {}
		for player in self.damagers do
			if player.Parent then
				table.insert(players, player)
			end
		end
		for _, listener in defeatListeners do
			task.spawn(listener, self.data, players, self.root.Position)
		end
	end
	self.root.Anchored = true
	local fade = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for _, part in self.model:GetDescendants() do
		if part:IsA("BasePart") and part ~= self.root then
			TweenService:Create(part, fade, { Transparency = 1 }):Play()
		end
	end
	task.delay(1.2, function()
		self.model:Destroy()
		if self.onDespawn then
			self.onDespawn(if fell then "fell" else "defeated")
		end
	end)
end

-- Takes the creature out of the wild at once without a defeat: no XP, loot or quest credit.
-- Used when it is tamed (`reason` "tamed"); its body is replaced by a companion.
function Creature.remove(self: Creature, reason: string)
	if self.state == "Dead" then
		return
	end
	self.state = "Dead"
	self.warning.Enabled = false
	CollectionService:RemoveTag(self.model, Config.TAG_DAMAGEABLE)
	local index = table.find(all, self)
	if index then
		table.remove(all, index)
	end
	byModel[self.model] = nil
	self.model:Destroy()
	if self.onDespawn then
		self.onDespawn(reason)
	end
end

-- Runs `listener(data, players, position)` whenever a creature is defeated; `players` is everyone
-- who damaged it and `position` is where it fell.
function Creature.onDefeated(listener: (CreatureData.CreatureInfo, { Player }, Vector3) -> ())
	table.insert(defeatListeners, listener)
end

-- One loop thinks for every creature, ten times a second.
local started = false
function Creature.start()
	if started then
		return
	end
	started = true
	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated < THINK_INTERVAL then
			return
		end
		local step = accumulated
		accumulated = 0
		for _, creature in table.clone(all) do
			local ok, err = pcall(creature.think, creature, step)
			if not ok then
				warn("Creature think failed:", err)
			end
		end
	end)
end

local function playerWithin(position: Vector3, distance: number): boolean
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and Combat.rootOf(character)
		if root and (root.Position - position).Magnitude < distance then
			return true
		end
	end
	return false
end

-- Keeps `count` creatures alive around `center`, replacing each one some time after it dies or
-- is tamed. A replacement never appears beside a player: it waits until the spot is clear.
function Creature.spawner(data: CreatureData.CreatureInfo, center: Vector3, count: number, radius: number)
	local footprint = 2.5 * data.scale
	local samples = { Vector2.zero, Vector2.new(footprint, 0), Vector2.new(-footprint, 0), Vector2.new(0, footprint), Vector2.new(0, -footprint) }
	local function spawnOne()
		-- Pick a fairly flat spot: a long body dropped on a steep slope starts inside the hill
		-- and gets flung out of the world.
		local position = center
		for _ = 1, SPAWN_TRIES do
			local angle = math.random() * math.pi * 2
			local distance = math.sqrt(math.random()) * radius
			local x = center.X + math.cos(angle) * distance
			local z = center.Z + math.sin(angle) * distance
			local low, high = math.huge, -math.huge
			for _, offset in samples do
				local y = Build.groundY(x + offset.X, z + offset.Y)
				low = math.min(low, y)
				high = math.max(high, y)
			end
			position = Vector3.new(x, high + 0.3, z)
			if high - low <= MAX_SPAWN_SLOPE and not playerWithin(position, RESPAWN_CLEARANCE) then
				break
			end
		end
		if playerWithin(position, RESPAWN_CLEARANCE) then
			task.delay(RESPAWN_RETRY, spawnOne) -- players are all over the area: wait for them to move on
			return
		end
		Creature.spawn(data, position, function(reason: string)
			local seconds = if reason == "fell" then FALLEN_RESPAWN
				elseif reason == "tamed" then CreatureData.TAMED_RESPAWN
				else data.respawn
			task.delay(seconds, spawnOne)
		end)
	end
	for _ = 1, count do
		spawnOne()
	end
end

return Creature
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Drops</string><ProtectedString name="Source"><![CDATA[-- Loot on the ground. In co-op every player gets their own drops: only the owner sees a drop
-- (DropSpawned goes to them alone) and only they can pick it up, by walking over it.
-- The server tracks every drop and decides pickups; clients just draw them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemData = require(Shared:WaitForChild("ItemData"))
local Net = require(Shared:WaitForChild("Net"))
local Build = require(script.Parent:WaitForChild("Build"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Inventory = require(script.Parent:WaitForChild("Inventory"))

local Drops = {}

local PICKUP_RANGE = 7
local LIFETIME = 90
local CHECK_INTERVAL = 0.2

type Drop = { id: number, owner: Player, item: string, count: number, position: Vector3, expires: number }

local drops: { Drop } = {}
local nextId = 0

local spawnedEvent = Net.event("DropSpawned")
local takenEvent = Net.event("DropTaken")
local toastEvent = Net.event("Toast")

function Drops.spawn(owner: Player, itemId: string, count: number, near: Vector3)
	local angle = math.random() * math.pi * 2
	local x = near.X + math.cos(angle) * 2.5
	local z = near.Z + math.sin(angle) * 2.5
	local position = Vector3.new(x, Build.groundY(x, z) + 1, z)
	nextId += 1
	table.insert(drops, { id = nextId, owner = owner, item = itemId, count = count, position = position, expires = os.clock() + LIFETIME })
	spawnedEvent:FireClient(owner, nextId, itemId, count, position)
end

-- Rolls a creature's loot table separately for every player who helped defeat it.
function Drops.forDefeat(creatureId: string, position: Vector3, players: { Player })
	local loot = ItemData.drops[creatureId]
	if not loot then
		return
	end
	for _, player in players do
		for _, entry in loot do
			if math.random() < entry.chance then
				Drops.spawn(player, entry.item, math.random(entry.min, entry.max), position)
			end
		end
	end
end

local function check()
	local now = os.clock()
	for i = #drops, 1, -1 do
		local drop = drops[i]
		local owner = drop.owner
		if not owner.Parent then
			table.remove(drops, i)
		elseif now > drop.expires then
			table.remove(drops, i)
			takenEvent:FireClient(owner, drop.id)
		else
			local character = owner.Character
			local root = character and Combat.rootOf(character)
			if root and Combat.isAlive(character) and (root.Position - drop.position).Magnitude <= PICKUP_RANGE then
				local added = Inventory.add(owner, drop.item, drop.count)
				if added > 0 then
					toastEvent:FireClient(owner, `+{added} {ItemData.items[drop.item].name}`)
				end
				if added >= drop.count then
					table.remove(drops, i)
					takenEvent:FireClient(owner, drop.id)
				else
					drop.count -= added -- bag full: the rest stays on the ground
				end
			end
		end
	end
end

function Drops.start()
	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated >= CHECK_INTERVAL then
			accumulated = 0
			check()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		for i = #drops, 1, -1 do
			if drops[i].owner == player then
				table.remove(drops, i)
			end
		end
	end)
end

return Drops
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Dummy</string><ProtectedString name="Source"><![CDATA[-- Straw training dummies. They never die: below half health they patch themselves up.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Build = require(script.Parent:WaitForChild("Build"))

local Dummy = {}

-- `facing` is a point the dummy should look at.
function Dummy.create(parent: Instance, position: Vector3, facing: Vector3): Model
	local model = Build.model("TrainingDummy", parent)
	local base = CFrame.lookAt(position, Vector3.new(facing.X, position.Y, facing.Z))

	local root = Build.at(model, base, Vector3.new(2, 6, 2), CFrame.new(0, 3, 0), Build.STRAW, nil, {
		Name = "HumanoidRootPart",
		Transparency = 1,
		CanCollide = false,
	})
	Build.cylinder(model, base, 6, 0.8, Vector3.new(0, 3, 0), Build.WOOD, Enum.Material.Wood)
	Build.at(model, base, Vector3.new(2.6, 3, 1.5), CFrame.new(0, 3.9, 0), Build.STRAW, Enum.Material.Fabric)
	Build.at(model, base, Vector3.new(5.5, 0.6, 0.6), CFrame.new(0, 4.6, 0), Build.WOOD, Enum.Material.Wood)
	Build.at(model, base, Vector3.new(1.8, 1.8, 1.8), CFrame.new(0, 6.3, 0), Build.STRAW, Enum.Material.Fabric, { Name = "Head" })
	-- Red target painted on the chest (the front is -Z).
	Build.at(model, base, Vector3.new(1.3, 1.3, 0.1), CFrame.new(0, 4.1, -0.8), Color3.fromRGB(200, 50, 45), nil, { CanCollide = false })
	Build.at(model, base, Vector3.new(0.6, 0.6, 0.12), CFrame.new(0, 4.1, -0.82), Color3.fromRGB(245, 240, 230), nil, { CanCollide = false })

	model.PrimaryPart = root

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 1000
	humanoid.Health = 1000
	humanoid.DisplayName = "Training Dummy"
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	humanoid.HealthChanged:Connect(function(health)
		if health < humanoid.MaxHealth * 0.5 then
			humanoid.Health = humanoid.MaxHealth
		end
	end)

	model:SetAttribute("HitRadius", 2)
	model:SetAttribute("HitHeight", 4.5)
	model:SetAttribute("Hostile", false)
	CollectionService:AddTag(model, Config.TAG_DAMAGEABLE)
	return model
end

return Dummy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Hearthmoor</string><ProtectedString name="Source"><![CDATA[-- Builds Hearthmoor when the server starts: terrain, the village, scenery, people,
-- training dummies and creature spawners. Positions match the Godot Phase 1 layout
-- (metres x 3.5 = studs). North is -Z; the village centre is (0, 0).
--
-- Building by code keeps the whole map in Git. Houses, trees, rocks, the well and the campfire
-- go through Assets.place: a model with the same name in ServerStorage.Assets replaces the grey
-- version without code changes (asset names: ElderHall, HouseSmall, HouseWide, AppleTree, Tree,
-- Pine, Rock, Well, Campfire).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CreatureData = require(Shared:WaitForChild("CreatureData"))
local ItemData = require(Shared:WaitForChild("ItemData"))
local Assets = require(script.Parent:WaitForChild("Assets"))
local Build = require(script.Parent:WaitForChild("Build"))
local Creature = require(script.Parent:WaitForChild("Creature"))
local Dummy = require(script.Parent:WaitForChild("Dummy"))
local Interactables = require(script.Parent:WaitForChild("Interactables"))
local Inventory = require(script.Parent:WaitForChild("Inventory"))
local Net = require(Shared:WaitForChild("Net"))
local Quests = require(script.Parent:WaitForChild("Quests"))

local Hearthmoor = {}

local M = 3.5 -- studs per metre (Godot layout -> Roblox)
local HALF = Config.MAP_HALF
local POND = Vector3.new(34 * M, 0, 70 * M)
local POND_RADIUS = 44
local rng = Random.new(1108)

local function v2(x: number, z: number): Vector3
	return Vector3.new(x * M, 0, z * M)
end

local ELDER = v2(-10, -10)

-- An invisible part to hang a gathering prompt on, so it works whatever model stands there.
local function gatherSpot(parent: Instance, cframe: CFrame, kind: string, spotId: string, distance: number?)
	local anchor = Build.part({
		Name = "GatherSpot",
		Size = Vector3.new(2, 2, 2),
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = parent,
	})
	local spec = ItemData.gather[kind]
	Interactables.prompt(anchor, spec.verb, spec.object, function(player)
		Inventory.gather(player, kind, spotId)
	end, distance)
end

-- The point on the ground under `at` (its y is ignored), turned `yaw` radians about the vertical.
local function ground(at: Vector3, yaw: number?): CFrame
	return CFrame.new(at.X, Build.groundY(at.X, at.Z), at.Z) * CFrame.Angles(0, yaw or 0, 0)
end

-- Distance from (x, z) to the nearest path (north road, plaza, path to the pond).
local function segmentDistance(px: number, pz: number, ax: number, az: number, bx: number, bz: number): number
	local abx, abz = bx - ax, bz - az
	local t = math.clamp(((px - ax) * abx + (pz - az) * abz) / (abx * abx + abz * abz), 0, 1)
	local cx, cz = ax + abx * t, az + abz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

local function pathDistance(x: number, z: number): number
	local road = segmentDistance(x, z, 0, 10, 0, -HALF)
	local pond = segmentDistance(x, z, 0, 20, POND.X - 30, POND.Z - 25)
	local plaza = math.max(0, math.sqrt(x * x + (z - 14) ^ 2) - 30)
	return math.min(road, pond, plaza)
end

-- Lighting -------------------------------------------------------------------------

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(85, 85, 95)
	Lighting.OutdoorAmbient = Color3.fromRGB(135, 135, 145)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.3
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(199, 212, 228)
	atmosphere.Decay = Color3.fromRGB(110, 120, 135)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	local grade = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	grade.Saturation = 0.12
	grade.Contrast = 0.05
	grade.Parent = Lighting
end

-- Terrain --------------------------------------------------------------------------

local function paintSquare(x: number, z: number, size: number, from: Enum.Material, to: Enum.Material)
	local region = Region3.new(Vector3.new(x - size / 2, -40, z - size / 2), Vector3.new(x + size / 2, 120, z + size / 2))
	workspace.Terrain:ReplaceMaterial(region:ExpandToGrid(4), 4, from, to)
end

local function buildTerrain()
	local terrain = workspace.Terrain
	terrain:Clear()
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 150, 62))
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(128, 100, 70))
	terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(205, 186, 140))
	pcall(function()
		(terrain :: any).Decoration = true -- animated grass where supported
	end)

	-- Flat ground, top surface at y = 0.
	terrain:FillBlock(CFrame.new(0, -6, 0), Vector3.new(HALF * 2 + 120, 12, HALF * 2 + 120), Enum.Material.Grass)

	-- Rolling bumps outside the village.
	for _ = 1, 45 do
		local x = rng:NextNumber(-HALF, HALF)
		local z = rng:NextNumber(-HALF, HALF)
		local r = rng:NextNumber(28, 60)
		local nearVillage = math.sqrt(x * x + z * z) < Config.VILLAGE_RADIUS + r + 20
		local nearPond = (Vector3.new(x, 0, z) - POND).Magnitude < POND_RADIUS + r + 20
		if not nearVillage and not nearPond and pathDistance(x, z) > r + 6 then
			terrain:FillBall(Vector3.new(x, -r * 0.72, z), r, Enum.Material.Grass)
		end
	end

	-- A ring of hills keeps players inside the map, with a gap where the north road leaves.
	local steps = 40
	for i = 0, steps - 1 do
		local angle = i / steps * math.pi * 2
		local x = math.cos(angle) * (HALF + 40)
		local z = math.sin(angle) * (HALF + 40)
		if not (z < 0 and math.abs(x) < 70) then
			local r = rng:NextNumber(80, 110)
			terrain:FillBall(Vector3.new(x, -r * 0.35, z), r, if i % 3 == 0 then Enum.Material.Rock else Enum.Material.Grass)
		end
	end

	-- Paths and the plaza.
	for z = -HALF, 16, 8 do
		paintSquare(0, z, 16, Enum.Material.Grass, Enum.Material.Ground)
	end
	paintSquare(0, 14, 56, Enum.Material.Grass, Enum.Material.Ground)
	local px, pz = POND.X - 30, POND.Z - 25
	for t = 0, 1, 0.04 do
		paintSquare(px * t, 20 + (pz - 20) * t, 12, Enum.Material.Grass, Enum.Material.Ground)
	end

	-- The pond: a sandy shore, then dig out the hole and fill it with water.
	for dx = -POND_RADIUS - 16, POND_RADIUS + 16, 8 do
		for dz = -POND_RADIUS - 16, POND_RADIUS + 16, 8 do
			if math.sqrt(dx * dx + dz * dz) < POND_RADIUS + 14 then
				paintSquare(POND.X + dx, POND.Z + dz, 8, Enum.Material.Grass, Enum.Material.Sand)
			end
		end
	end
	terrain:FillCylinder(CFrame.new(POND.X, -1, POND.Z), 10, POND_RADIUS, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(POND.X, -7, POND.Z), 2, POND_RADIUS, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(POND.X, -3.5, POND.Z), 5, POND_RADIUS - 1, Enum.Material.Water)

	-- Invisible walls at the very edge, in case someone climbs the hills.
	local walls = Build.folder("MapEdge", workspace)
	for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local size = if side.X ~= 0 then Vector3.new(4, 400, HALF * 2 + 200) else Vector3.new(HALF * 2 + 200, 400, 4)
		Build.part({
			Size = size,
			CFrame = CFrame.new(side * (HALF + 10) + Vector3.new(0, 150, 0)),
			Transparency = 1,
			CanQuery = false,
			Parent = walls,
		})
	end
end

-- Village pieces -----------------------------------------------------------------------

-- The grey house. `cframe` is the ground point with -Z facing the way the door faces (the asset
-- convention); the parts below are laid out with the door on +Z, so turn round first.
local function house(parent: Instance, name: string, cframe: CFrame, w: number, d: number, h: number, roof: Color3): Model
	local model = Build.model(name, parent)
	local base = cframe * CFrame.Angles(0, math.pi, 0)
	Build.at(model, base, Vector3.new(w + 2, 1.5, d + 2), CFrame.new(0, 0.5, 0), Build.STONE, Enum.Material.Slate)
	Build.at(model, base, Vector3.new(w, h, d), CFrame.new(0, h / 2 + 1, 0), Build.WALL, Enum.Material.SmoothPlastic)
	-- Timber corner posts.
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Build.at(model, base, Vector3.new(1, h, 1), CFrame.new(sx * w / 2, h / 2 + 1, sz * d / 2), Build.DARK_WOOD, Enum.Material.Wood)
		end
	end
	-- Roof: two tilted slabs meeting at a ridge along X.
	local rise = h * 0.6
	local half = d / 2 + 1.5
	local angle = math.atan2(rise, half)
	local slab = math.sqrt(rise * rise + half * half) + 0.6
	local top = h + 1
	for _, side in { -1, 1 } do
		Build.at(model, base, Vector3.new(w + 3, 0.8, slab), CFrame.new(0, top + rise / 2, side * half / 2) * CFrame.Angles(side * angle, 0, 0), roof, Enum.Material.SmoothPlastic)
	end
	-- Gable ends fill the triangle under the roof exactly: a strip the depth of the wall up to
	-- where the roof crosses the wall line, then two wedges whose slopes follow the roof.
	local eave = rise * (1 - (d / 2) / half) -- height of the roof above the wall top, at the wall line
	local peak = rise - eave
	for _, sx in { -1, 1 } do
		Build.at(model, base, Vector3.new(0.6, eave, d), CFrame.new(sx * w / 2, top + eave / 2, 0), Build.WALL, Enum.Material.SmoothPlastic)
		for _, sz in { -1, 1 } do
			-- A wedge is tallest at its +Z end; point that end at the ridge.
			local turn = CFrame.Angles(0, if sz > 0 then math.pi else 0, 0)
			Build.at(model, base, Vector3.new(0.6, peak, d / 2), CFrame.new(sx * w / 2, top + eave + peak / 2, sz * d / 4) * turn, Build.WALL, Enum.Material.SmoothPlastic, { Class = "WedgePart" })
		end
	end
	Build.at(model, base, Vector3.new(w + 3.2, 0.9, 0.9), CFrame.new(0, top + rise + 0.2, 0), Build.DARK_WOOD, Enum.Material.Wood)
	-- Door and glowing windows on the front (+Z) wall.
	Build.at(model, base, Vector3.new(4, 7, 0.4), CFrame.new(0, 4.5, d / 2 + 0.2), Build.DARK_WOOD, Enum.Material.WoodPlanks)
	for _, sx in { -1, 1 } do
		Build.at(model, base, Vector3.new(3, 3, 0.3), CFrame.new(sx * w * 0.3, h * 0.62 + 1, d / 2 + 0.15), Color3.fromRGB(255, 214, 130), Enum.Material.Neon, { Transparency = 0.25 })
		Build.at(model, base, Vector3.new(3.6, 0.5, 0.6), CFrame.new(sx * w * 0.3, h * 0.62 - 0.8, d / 2 + 0.3), Build.DARK_WOOD, Enum.Material.Wood)
	end
	Build.at(model, base, Vector3.new(2.4, 7, 2.4), CFrame.new(w * 0.28, top + rise * 0.7, -d * 0.18), Color3.fromRGB(150, 85, 70), Enum.Material.Brick)
	return model
end

-- Places a house whose door faces `face` quarter turns round from south (0 = +Z, 1 = +X, 2 = -Z,
-- 3 = -X). Houses of the same size share an asset name, so one model can replace several.
local function placeHouse(parent: Instance, asset: string, name: string, at: Vector3, w: number, d: number, h: number, face: number, roof: Color3)
	-- Asset fronts face -Z, so add a half turn: the front then faces the same way as the door.
	local model = Assets.place(asset, ground(at, face * math.pi / 2 + math.pi), parent, function(base, into)
		return house(into, name, base, w, d, h, roof)
	end)
	model.Name = name
end

local function campfire(base: CFrame, parent: Instance): Model
	local model = Build.model("Campfire", parent)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Build.ball(model, (base * CFrame.new(math.cos(a) * 3.4, 0.4, math.sin(a) * 3.4)).Position, 1.8, Color3.fromRGB(110, 108, 104), Enum.Material.Slate)
	end
	Build.at(model, base, Vector3.new(5, 0.8, 0.8), CFrame.new(0, 0.6, 0) * CFrame.Angles(0, math.rad(35), 0), Build.WOOD, Enum.Material.Wood)
	Build.at(model, base, Vector3.new(5, 0.8, 0.8), CFrame.new(0, 0.6, 0) * CFrame.Angles(0, math.rad(-35), 0), Build.WOOD, Enum.Material.Wood)
	local flame = Build.at(model, base, Vector3.new(1, 1, 1), CFrame.new(0, 1.2, 0), Color3.new(1, 0.6, 0.2), nil, {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Name = "Flame",
	})
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 9
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 70, 20)
	fire.Parent = flame
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Range = 26
	light.Brightness = 2
	light.Shadows = true
	light.Parent = flame
	-- A low invisible block so players walk around the fire, not through it.
	Build.at(model, base, Vector3.new(5.5, 2, 5.5), CFrame.new(0, 1, 0), Color3.new(), nil, { Transparency = 1, CanQuery = false })
	return model
end

local function well(base: CFrame, parent: Instance): Model
	local model = Build.model("Well", parent)
	Build.cylinder(model, base, 3.4, 8, Vector3.new(0, 1.7, 0), Build.STONE, Enum.Material.Cobblestone)
	Build.cylinder(model, base, 0.2, 6.6, Vector3.new(0, 3.45, 0), Color3.fromRGB(50, 95, 160), Enum.Material.Glass, { Transparency = 0.2, CanCollide = false })
	for _, sx in { -1, 1 } do
		Build.at(model, base, Vector3.new(0.6, 6, 0.6), CFrame.new(sx * 3.4, 6, 0), Build.WOOD, Enum.Material.Wood)
	end
	Build.at(model, base, Vector3.new(7.4, 0.5, 0.5), CFrame.new(0, 7.6, 0), Build.WOOD, Enum.Material.Wood)
	for _, side in { -1, 1 } do
		Build.at(model, base, Vector3.new(8.6, 0.5, 4.6), CFrame.new(0, 9.6, side * 1.9) * CFrame.Angles(side * math.rad(28), 0, 0), Color3.fromRGB(110, 75, 50), Enum.Material.WoodPlanks)
	end
	Build.at(model, base, Vector3.new(1, 1.2, 1), CFrame.new(0, 6.4, 0), Color3.fromRGB(120, 90, 60), Enum.Material.Wood)
	return model
end

local function workbench(parent: Instance, at: Vector3)
	local model = Build.model("Workbench", parent)
	local base = CFrame.new(at.X, Build.groundY(at.X, at.Z), at.Z)
	local top = Build.at(model, base, Vector3.new(9, 0.7, 4.2), CFrame.new(0, 3.2, 0), Build.WOOD, Enum.Material.WoodPlanks)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Build.at(model, base, Vector3.new(0.6, 3, 0.6), CFrame.new(sx * 3.9, 1.5, sz * 1.6), Build.DARK_WOOD, Enum.Material.Wood)
		end
	end
	Build.at(model, base, Vector3.new(1.8, 0.6, 1), CFrame.new(-2, 3.85, 0), Color3.fromRGB(150, 150, 160), Enum.Material.Metal)
	Build.at(model, base, Vector3.new(0.3, 0.3, 2.2), CFrame.new(1.5, 3.7, 0.4), Build.DARK_WOOD, Enum.Material.Wood)
	-- Opens the crafting panel on that player's screen; Inventory checks they're still close when crafting.
	local openCrafting = Net.event("OpenCrafting")
	Inventory.setWorkbench(top.Position)
	Interactables.prompt(top, "Craft", "Workbench", function(player)
		openCrafting:FireClient(player)
	end)
end

local function wheatField(parent: Instance, centre: Vector3)
	local model = Build.model("WheatField", parent)
	local base = CFrame.new(centre.X, Build.groundY(centre.X, centre.Z), centre.Z)
	Build.at(model, base, Vector3.new(52, 0.6, 38), CFrame.new(0, 0.2, 0), Color3.fromRGB(120, 88, 55), Enum.Material.Ground)
	for row = 0, 15 do
		local z = -17 + row * 2.3
		Build.at(model, base, Vector3.new(50, 3.2 + rng:NextNumber(-0.3, 0.3), 1.1), CFrame.new(0, 2, z), Color3.fromRGB(232, 196, 92), Enum.Material.Fabric, { CanCollide = false })
	end
	for _, sx in { -1, 1 } do
		Build.at(model, base, Vector3.new(0.6, 4, 0.6), CFrame.new(sx * 27, 2, -20), Build.WOOD, Enum.Material.Wood)
	end
	gatherSpot(model, base * CFrame.new(0, 3, 0), "wheat", "wheat_field", 24)
end

local function beehive(parent: Instance, at: Vector3, index: number)
	local model = Build.model("Beehive", parent)
	local base = CFrame.new(at.X, Build.groundY(at.X, at.Z), at.Z)
	Build.at(model, base, Vector3.new(3.4, 2, 3.4), CFrame.new(0, 1, 0), Build.WOOD, Enum.Material.WoodPlanks)
	Build.at(model, base, Vector3.new(3, 1.6, 3), CFrame.new(0, 2.8, 0), Color3.fromRGB(220, 165, 70), Enum.Material.SmoothPlastic)
	Build.at(model, base, Vector3.new(3, 1.4, 3), CFrame.new(0, 4.3, 0), Color3.fromRGB(205, 150, 60), Enum.Material.SmoothPlastic)
	Build.at(model, base, Vector3.new(4, 0.5, 4), CFrame.new(0, 5.2, 0), Build.WOOD, Enum.Material.WoodPlanks)
	gatherSpot(model, base * CFrame.new(0, 3, 0), "honey", `beehive_{index}`)
end

local function leafyTree(base: CFrame, parent: Instance, scale: number, apples: boolean): Model
	local model = Build.model(if apples then "AppleTree" else "Tree", parent)
	local at = base.Position
	local trunk = 8 * scale
	Build.cylinder(model, base, trunk, 1.7 * scale, Vector3.new(0, trunk / 2, 0), Build.BARK, Enum.Material.Wood)
	local leafProps = { CanCollide = false, CanQuery = false }
	Build.ball(model, at + Vector3.new(0, trunk + 2.5 * scale, 0), 11 * scale, Build.LEAF, Enum.Material.Grass, leafProps)
	Build.ball(model, at + Vector3.new(2.2 * scale, trunk + 5 * scale, -1.2 * scale), 7 * scale, Color3.fromRGB(85, 155, 70), Enum.Material.Grass, leafProps)
	if apples then
		for i = 0, 5 do
			local a = i * 1.05
			Build.ball(model, at + Vector3.new(math.cos(a) * 5 * scale, trunk + (i % 3) * 1.6 * scale, math.sin(a) * 5 * scale), 1.2, Color3.fromRGB(215, 35, 30), nil, leafProps)
		end
	end
	return model
end

local function pineTree(base: CFrame, parent: Instance, scale: number): Model
	local model = Build.model("Pine", parent)
	local trunk = 6 * scale
	Build.cylinder(model, base, trunk, 1.4 * scale, Vector3.new(0, trunk / 2, 0), Build.BARK, Enum.Material.Wood)
	for tier = 0, 3 do
		local width = (10 - tier * 2.3) * scale
		local height = 3.2 * scale
		Build.at(model, base, Vector3.new(width, height, width), CFrame.new(0, trunk - 1 + tier * 3 * scale, 0) * CFrame.Angles(0, math.rad(45 * tier), 0), Build.PINE, Enum.Material.Grass, { CanCollide = false, CanQuery = false })
	end
	return model
end

local function rock(base: CFrame, parent: Instance, size: number, tiltX: number, tiltZ: number, shade: number): BasePart
	return Build.part({
		Name = "Rock",
		Size = Vector3.new(size * 1.6, size * 0.9, size * 1.3),
		CFrame = base * CFrame.new(0, size * 0.2, 0) * CFrame.Angles(tiltX, 0, tiltZ),
		Color = Color3.fromRGB(128 + shade, 124, 118),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
end

local function fence(parent: Instance)
	local model = Build.model("Fence", parent)
	local radius = Config.VILLAGE_RADIUS + 4
	local count = 56
	local posts: { Vector3? } = {}
	for i = 0, count - 1 do
		local a = i / count * math.pi * 2
		local x, z = math.cos(a) * radius, math.sin(a) * radius
		if pathDistance(x, z) > 12 then
			posts[i + 1] = Vector3.new(x, Build.groundY(x, z), z)
		end
	end
	for i = 1, count do
		local p = posts[i]
		local q = posts[i % count + 1]
		if p then
			Build.at(model, CFrame.new(p), Vector3.new(1, 5, 1), CFrame.new(0, 2.5, 0), Build.WOOD, Enum.Material.Wood)
			if q then
				local mid = (p + q) / 2
				local length = (q - p).Magnitude
				local look = CFrame.lookAt(mid, mid + Vector3.new(q.X - p.X, 0, q.Z - p.Z))
				for _, railY in { 1.8, 3.6 } do
					Build.at(model, look, Vector3.new(0.4, 0.5, length), CFrame.new(0, railY, 0), Build.WOOD, Enum.Material.Wood)
				end
			end
		end
	end
end

local function signpost(parent: Instance, at: Vector3)
	local model = Build.model("Signpost", parent)
	local base = CFrame.new(at.X, Build.groundY(at.X, at.Z), at.Z)
	local post = Build.cylinder(model, base, 10, 1, Vector3.new(0, 5, 0), Build.WOOD, Enum.Material.Wood)
	local board = Color3.fromRGB(160, 120, 70)
	Build.at(model, base, Vector3.new(6, 1.4, 0.4), CFrame.new(-3.2, 8.6, 0), board, Enum.Material.WoodPlanks) -- west
	Build.at(model, base, Vector3.new(0.4, 1.4, 6), CFrame.new(0, 7, -3.2), board, Enum.Material.WoodPlanks) -- north
	Build.at(model, base, Vector3.new(6, 1.4, 0.4), CFrame.new(3.2, 5.4, 0), board, Enum.Material.WoodPlanks) -- east
	Interactables.add(post, {
		actionText = "Read",
		objectText = "Signpost",
		speaker = "Crossroads signpost",
		lines = {
			"West: Whispering Woods. Wolves and bears; beyond them the Fairy Glade and the Labyrinth Ruins.",
			"North: Ashen Peaks. Ember slimes, lava and the Elder Dragon's den.",
			"East: the Shattered Rift. Sealed until you carry two Sigils.",
		},
	})
end

local function gate(parent: Instance, at: Vector3)
	local model = Build.model("CrossroadsGate", parent)
	local base = CFrame.new(at.X, Build.groundY(at.X, at.Z), at.Z)
	for _, sx in { -1, 1 } do
		Build.at(model, base, Vector3.new(3, 16, 3), CFrame.new(sx * 11, 8, 0), Build.STONE, Enum.Material.Cobblestone)
	end
	Build.at(model, base, Vector3.new(26, 2.2, 3.4), CFrame.new(0, 17, 0), Build.STONE, Enum.Material.Cobblestone)
	Build.at(model, base, Vector3.new(7, 2, 0.6), CFrame.new(0, 19.4, 0), Color3.fromRGB(240, 200, 90), Enum.Material.Neon)
	local ward = Build.at(model, base, Vector3.new(19, 15, 1), CFrame.new(0, 7.5, -0.5), Color3.fromRGB(140, 110, 255), Enum.Material.ForceField, {
		Name = "Ward",
		Transparency = 0.1,
	})
	Interactables.add(ward, {
		actionText = "Touch the ward",
		objectText = "The Crossroads",
		speaker = "The Crossroads",
		distance = 16,
		lines = {
			"A shimmering ward blocks the road. Beyond it lie the paths to the Whispering Woods, the Ashen Peaks and the Shattered Rift.",
			"The ward will lift when the Whispering Woods open.",
		},
	})
end

local function elder(parent: Instance, at: Vector3)
	local model = Build.model("ElderMaren", parent)
	local y = Build.groundY(at.X, at.Z)
	local base = CFrame.new(at.X, y, at.Z)
	local robe = Color3.fromRGB(90, 80, 120)
	Build.at(model, base, Vector3.new(2.6, 4.2, 1.8), CFrame.new(0, 2.1, 0), robe, Enum.Material.Fabric)
	local torso = Build.at(model, base, Vector3.new(2.8, 2.2, 1.6), CFrame.new(0, 5.2, 0), robe, Enum.Material.Fabric)
	local head = Build.at(model, base, Vector3.new(1.7, 1.7, 1.7), CFrame.new(0, 7.15, 0), Color3.fromRGB(230, 190, 160), nil, { Name = "Head" })
	Build.at(model, base, Vector3.new(1.9, 0.7, 1.9), CFrame.new(0, 8.1, 0.05), Color3.fromRGB(235, 235, 240), Enum.Material.Fabric) -- hair
	Build.at(model, base, Vector3.new(1.3, 1.4, 0.4), CFrame.new(0, 6.3, -0.9), Color3.fromRGB(240, 240, 245), Enum.Material.Fabric) -- beard (front is -Z)
	for _, sx in { -1, 1 } do
		Build.at(model, base, Vector3.new(0.25, 0.2, 0.1), CFrame.new(sx * 0.4, 7.35, -0.86), Color3.fromRGB(30, 25, 25))
		Build.at(model, base, Vector3.new(0.8, 2.4, 0.8), CFrame.new(sx * 1.8, 5.1, 0), robe, Enum.Material.Fabric)
	end
	Build.at(model, base, Vector3.new(0.4, 9, 0.4), CFrame.new(2.4, 4.5, -0.6), Build.WOOD, Enum.Material.Wood) -- staff
	Build.ball(model, (base * CFrame.new(2.4, 9.3, -0.6)).Position, 1.1, Color3.fromRGB(120, 230, 150), Enum.Material.Neon)
	Build.nameTag(head, "Elder Maren", nil, 2.6)
	model.PrimaryPart = torso
	-- Face the plaza and the player's spawn point.
	model:PivotTo(CFrame.lookAt(model:GetPivot().Position, Vector3.new(0, model:GetPivot().Position.Y, 30)))
	Interactables.add(torso, {
		actionText = "Talk",
		objectText = "Elder Maren",
		speaker = "Elder Maren",
		faceModel = model,
		-- What she says depends on the player's quests (Shared/QuestData).
		getLines = function(player: Player)
			return Quests.talk(player, "elder")
		end,
	})
end

local function buildVillage()
	local village = Build.folder("Village", workspace)
	placeHouse(village, "ElderHall", "ElderHall", v2(-14, -16), 31, 24, 15, 0, Color3.fromRGB(160, 50, 40))
	placeHouse(village, "HouseSmall", "HouseNorthEast", v2(15, -18), 21, 21, 11, 0, Color3.fromRGB(110, 78, 52))
	placeHouse(village, "HouseWide", "HouseWest", v2(-24, 8), 24, 21, 11, 1, Color3.fromRGB(160, 50, 40))
	placeHouse(village, "HouseWide", "HouseEast", v2(24, 10), 24, 21, 11, 3, Color3.fromRGB(70, 90, 145))
	placeHouse(village, "HouseSmall", "HouseSouth", v2(-9, 24), 21, 21, 12, 2, Color3.fromRGB(110, 78, 52))
	Assets.place("Campfire", ground(v2(0, 4)), village, campfire)
	Assets.place("Well", ground(v2(7, 9)), village, well)
	workbench(village, v2(9, -7))
	wheatField(village, v2(20, 28))
	for i, p in { v2(-28, 24), v2(-32, 19), v2(-24, 29) } do
		beehive(village, p, i)
	end
	for i, p in { v2(-30, -4), v2(-33, 7), v2(30, -7), v2(34, 2), v2(-4, 36) } do
		gatherSpot(village, ground(p) * CFrame.new(0, 4, 0), "apple", `apple_tree_{i}`)
		Assets.place("AppleTree", ground(p, (p.X * 7.1 + p.Z * 3.7) % (math.pi * 2)), village, function(base, into)
			return leafyTree(base, into, 1, true)
		end)
	end
	fence(village)
	signpost(village, v2(4, -52))
	gate(village, Vector3.new(0, 0, -364))
	elder(village, ELDER)

	local training = Build.folder("TrainingGround", workspace)
	for _, p in { v2(13, -1), v2(16, 1.5), v2(19, -1) } do
		Dummy.create(training, Vector3.new(p.X, Build.groundY(p.X, p.Z), p.Z), Vector3.new(0, 0, p.Z))
	end
end

local function buildScenery()
	local scenery = Build.folder("Scenery", workspace)
	local placed = 0
	for _ = 1, 1400 do
		local x = rng:NextNumber(-HALF + 10, HALF - 10)
		local z = rng:NextNumber(-HALF + 10, HALF - 10)
		local fromCentre = math.sqrt(x * x + z * z)
		local nearPond = (Vector3.new(x, 0, z) - POND).Magnitude < POND_RADIUS + 18
		if fromCentre > Config.VILLAGE_RADIUS + 25 and not nearPond and pathDistance(x, z) > 16 then
			local y = Build.groundY(x, z)
			local roll = rng:NextNumber()
			-- Keep the order of rng calls the same, so the layout doesn't change between builds.
			if roll < 0.24 then
				local scale = rng:NextNumber(0.9, 1.6)
				if rng:NextNumber() < 0.6 then
					local cframe = CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
					Assets.place("Pine", cframe, scenery, function(base, into)
						return pineTree(base, into, scale)
					end, scale)
				else
					local cframe = CFrame.new(x, y, z) * CFrame.Angles(0, (x * 7.1 + z * 3.7) % (math.pi * 2), 0)
					Assets.place("Tree", cframe, scenery, function(base, into)
						return leafyTree(base, into, scale, false)
					end, scale)
				end
				placed += 1
			elseif roll < 0.32 then
				-- Replacement rock models are made at the size of a size-4 grey rock and scaled.
				local size = rng:NextNumber(2, 6)
				local tiltX, yaw, tiltZ = rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)
				local shade = rng:NextInteger(-10, 10)
				Assets.place("Rock", CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0), scenery, function(base, into)
					return rock(base, into, size, tiltX, tiltZ, shade)
				end, size / 4)
			end
		end
	end
	return placed
end

local function buildSpawn()
	Build.part({
		Class = "SpawnLocation",
		Name = "VillageSpawn",
		Size = Vector3.new(8, 1, 8),
		-- New arrivals face Elder Maren (characters spawn looking along the spawn's -Z).
		CFrame = CFrame.lookAt(Config.SPAWN_POSITION, Vector3.new(ELDER.X, Config.SPAWN_POSITION.Y, ELDER.Z)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Duration = 0,
		Neutral = true,
		Parent = workspace,
	})
end

local function buildCreatures()
	Creature.start()
	Creature.spawner(CreatureData.creatures.wolf, v2(-72, -40), 3, 40)
	Creature.spawner(CreatureData.creatures.wolf, v2(74, -30), 3, 40)
	Creature.spawner(CreatureData.creatures.boar, v2(-55, 70), 3, 45)
	-- Foxes in the south meadow, one group each side of the pond path, well away from the wolves.
	Creature.spawner(CreatureData.creatures.fox, v2(-12, 88), 3, 45)
	Creature.spawner(CreatureData.creatures.fox, v2(62, 52), 3, 45)
end

function Hearthmoor.build()
	local started = os.clock()
	setupLighting()
	buildTerrain()
	buildSpawn()
	buildVillage()
	local trees = buildScenery()
	buildCreatures()
	print(string.format("[Mythbound] Hearthmoor built in %.2fs (%d trees)", os.clock() - started, trees))
end

return Hearthmoor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Interactables</string><ProtectedString name="Source"><![CDATA[-- Talk to NPCs and read signs. Uses ProximityPrompts, which work with keyboard (F),
-- controller (Y) and touch automatically.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local Interactables = {}

local dialogueEvent = Net.event("Dialogue")

export type Options = {
	actionText: string, -- e.g. "Talk"
	objectText: string, -- e.g. "Elder Maren"
	speaker: string,
	lines: { string }?,
	getLines: ((player: Player) -> { string })?, -- decides the lines per player (e.g. quest givers)
	distance: number?,
	faceModel: Model?, -- turns this model to face the player when used
}

function Interactables.add(anchor: BasePart, options: Options): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = options.actionText
	prompt.ObjectText = options.objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = options.distance or 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor

	prompt.Triggered:Connect(function(player: Player)
		local face = options.faceModel
		local character = player.Character
		if face and character and character.PrimaryPart then
			local pivot = face:GetPivot()
			local target = character.PrimaryPart.Position
			face:PivotTo(CFrame.lookAt(pivot.Position, Vector3.new(target.X, pivot.Position.Y, target.Z)))
		end
		local lines = if options.getLines then options.getLines(player) else options.lines
		if lines then
			dialogueEvent:FireClient(player, options.speaker, lines)
		end
	end)
	return prompt
end

-- A prompt that runs `onTriggered(player)` (gathering, the workbench). F / controller Y / touch.
function Interactables.prompt(anchor: BasePart, actionText: string, objectText: string, onTriggered: (Player) -> (), distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = distance or 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	prompt.Triggered:Connect(onTriggered)
	return prompt
end

return Interactables
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Inventory</string><ProtectedString name="Source"><![CDATA[-- Each player's items (saved in PlayerData), gathering, crafting at the workbench and using items.
-- The server owns every count; clients only ask (UseItem, Craft) and are sent their counts back.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemData = require(Shared:WaitForChild("ItemData"))
local Net = require(Shared:WaitForChild("Net"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local Inventory = {}

local WORKBENCH_RANGE = 20 -- studs; crafting only works standing at the workbench

local inventoryEvent = Net.event("Inventory")
local toastEvent = Net.event("Toast")

local lastPotion: { [Player]: number } = {}
local lastGather: { [Player]: { [string]: number } } = {}
local workbenchPosition: Vector3? = nil

local function items(player: Player): { [string]: number }?
	local data = PlayerData.get(player)
	return data and data.inventory
end

function Inventory.count(player: Player, itemId: string): number
	local bag = items(player)
	return bag and bag[itemId] or 0
end

function Inventory.send(player: Player)
	inventoryEvent:FireClient(player, items(player) or {})
end

-- Adds items, up to the stack limit. Returns how many fitted.
function Inventory.add(player: Player, itemId: string, count: number): number
	local bag = items(player)
	if not bag or not ItemData.get(itemId) or count <= 0 then
		return 0
	end
	local have = bag[itemId] or 0
	local added = math.min(count, ItemData.MAX_STACK - have)
	if added <= 0 then
		return 0
	end
	bag[itemId] = have + added
	PlayerData.markDirty(player)
	Inventory.send(player)
	return added
end

-- Takes items away if the player has enough. Returns true if it did.
function Inventory.remove(player: Player, itemId: string, count: number): boolean
	local bag = items(player)
	if not bag or (bag[itemId] or 0) < count then
		return false
	end
	bag[itemId] -= count
	if bag[itemId] <= 0 then
		bag[itemId] = nil
	end
	PlayerData.markDirty(player)
	Inventory.send(player)
	return true
end

function Inventory.setWorkbench(position: Vector3)
	workbenchPosition = position
end

-- Gathers from a spot (`kind` is a key of ItemData.gather; `spotId` names the particular
-- beehive, tree or field, so each has its own timer per player).
function Inventory.gather(player: Player, kind: string, spotId: string)
	local spec = ItemData.gather[kind]
	local character = player.Character
	if not spec or not character or not Combat.isAlive(character) or not items(player) then
		return
	end
	local timers = lastGather[player] or {}
	lastGather[player] = timers
	local now = os.clock()
	local waitLeft = (timers[spotId] or -math.huge) + spec.cooldown - now
	if waitLeft > 0 then
		toastEvent:FireClient(player, `Nothing to gather yet ({math.ceil(waitLeft)}s)`)
		return
	end
	timers[spotId] = now
	local count = math.random(spec.min, spec.max)
	local added = Inventory.add(player, spec.item, count)
	local item = ItemData.items[spec.item]
	if added > 0 then
		toastEvent:FireClient(player, `+{added} {item.name}`)
	else
		toastEvent:FireClient(player, `You can't carry more {item.name}`)
	end
	if spec.sting and math.random() < spec.sting.chance then
		Combat.damage(character, spec.sting.damage, nil)
		toastEvent:FireClient(player, "Ouch! A bee stung you")
	end
end

local function onUseItem(player: Player, itemId: any)
	local item = ItemData.get(itemId)
	local character = player.Character
	if not item or not item.usable or not character or not Combat.isAlive(character) then
		return
	end
	if item.id == "healing_potion" then
		local now = os.clock()
		if now - (lastPotion[player] or -100) < ItemData.POTION_COOLDOWN then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid
		if humanoid.Health >= humanoid.MaxHealth then
			toastEvent:FireClient(player, "You're already at full health")
			return
		end
		if not Inventory.remove(player, item.id, 1) then
			toastEvent:FireClient(player, "No healing potions. Craft one at the workbench")
			return
		end
		lastPotion[player] = now
		Combat.heal(character, humanoid.MaxHealth * ItemData.POTION_HEAL)
		local root = Combat.rootOf(character)
		if root then
			Combat.burst(root.Position, 6, Color3.fromRGB(235, 90, 140))
		end
	end
end

local function onCraft(player: Player, recipeId: any)
	local recipe = ItemData.recipe(recipeId)
	local character = player.Character
	local root = character and Combat.rootOf(character)
	if not recipe or not root or not workbenchPosition then
		return
	end
	if (root.Position - workbenchPosition).Magnitude > WORKBENCH_RANGE then
		toastEvent:FireClient(player, "Stand at the workbench to craft")
		return
	end
	for itemId, need in recipe.ingredients do
		if Inventory.count(player, itemId) < need then
			toastEvent:FireClient(player, `You need {need} {ItemData.items[itemId].name}`)
			return
		end
	end
	if Inventory.count(player, recipe.id) + recipe.count > ItemData.MAX_STACK then
		toastEvent:FireClient(player, "You can't carry any more of those")
		return
	end
	for itemId, need in recipe.ingredients do
		Inventory.remove(player, itemId, need)
	end
	Inventory.add(player, recipe.id, recipe.count)
	toastEvent:FireClient(player, `Crafted {ItemData.items[recipe.id].name}`)
end

function Inventory.start()
	Net.event("UseItem").OnServerEvent:Connect(onUseItem)
	Net.event("Craft").OnServerEvent:Connect(onCraft)
	PlayerData.onLoaded(Inventory.send)
	Players.PlayerRemoving:Connect(function(player)
		lastPotion[player] = nil
		lastGather[player] = nil
	end)
end

return Inventory
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000018"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Server entry point. Order matters: remotes and the world must exist before anyone spawns.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net")) -- creates the RemoteEvents

local Combat = require(script.Parent:WaitForChild("Combat"))
local Companions = require(script.Parent:WaitForChild("Companions"))
local Creature = require(script.Parent:WaitForChild("Creature"))
local Drops = require(script.Parent:WaitForChild("Drops"))
local Hearthmoor = require(script.Parent:WaitForChild("Hearthmoor"))
local Inventory = require(script.Parent:WaitForChild("Inventory"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local PlayerSetup = require(script.Parent:WaitForChild("PlayerSetup"))
local Quests = require(script.Parent:WaitForChild("Quests"))
local Skills = require(script.Parent:WaitForChild("Skills"))
local Taming = require(script.Parent:WaitForChild("Taming"))

PlayerData.start() -- starts loading saves as players join
Quests.start()
Inventory.start()
Drops.start()
Companions.start()
Taming.start() -- before the world is built, so every creature gets its feed prompt

-- Everyone who damaged a creature gets its full XP, quest credit and their own loot.
-- A companion's bites count for its owner.
Creature.onDefeated(function(data, players, position)
	for _, player in players do
		PlayerData.addXP(player, data.xp, `{data.name} defeated`)
		Quests.recordDefeat(player, data.id)
	end
	Drops.forDefeat(data.id, position, players)
end)

PlayerSetup.start() -- turns off automatic spawning first
Combat.start()
Skills.start()
Hearthmoor.build()

workspace:SetAttribute("WorldReady", true)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- Each player's saved progress: class, level, XP, quests, items and companions. Loaded on join, saved on leave,
-- every few minutes and when the server shuts down. One DataStore key per player
-- ("player_<UserId>"), with a `version` field so old saves can be upgraded.
--
-- Studio uses its own store, so test saves never touch real players' progress. DataStores in
-- Studio need Game Settings > Security > "Enable Studio Access to API Services".
-- If a save can't be loaded, the player still plays but nothing is saved that session, so a
-- good save is never overwritten with a blank one.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ClassData = require(Shared:WaitForChild("ClassData"))
local CompanionData = require(Shared:WaitForChild("CompanionData"))
local CreatureData = require(Shared:WaitForChild("CreatureData"))
local Net = require(Shared:WaitForChild("Net"))
local Progression = require(Shared:WaitForChild("Progression"))

local PlayerData = {}

local SAVE_VERSION = 3 -- 2: added inventory and gifts; 3: added companions
local STORE_NAME = if RunService:IsStudio() then "PlayerData_Studio" else "PlayerData"
local AUTOSAVE_INTERVAL = 180
local RETRIES = 3

export type QuestState = { status: string, progress: number } -- status: "active" | "ready" | "done"
-- A tamed creature. `id` is its CreatureData id; `active` means it is out with the player
-- (the others wait at home). Health isn't saved: companions come back at full health.
export type CompanionEntry = { uid: number, id: string, name: string, active: boolean }
export type Data = {
	version: number,
	class: string?,
	level: number,
	xp: number,
	quests: { [string]: QuestState },
	inventory: { [string]: number }, -- item id -> count
	gifts: { [string]: boolean }, -- one-off gifts already given (e.g. the Elder's potions)
	companions: { CompanionEntry }, -- shared by all the player's classes
	nextCompanionUid: number,
}

local toastEvent = Net.event("Toast")
local levelUpEvent = Net.event("LevelUp")

local profiles: { [Player]: Data } = {}
local canSave: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local waiting: { [Player]: { thread } } = {}
local loadedListeners: { (Player) -> () } = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStores unavailable, progress won't be saved:", result)
	end
end

local function key(player: Player): string
	return "player_" .. player.UserId
end

local function newData(): Data
	return { version = SAVE_VERSION, class = nil, level = 1, xp = 0, quests = {}, inventory = {}, gifts = {}, companions = {}, nextCompanionUid = 1 }
end

-- Fills in anything missing and upgrades old versions. Add a step here whenever SAVE_VERSION goes up.
local function migrate(raw: any): Data
	if type(raw) ~= "table" then
		return newData()
	end
	local data = raw :: Data
	data.version = SAVE_VERSION
	data.level = math.clamp(tonumber(data.level) or 1, 1, Progression.MAX_LEVEL)
	data.xp = math.max(0, tonumber(data.xp) or 0)
	if type(data.quests) ~= "table" then
		data.quests = {}
	end
	-- Version 1 saves had no inventory or gifts.
	if type(data.inventory) ~= "table" then
		data.inventory = {}
	end
	if type(data.gifts) ~= "table" then
		data.gifts = {}
	end
	if data.class ~= nil and not ClassData.get(data.class) then
		data.class = nil
	end
	-- Version 2 saves had no companions. Keep only well-formed entries for creatures that can
	-- still be tamed, with unique ids, and no more than a player may own.
	local companions: { CompanionEntry } = {}
	local seen: { [number]: boolean } = {}
	local highest = 0
	if type(data.companions) == "table" then
		for _, entry: any in data.companions :: any do
			if #companions >= CompanionData.STABLE_SIZE then
				break
			end
			if type(entry) == "table" and CreatureData.tameable(entry.id) and type(entry.uid) == "number"
				and entry.uid >= 1 and entry.uid == math.floor(entry.uid) and not seen[entry.uid] then
				seen[entry.uid] = true
				highest = math.max(highest, entry.uid)
				local name = if type(entry.name) == "string" and #entry.name > 0
					then string.sub(entry.name, 1, CompanionData.MAX_NAME)
					else CreatureData.creatures[entry.id].name
				table.insert(companions, { uid = entry.uid, id = entry.id, name = name, active = entry.active == true })
			end
		end
	end
	data.companions = companions
	data.nextCompanionUid = math.max(math.floor(tonumber(data.nextCompanionUid) or 1), highest + 1)
	return data
end

-- Copies level and XP onto the player as attributes, which replicate to every client.
local function publish(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Level", data.level)
	player:SetAttribute("XP", data.xp)
	player:SetAttribute("XPNext", Progression.xpToNext(data.level))
	player:SetAttribute("SavedClass", data.class)
end

local function load(player: Player)
	local data: Data? = nil
	local ok = store ~= nil
	if store then
		ok = false
		for attempt = 1, RETRIES do
			local success, result = pcall(function()
				return (store :: DataStore):GetAsync(key(player))
			end)
			if success then
				data = migrate(result)
				ok = true
				break
			end
			warn(`[PlayerData] Loading {player.Name} failed (try {attempt}):`, result)
			if string.find(tostring(result), "Studio access", 1, true) then
				warn("[PlayerData] Turn on Game Settings > Security > Enable Studio Access to API Services to test saving in Studio.")
				break -- retrying won't help
			end
			if not player.Parent then
				break
			end
			task.wait(attempt * 2)
		end
	end
	if not player.Parent then
		return
	end
	profiles[player] = data or newData()
	canSave[player] = ok
	if not ok then
		toastEvent:FireClient(player, "Progress couldn't be loaded, so it won't be saved this time")
	end
	publish(player)
	player:SetAttribute("DataLoaded", true)
	for _, thread in waiting[player] or {} do
		task.spawn(thread, profiles[player])
	end
	waiting[player] = nil
	for _, listener in loadedListeners do
		task.spawn(listener, player)
	end
end

-- Saves now if anything changed (or always, with `force`). Returns true when saved.
function PlayerData.save(player: Player, force: boolean?): boolean
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return false
	end
	if not force and not dirty[player] then
		return true
	end
	dirty[player] = false
	for attempt = 1, RETRIES do
		local success, err = pcall(function()
			(store :: DataStore):UpdateAsync(key(player), function()
				return data
			end)
		end)
		if success then
			return true
		end
		warn(`[PlayerData] Saving {player.Name} failed (try {attempt}):`, err)
		task.wait(attempt)
	end
	dirty[player] = true
	return false
end

function PlayerData.get(player: Player): Data?
	return profiles[player]
end

-- Waits until the player's save has loaded. Returns nil if they leave first.
function PlayerData.whenLoaded(player: Player): Data?
	if profiles[player] then
		return profiles[player]
	end
	if not player.Parent then
		return nil
	end
	waiting[player] = waiting[player] or {}
	table.insert(waiting[player], coroutine.running())
	return coroutine.yield()
end

-- Runs `listener(player)` each time a player's save finishes loading.
function PlayerData.onLoaded(listener: (Player) -> ())
	table.insert(loadedListeners, listener)
end

function PlayerData.markDirty(player: Player)
	dirty[player] = true
end

function PlayerData.setClass(player: Player, classId: string)
	local data = profiles[player]
	if data and data.class ~= classId then
		data.class = classId
		dirty[player] = true
		publish(player)
	end
end

-- Gives XP and handles level-ups. `reason` (e.g. "Wolf defeated") is shown in a toast.
function PlayerData.addXP(player: Player, amount: number, reason: string?)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	if reason then
		toastEvent:FireClient(player, `{reason} (+{amount} XP)`)
	end
	if data.level >= Progression.MAX_LEVEL then
		return
	end
	data.xp += amount
	local levelled = false
	while data.level < Progression.MAX_LEVEL and data.xp >= Progression.xpToNext(data.level) do
		data.xp -= Progression.xpToNext(data.level)
		data.level += 1
		levelled = true
	end
	if data.level >= Progression.MAX_LEVEL then
		data.xp = 0
	end
	dirty[player] = true
	publish(player) -- PlayerSetup watches the Level attribute and raises max health
	if levelled then
		levelUpEvent:FireAllClients(player, data.level)
	end
end

local started = false
function PlayerData.start()
	if started then
		return
	end
	started = true
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerData.save(player, true)
		for _, thread in waiting[player] or {} do
			task.spawn(thread, nil)
		end
		waiting[player] = nil
		profiles[player] = nil
		canSave[player] = nil
		dirty[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(PlayerData.save, player)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				PlayerData.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">PlayerSetup</string><ProtectedString name="Source"><![CDATA[-- Class choice and character setup. Characters don't load until a player picks a class.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local ClassData = require(Shared:WaitForChild("ClassData"))
local Net = require(Shared:WaitForChild("Net"))
local Progression = require(Shared:WaitForChild("Progression"))
local Build = require(script.Parent:WaitForChild("Build"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local PlayerSetup = {}

local METAL = Color3.fromRGB(200, 205, 215)
local CHOOSE_COOLDOWN = 1.5 -- seconds between class changes (each one respawns the character)

local lastChoose: { [Player]: number } = {}

local function limb(character: Model, names: { string }): BasePart?
	for _, name in names do
		local part = character:WaitForChild(name, 3)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

-- Adds a simple weapon for the class. Parts are welded to the hands; offsets are a first guess
-- and will need tuning with real animations.
local function giveWeapon(character: Model, info: ClassData.ClassInfo)
	local old = character:FindFirstChild("ClassWeapon")
	if old then
		old:Destroy()
	end
	local holder = Instance.new("Model")
	holder.Name = "ClassWeapon"
	holder.Parent = character

	local right = limb(character, { "RightHand", "Right Arm" })
	local left = limb(character, { "LeftHand", "Left Arm" })
	if not right or not left then
		return
	end

	local function piece(hand: BasePart, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?)
		local part = Build.part({
			Name = "WeaponPart",
			Size = size,
			CFrame = hand.CFrame * offset,
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
			CanQuery = false,
			CastShadow = false,
			Parent = holder,
		})
		Build.weld(part, hand)
		return part
	end

	local weapon = info.weapon
	if weapon == "daggers" then
		for _, hand in { right, left } do
			piece(hand, Vector3.new(0.3, 0.3, 0.7), CFrame.new(0, -0.5, -0.2), Build.DARK_WOOD)
			piece(hand, Vector3.new(0.15, 0.4, 2), CFrame.new(0, -0.5, -1.5), METAL, Enum.Material.Metal)
		end
	elseif weapon == "sword_shield" then
		piece(right, Vector3.new(0.35, 0.35, 1), CFrame.new(0, -0.5, -0.3), Build.DARK_WOOD)
		piece(right, Vector3.new(1.4, 0.3, 0.3), CFrame.new(0, -0.5, -0.9), Color3.fromRGB(190, 160, 80), Enum.Material.Metal)
		piece(right, Vector3.new(0.25, 0.6, 4.2), CFrame.new(0, -0.5, -3.1), METAL, Enum.Material.Metal)
		piece(left, Vector3.new(0.4, 3.4, 2.8), CFrame.new(-0.5, -0.3, 0), info.color, Enum.Material.Metal)
		piece(left, Vector3.new(0.45, 1, 1), CFrame.new(-0.55, -0.3, 0), Color3.fromRGB(190, 160, 80), Enum.Material.Metal)
	elseif weapon == "staff" or weapon == "holy_staff" then
		piece(right, Vector3.new(0.35, 7, 0.35), CFrame.new(0, 1.2, -0.3), Build.WOOD, Enum.Material.Wood)
		local orb = piece(right, Vector3.new(1, 1, 1), CFrame.new(0, 5, -0.3), info.projectileColor, Enum.Material.Neon)
		orb.Shape = Enum.PartType.Ball
		local light = Instance.new("PointLight")
		light.Color = info.projectileColor
		light.Range = 8
		light.Brightness = 1.5
		light.Parent = orb
	elseif weapon == "bow" then
		local wood = Color3.fromRGB(120, 85, 50)
		piece(left, Vector3.new(0.3, 2.4, 0.3), CFrame.new(0, -0.4, -0.5), wood, Enum.Material.Wood)
		piece(left, Vector3.new(0.3, 1.8, 0.3), CFrame.new(0, 1.3, -0.1) * CFrame.Angles(math.rad(-25), 0, 0), wood, Enum.Material.Wood)
		piece(left, Vector3.new(0.3, 1.8, 0.3), CFrame.new(0, -2.1, -0.1) * CFrame.Angles(math.rad(25), 0, 0), wood, Enum.Material.Wood)
		piece(left, Vector3.new(0.05, 4.6, 0.05), CFrame.new(0, -0.4, 0.4), Color3.fromRGB(240, 235, 220))
	end
end

local function onCharacter(player: Player, character: Model)
	local info = ClassData.get(player:GetAttribute("Class")) or ClassData.classes.ninja
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local maxHealth = Progression.maxHealth(info.maxHealth, (player:GetAttribute("Level") :: number?) or 1)
	humanoid.MaxHealth = maxHealth
	humanoid.Health = maxHealth
	humanoid.WalkSpeed = info.walkSpeed
	character:SetAttribute("Class", info.id)
	character:SetAttribute("DamageReduction", info.damageReduction)
	character:SetAttribute("HitHeight", 3.5)
	-- Give the body a moment to settle at the spawn point so the weapon welds in the right place.
	task.delay(0.3, function()
		if character.Parent then
			giveWeapon(character, info)
		end
	end)

	humanoid.Died:Connect(function()
		task.delay(Config.RESPAWN_DELAY, function()
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	-- A level-up raises max health and heals fully.
	player:GetAttributeChangedSignal("Level"):Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local info = ClassData.get(player:GetAttribute("Class"))
		if humanoid and humanoid.Health > 0 and info then
			local maxHealth = Progression.maxHealth(info.maxHealth, (player:GetAttribute("Level") :: number?) or 1)
			humanoid.MaxHealth = maxHealth
			humanoid.Health = maxHealth
		end
	end)
end

function PlayerSetup.start()
	Players.CharacterAutoLoads = false

	Net.event("ChooseClass").OnServerEvent:Connect(function(player: Player, classId: any)
		local info = ClassData.get(classId)
		if not info then
			return
		end
		local now = os.clock()
		if now - (lastChoose[player] or -100) < CHOOSE_COOLDOWN then
			return
		end
		lastChoose[player] = now
		-- Spawn only once the save has loaded, so level and health are right from the start.
		if not PlayerData.whenLoaded(player) or not player.Parent then
			return
		end
		PlayerData.setClass(player, info.id)
		player:SetAttribute("Class", info.id)
		player:LoadCharacter()
	end)

	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		lastChoose[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return PlayerSetup
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[-- Quest progress per player (stored in PlayerData), objectives counted from game events, and
-- what each quest giver says at each stage. Quest definitions live in Shared/QuestData.
-- In co-op a kill counts for everyone who damaged the creature; each player has their own quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local QuestData = require(Shared:WaitForChild("QuestData"))
local Inventory = require(script.Parent:WaitForChild("Inventory"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local Quests = {}

local updateEvent = Net.event("QuestUpdate")
local toastEvent = Net.event("Toast")

-- Every quest with this player's status: "available", "active", "ready" or "done".
function Quests.snapshot(player: Player): { { [string]: any } }
	local data = PlayerData.get(player)
	local list = {}
	for _, id in QuestData.order do
		local quest = QuestData.quests[id]
		local state = data and data.quests[id]
		table.insert(list, {
			id = id,
			title = quest.title,
			summary = quest.summary,
			giver = quest.giver,
			giverName = QuestData.givers[quest.giver].name,
			status = if state then state.status else "available",
			progress = if state then state.progress else 0,
			count = quest.objective.count,
		})
	end
	return list
end

function Quests.send(player: Player)
	updateEvent:FireClient(player, Quests.snapshot(player))
end

-- What `giver` says to `player`, moving their quest on where the conversation allows:
-- offering the next quest, reminding them of the current one, or taking it in for the reward.
function Quests.talk(player: Player, giver: string): { string }
	local data = PlayerData.get(player)
	if not data then
		return { "One moment, traveller..." }
	end
	for _, id in QuestData.order do
		local quest = QuestData.quests[id]
		if quest.giver == giver then
			local state = data.quests[id]
			if not state then
				data.quests[id] = { status = "active", progress = 0 }
				PlayerData.markDirty(player)
				toastEvent:FireClient(player, `New quest: {quest.title}`)
				for itemId, count in quest.gift or {} do
					Inventory.add(player, itemId, count)
				end
				Quests.send(player)
				return quest.lines.offer
			elseif state.status == "active" then
				return quest.lines.active
			elseif state.status == "ready" then
				state.status = "done"
				PlayerData.markDirty(player)
				PlayerData.addXP(player, quest.rewardXp, `Quest complete: {quest.title}`)
				Quests.send(player)
				return quest.lines.ready
			end
		end
	end
	return QuestData.givers[giver].idle
end

-- Called for each player who helped defeat a creature.
function Quests.recordDefeat(player: Player, creatureId: string)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	for _, id in QuestData.order do
		local quest = QuestData.quests[id]
		local state = data.quests[id]
		local objective = quest.objective
		if state and state.status == "active" and objective.kind == "defeat" and objective.target == creatureId then
			state.progress = math.min(objective.count, state.progress + 1)
			if state.progress >= objective.count then
				state.status = "ready"
				toastEvent:FireClient(player, `Return to {QuestData.givers[quest.giver].name}`)
			end
			PlayerData.markDirty(player)
			Quests.send(player)
		end
	end
end

function Quests.start()
	PlayerData.onLoaded(Quests.send)
end

return Quests
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Skills</string><ProtectedString name="Source"><![CDATA[-- Class skills (Q and E) and mana. The server checks cooldowns and mana and does everything;
-- the client only asks (UseSkill) and draws the cooldown once SkillUsed comes back.
-- Mana lives here and is shown to clients through the Mana / MaxMana player attributes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ClassData = require(Shared:WaitForChild("ClassData"))
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Progression = require(Shared:WaitForChild("Progression"))
local SkillData = require(Shared:WaitForChild("SkillData"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Companions = require(script.Parent:WaitForChild("Companions"))
local Creature = require(script.Parent:WaitForChild("Creature"))
local Taming = require(script.Parent:WaitForChild("Taming"))

local Skills = {}

local REGEN_STEP = 0.25

local mana: { [Player]: number } = {}
local readyAt: { [Player]: { [number]: number } } = {}
type Regen = { character: Model, perSecond: number, untilTime: number }
local regens: { Regen } = {}

local toastEvent = Net.event("Toast")
local usedEvent = Net.event("SkillUsed")

local function level(player: Player): number
	return (player:GetAttribute("Level") :: number?) or 1
end

function Skills.maxMana(player: Player): number
	local info = ClassData.get(player:GetAttribute("Class"))
	return if info then Progression.maxMana(info.mana, level(player)) else 0
end

local function publish(player: Player)
	player:SetAttribute("MaxMana", Skills.maxMana(player))
	player:SetAttribute("Mana", math.floor(mana[player] or 0))
end

function Skills.refill(player: Player)
	mana[player] = Skills.maxMana(player)
	readyAt[player] = {}
	publish(player)
end

local function isFinite(v: Vector3): boolean
	local m = v.Magnitude
	return m == m and m < math.huge
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

type Context = {
	player: Player,
	character: Model,
	root: BasePart,
	humanoid: Humanoid,
	info: ClassData.ClassInfo,
	attack: number, -- the player's attack at their level
	aim: Vector3, -- flat unit direction
	locked: Model?,
}

-- Points from the player's chest at the locked target, or the best target near the aim line.
local function aimAt(ctx: Context, range: number): Vector3
	local target = ctx.locked or Combat.bestTarget(ctx.root.Position, ctx.aim, range, Config.AUTO_AIM_ANGLE)
	local targetRoot = target and Combat.rootOf(target)
	if targetRoot then
		return (targetRoot.Position - (ctx.root.Position + Vector3.new(0, 1.5, 0))).Unit
	end
	return ctx.aim
end

-- Everyone a heal reaches: player characters and companions within `radius`.
local function alliesNear(position: Vector3, radius: number): { Model }
	local list = Combat.playersNear(position, radius)
	for _, model in Companions.near(position, radius) do
		table.insert(list, model)
	end
	return list
end

local function healAllies(ctx: Context, radius: number, fraction: number)
	for _, character in alliesNear(ctx.root.Position, radius) do
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			Combat.heal(character, humanoid.MaxHealth * fraction)
		end
	end
end

-- Each handler does the skill and returns true, or returns false to cancel (no mana spent).
local handlers: { [string]: (Context, SkillData.Skill) -> boolean } = {}

handlers.vanish = function(ctx, skill)
	local character, humanoid = ctx.character, ctx.humanoid
	local baseSpeed = ctx.info.walkSpeed
	character:SetAttribute("Vanished", true)
	humanoid.WalkSpeed = baseSpeed * (1 + skill.speedBonus)
	Combat.burst(ctx.root.Position, 8, Color3.fromRGB(120, 110, 160))
	local connection: RBXScriptConnection
	connection = character:GetAttributeChangedSignal("Vanished"):Connect(function()
		if not character:GetAttribute("Vanished") then
			connection:Disconnect()
			humanoid.WalkSpeed = baseSpeed
		end
	end)
	task.delay(skill.duration, function()
		if character.Parent then
			character:SetAttribute("Vanished", nil)
		end
	end)
	return true
end

handlers.shuriken_fan = function(ctx, skill)
	local start = ctx.root.Position + Vector3.new(0, 1, 0) + ctx.aim * 2
	-- The middle star flies at the target (so the fan tilts down onto low creatures like wolves).
	local centre = aimAt(ctx, Config.AUTO_AIM_RANGE)
	local half = (skill.count - 1) / 2
	for i = 0, skill.count - 1 do
		local angle = math.rad((i - half) * skill.spread)
		local direction = CFrame.Angles(0, angle, 0):VectorToWorldSpace(centre)
		local amount, crit = Combat.rollDamage(ctx.attack * skill.multiplier)
		Combat.fireProjectile(ctx.player, start, direction * skill.speed, amount, crit, {
			color = Color3.fromRGB(215, 220, 230),
			size = 0.8,
		})
	end
	return true
end

handlers.taunt = function(ctx, skill)
	local character = ctx.character
	local count = Creature.taunt(character, ctx.root.Position, skill.radius, skill.duration)
	local base = ctx.info.damageReduction
	character:SetAttribute("DamageReduction", math.min(skill.maxReduction, base + skill.reduction))
	character:SetAttribute("Taunting", true)
	Combat.burst(ctx.root.Position, 20, Color3.fromRGB(230, 80, 60))
	task.delay(skill.duration, function()
		if character.Parent then
			character:SetAttribute("DamageReduction", base)
			character:SetAttribute("Taunting", nil)
		end
	end)
	if count == 0 then
		toastEvent:FireClient(ctx.player, "Nothing nearby to taunt")
	end
	return true
end

handlers.shield_slam = function(ctx, skill)
	for _, model in Combat.targetsNear(ctx.root.Position, skill.radius) do
		local amount, crit = Combat.rollDamage(ctx.attack * skill.multiplier)
		Combat.damage(model, amount, ctx.player, crit)
		local creature = Creature.find(model)
		local root = Combat.rootOf(model)
		if creature and root then
			creature:stun(skill.stun, Color3.fromRGB(255, 240, 200))
			creature:knockback(flat(root.Position - ctx.root.Position), skill.knockback)
		end
	end
	Combat.burst(ctx.root.Position, skill.radius, Color3.fromRGB(110, 160, 235))
	return true
end

handlers.fireball = function(ctx, skill)
	local direction = aimAt(ctx, Config.AUTO_AIM_RANGE)
	local start = ctx.root.Position + Vector3.new(0, 1.5, 0) + ctx.aim * 2
	local amount, crit = Combat.rollDamage(ctx.attack * skill.multiplier)
	Combat.fireProjectile(ctx.player, start, direction * skill.speed, amount, crit, {
		color = Color3.fromRGB(255, 120, 40),
		size = 2.6,
		explodeRadius = skill.radius,
	})
	return true
end

handlers.frost_nova = function(ctx, skill)
	for _, model in Combat.targetsNear(ctx.root.Position, skill.radius) do
		local amount, crit = Combat.rollDamage(ctx.attack * skill.multiplier)
		Combat.damage(model, amount, ctx.player, crit)
		local creature = Creature.find(model)
		if creature then
			creature:stun(skill.freeze, Color3.fromRGB(140, 210, 255))
		end
	end
	Combat.burst(ctx.root.Position, skill.radius, Color3.fromRGB(150, 220, 255))
	return true
end

handlers.healing_light = function(ctx, skill)
	local now = os.clock()
	for _, character in alliesNear(ctx.root.Position, skill.healRadius) do
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			Combat.heal(character, humanoid.MaxHealth * skill.heal)
			table.insert(regens, { character = character, perSecond = humanoid.MaxHealth * skill.regen, untilTime = now + skill.regenTime })
		end
	end
	Combat.burst(ctx.root.Position, 14, Color3.fromRGB(255, 225, 120))
	return true
end

handlers.holy_nova = function(ctx, skill)
	for _, model in Combat.targetsNear(ctx.root.Position, skill.radius) do
		local amount, crit = Combat.rollDamage(ctx.attack * skill.multiplier)
		if model:GetAttribute("Void") then
			amount *= skill.voidMultiplier
		end
		Combat.damage(model, amount, ctx.player, crit)
	end
	healAllies(ctx, skill.healRadius, skill.heal)
	Combat.burst(ctx.root.Position, skill.radius, Color3.fromRGB(255, 235, 150))
	return true
end

-- Beast Tamer. Taming.luau and Companions.luau do the work.
handlers.tame_beast = function(ctx, skill)
	return Taming.tameBeast(ctx.player, ctx.root.Position, skill)
end

handlers.call_of_the_wild = function(ctx, skill)
	return Companions.callOfTheWild(ctx.player, skill)
end

local function onUseSkill(player: Player, slot: any, aim: any, locked: any)
	if slot ~= 1 and slot ~= 2 then
		return
	end
	local character = player.Character
	if not character or not Combat.isAlive(character) then
		return
	end
	local info = ClassData.get(player:GetAttribute("Class"))
	local skill = info and SkillData.forClass(info.id, slot)
	local root = Combat.rootOf(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not info or not skill or not root or not humanoid then
		return
	end
	if skill.pending then
		toastEvent:FireClient(player, skill.pending)
		return
	end
	local now = os.clock()
	local ready = readyAt[player] or {}
	readyAt[player] = ready
	if now < (ready[slot] or 0) - 0.15 then
		return -- still cooling down (a little slack for network delay)
	end
	if (mana[player] or 0) < skill.mana then
		toastEvent:FireClient(player, "Not enough mana")
		return
	end

	local direction = if typeof(aim) == "Vector3" and isFinite(aim) then flat(aim) else Vector3.zero
	if direction.Magnitude < 0.01 then
		direction = flat(root.CFrame.LookVector)
	end
	local lockedModel: Model? = nil
	if typeof(locked) == "Instance" and locked:IsA("Model") and Combat.isAlive(locked) then
		local lockedRoot = Combat.rootOf(locked)
		if lockedRoot and (lockedRoot.Position - root.Position).Magnitude <= Config.LOCK_RANGE * 1.3 then
			lockedModel = locked
		end
	end
	local ctx: Context = {
		player = player,
		character = character,
		root = root,
		humanoid = humanoid,
		info = info,
		attack = Progression.attack(info.attack, level(player)),
		aim = direction.Unit,
		locked = lockedModel,
	}
	local handler = handlers[skill.id]
	if not handler or not handler(ctx, skill) then
		return
	end
	Combat.noteAction(player, "skill") -- sudden moves startle passive creatures
	mana[player] = (mana[player] or 0) - skill.mana
	ready[slot] = now + skill.cooldown
	publish(player)
	usedEvent:FireClient(player, slot, skill.cooldown)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function()
		Skills.refill(player)
	end)
	player:GetAttributeChangedSignal("Level"):Connect(function()
		Skills.refill(player) -- levelling up tops up mana, like health
	end)
end

function Skills.start()
	Net.event("UseSkill").OnServerEvent:Connect(onUseSkill)
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		mana[player] = nil
		readyAt[player] = nil
	end)

	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated < REGEN_STEP then
			return
		end
		local step = accumulated
		accumulated = 0
		for player, current in mana do
			local max = Skills.maxMana(player)
			if current < max and player.Character and Combat.isAlive(player.Character) then
				mana[player] = math.min(max, current + Progression.manaRegen(max) * step)
				publish(player)
			end
		end
		-- Healing Light's heal over time.
		local now = os.clock()
		for i = #regens, 1, -1 do
			local regen = regens[i]
			if now > regen.untilTime or not regen.character.Parent then
				table.remove(regens, i)
			else
				local humanoid = regen.character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + regen.perSecond * step)
				end
			end
		end
	end)
end

return Skills
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Taming</string><ProtectedString name="Source"><![CDATA[-- Taming. Two ways to gain a companion, both decided here on the server:
--
-- Feeding (any class): creatures with `tameFood` (the fox) get a Feed prompt. Each feed uses one
-- item and fills the trust meter by 1 / tameFeeds; the creature stands still while it eats.
-- The attempt fails if the tamer attacks, dashes, uses a skill, jumps or steps too far away, if
-- anyone startles or hurts the creature, or if it isn't fed again in time. Then it bolts, the
-- food already given is lost, and it stays wary for a while. Only one player can tame a
-- creature at a time, and whoever finishes the taming owns it.
-- A player carrying food a passive creature likes doesn't scare it, so they can walk up to it.
--
-- Tame Beast (the Beast Tamer's Q): works on `tamerOnly` creatures (wolves, boars) that are
-- below the skill's health threshold. Chance = baseChance + missingBonus x missing health.
--
-- Either way the wild creature leaves through Creature.remove (no XP, loot or quest credit)
-- and Companions.add puts a companion where it stood.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CompanionData = require(Shared:WaitForChild("CompanionData"))
local ItemData = require(Shared:WaitForChild("ItemData"))
local Net = require(Shared:WaitForChild("Net"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Companions = require(script.Parent:WaitForChild("Companions"))
local Creature = require(script.Parent:WaitForChild("Creature"))
local Interactables = require(script.Parent:WaitForChild("Interactables"))
local Inventory = require(script.Parent:WaitForChild("Inventory"))

local Taming = {}

local TAMED_COLOR = Color3.fromRGB(255, 214, 110)
local FAILED_COLOR = Color3.fromRGB(190, 190, 200)

type Session = {
	player: Player,
	creature: any, -- a Creature
	feeds: number,
	origin: Vector3, -- where the tamer stood at the first feed
	lastFeed: number,
}

local sessions: { [any]: Session } = {} -- by creature
local byPlayer: { [Player]: Session } = {}
local waryUntil: { [any]: number } = setmetatable({}, { __mode = "k" }) :: any -- by creature

local tamingEvent = Net.event("Taming")
local toastEvent = Net.event("Toast")

local function lower(name: string): string
	return string.lower(name)
end

local function clear(session: Session)
	if sessions[session.creature] == session then
		sessions[session.creature] = nil
	end
	if byPlayer[session.player] == session then
		byPlayer[session.player] = nil
	end
end

-- Ends an attempt: the creature bolts from `from` (or the tamer) and won't eat for a while.
local function fail(session: Session, reason: string, from: Vector3?)
	clear(session)
	local creature = session.creature
	waryUntil[creature] = os.clock() + CompanionData.WARY_TIME
	if session.player.Parent then
		tamingEvent:FireClient(session.player, creature.model, 0, "failed", reason)
	end
	if creature.state ~= "Dead" then
		Combat.spark(creature.root.Position + Vector3.new(0, 2, 0), FAILED_COLOR)
	end
	if creature.state == "Held" then
		local character = session.player.Character
		local root = character and Combat.rootOf(character)
		creature:flee(from or (if root then root.Position else session.origin), 4)
	end
end

local function succeed(session: Session)
	clear(session)
	local creature = session.creature
	local data = creature.data
	local position = creature.root.Position
	local _, yaw = creature.root.CFrame:ToOrientation()
	creature:remove("tamed")
	Companions.add(session.player, data, position, yaw)
	tamingEvent:FireClient(session.player, nil, 1, "tamed", data.name)
	Combat.burst(position, 8, TAMED_COLOR)
end

-- The Feed prompt on a creature was used by `player`.
local function feed(creature: any, player: Player)
	local data = creature.data
	local item = ItemData.items[data.tameFood]
	local character = player.Character
	local root = character and Combat.rootOf(character)
	if not item or not character or not root or not Combat.isAlive(character) or creature.state == "Dead" then
		return
	end
	if (root.Position - creature.root.Position).Magnitude > CompanionData.FEED_RANGE + 6 then
		return -- further than the prompt reaches
	end
	local now = os.clock()
	local name = lower(data.name)
	local session = sessions[creature]
	if session and session.player ~= player then
		toastEvent:FireClient(player, `Someone else is taming this {name}`)
		return
	end
	if not session then
		if (waryUntil[creature] or 0) > now then
			toastEvent:FireClient(player, `The {name} is too wary to eat right now`)
			return
		end
		local ok, reason = Companions.canTame(player, data)
		if not ok then
			toastEvent:FireClient(player, reason or "You can't tame that")
			return
		end
	elseif now - session.lastFeed < CompanionData.FEED_GAP then
		toastEvent:FireClient(player, `The {name} is still eating`)
		return
	end
	if not Inventory.remove(player, item.id, 1) then
		toastEvent:FireClient(player, `You need {item.name} to feed a {name}. Wolves and boars drop it`)
		return
	end
	if not session then
		local other = byPlayer[player]
		if other then
			fail(other, "You turned to another creature")
		end
		local new: Session = { player = player, creature = creature, feeds = 0, origin = root.Position, lastFeed = now }
		sessions[creature] = new
		byPlayer[player] = new
		creature:hold(character)
		session = new
	end
	session.feeds += 1
	session.lastFeed = now
	Combat.spark(creature.root.Position + Vector3.new(0, 2, 0), item.color)
	local needed = data.tameFeeds or 1
	if session.feeds >= needed then
		succeed(session)
	else
		tamingEvent:FireClient(player, creature.model, session.feeds / needed, "progress", needed - session.feeds)
	end
end

-- The calm checks, every frame for the few attempts in progress.
local function watch()
	local now = os.clock()
	for creature, session in sessions do
		local player = session.player
		local character = player.Character
		local root = character and Combat.rootOf(character)
		local name = lower(creature.data.name)
		if creature.state == "Dead" then
			clear(session)
			if player.Parent then
				tamingEvent:FireClient(player, nil, 0, "failed", `The {name} is gone`)
			end
		elseif not player.Parent or not character or not root or not Combat.isAlive(character) then
			fail(session, "", session.origin)
		elseif creature.state ~= "Held" then
			fail(session, `Something startled the {name}`)
		elseif (root.Position - session.origin).Magnitude > CompanionData.CALM_RADIUS then
			fail(session, `You moved too far and the {name} bolted`)
		elseif root.AssemblyLinearVelocity.Y > CompanionData.JUMP_SPEED then
			fail(session, `You jumped and startled the {name}`)
		elseif now - session.lastFeed > CompanionData.FEED_TIMEOUT then
			fail(session, `The {name} lost interest`)
		end
	end
end

-- The Beast Tamer's Tame Beast, cast from `origin`. Returns true if the skill was used (mana
-- is spent whether or not the beast gives in), false if there was nothing to use it on.
function Taming.tameBeast(player: Player, origin: Vector3, skill: { [string]: any }): boolean
	local function weakened(creature: any): boolean
		return creature.data.tamerOnly == true and creature.humanoid.Health < creature.humanoid.MaxHealth * skill.threshold
	end
	local creature = Creature.nearest(origin, skill.range, weakened)
	if not creature then
		local healthy = Creature.nearest(origin, skill.range, function(other: any): boolean
			return other.data.tamerOnly == true
		end)
		toastEvent:FireClient(player, if healthy
			then `Weaken the {lower(healthy.data.name)} below half health first`
			else "No beast in range. Tame Beast works on weakened wolves and boars")
		return false
	end
	local data = creature.data
	local ok, reason = Companions.canTame(player, data)
	if not ok then
		toastEvent:FireClient(player, reason or "You can't tame that")
		return false
	end
	local missing = 1 - creature.humanoid.Health / creature.humanoid.MaxHealth
	local chance = math.clamp(skill.baseChance + skill.missingBonus * missing, 0, 1)
	local position = creature.root.Position
	if math.random() < chance then
		local _, yaw = creature.root.CFrame:ToOrientation()
		creature:remove("tamed")
		Companions.add(player, data, position, yaw)
		tamingEvent:FireClient(player, nil, 1, "tamed", data.name)
		Combat.burst(position, 10, TAMED_COLOR)
	else
		toastEvent:FireClient(player, `The {lower(data.name)} resists! ({math.floor(chance * 100 + 0.5)}% chance)`)
		Combat.spark(position + Vector3.new(0, 3, 0), FAILED_COLOR)
	end
	return true
end

local started = false
function Taming.start()
	if started then
		return
	end
	started = true

	-- Every creature that can be fed gets a Feed prompt as it spawns.
	Creature.onSpawned(function(creature: any)
		local data = creature.data
		local item = data.tameFood and ItemData.items[data.tameFood]
		if item then
			Interactables.prompt(creature.root, `Feed {item.name}`, data.name, function(player: Player)
				feed(creature, player)
			end, CompanionData.FEED_RANGE)
		end
	end)

	-- A player carrying food a passive creature likes doesn't scare it.
	Creature.setCalmCheck(function(creature: any, player: Player): boolean
		local food = creature.data.tameFood
		return food ~= nil and Inventory.count(player, food) > 0
	end)

	-- Sudden moves (attacks, dashes, skills) end any attempt nearby and scatter passive creatures.
	Combat.onAction(function(player: Player, _kind: string, position: Vector3)
		for creature, session in sessions do
			if creature.state ~= "Dead" and (creature.root.Position - position).Magnitude <= CompanionData.STARTLE_RADIUS then
				local name = lower(creature.data.name)
				fail(session, if session.player == player then `You startled the {name}` else `Something startled the {name}`, position)
			end
		end
		Creature.startle(position, CompanionData.STARTLE_RADIUS)
	end)

	-- Hurting a creature that is being fed ends the attempt.
	Combat.onDamage(function(model: Model)
		local creature = Creature.find(model)
		local session = creature and sessions[creature]
		if session then
			fail(session, `Something hurt the {lower(creature.data.name)}`)
		end
	end)

	RunService.Heartbeat:Connect(watch)
	Players.PlayerRemoving:Connect(function(player)
		local session = byPlayer[player]
		if session then
			fail(session, "", session.origin)
		end
	end)
end

return Taming
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000002B"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">45</float><bool name="EnableMouseLockOption">true</bool></Properties><Item class="StarterPlayerScripts" referent="RBX0000002A"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000029"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">ClassSelect</string><ProtectedString name="Source"><![CDATA[-- The class choice screen shown on joining (and from the "Change class" button).

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ClassData = require(Shared:WaitForChild("ClassData"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))

local ClassSelect = {}

local player = Players.LocalPlayer
local gui: ScreenGui? = nil
local selected = "ninja"
local orbit: RBXScriptConnection? = nil
local gamepadWatch: RBXScriptConnection? = nil

-- Called with true when the screen opens and false when it closes (Main hides the HUD).
ClassSelect.onToggle = nil :: ((open: boolean) -> ())?

local function isGamepad(inputType: Enum.UserInputType): boolean
	return inputType.Name:sub(1, 7) == "Gamepad"
end

local function statsText(info: ClassData.ClassInfo): string
	local style = if info.style == "Melee" then "Melee" else "Ranged"
	return string.format(
		"Health %d   ·   Damage %d   ·   Damage taken −%d%%   ·   Speed %d   ·   %s   ·   Companions %d",
		info.maxHealth,
		info.attack,
		math.floor(info.damageReduction * 100 + 0.5),
		info.walkSpeed,
		style,
		info.maxCompanions
	)
end

-- Slowly circles the camera over the village behind the menu.
local function startOrbit()
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	local angle = 0
	orbit = RunService.RenderStepped:Connect(function(dt)
		angle += dt * 0.05
		local position = Vector3.new(math.cos(angle) * 150, 70, math.sin(angle) * 150)
		camera.CFrame = CFrame.lookAt(position, Vector3.new(0, 5, 0))
	end)
end

local function stopOrbit()
	if orbit then
		orbit:Disconnect()
		orbit = nil
	end
end

function ClassSelect.isOpen(): boolean
	return gui ~= nil
end

function ClassSelect.close()
	stopOrbit()
	if gamepadWatch then
		gamepadWatch:Disconnect()
		gamepadWatch = nil
	end
	if gui then
		local selectedObject = GuiService.SelectedObject
		if selectedObject and selectedObject:IsDescendantOf(gui) then
			GuiService.SelectedObject = nil
		end
		gui:Destroy()
		gui = nil
		if ClassSelect.onToggle then
			ClassSelect.onToggle(false)
		end
	end
end

-- `onChosen` runs after the class is sent to the server.
function ClassSelect.open(onChosen: (() -> ())?)
	if gui then
		return
	end
	-- Returning players start on the class they last played (saved by the server).
	selected = (player:GetAttribute("Class") :: string?) or (player:GetAttribute("SavedClass") :: string?) or "ninja"
	if not ClassData.classes[selected] then
		selected = "ninja"
	end
	local function beginText(): string
		if player.Character then
			return "Switch class"
		end
		return if player:GetAttribute("SavedClass") then "Continue journey" else "Begin journey"
	end
	if not player.Character then
		startOrbit()
	end

	local screen = UI.make("ScreenGui", {
		Name = "ClassSelect",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	gui = screen

	local shade = UI.make("Frame", {
		BackgroundColor3 = Color3.fromRGB(12, 10, 22),
		BackgroundTransparency = if player.Character then 0.25 else 0.35,
		Size = UDim2.fromScale(1, 1),
		Parent = screen,
	})

	local column = UI.make("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0, 470),
		Parent = shade,
	}, {
		UI.make("UISizeConstraint", { MaxSize = Vector2.new(980, 470) }),
		UI.make("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local title = UI.label("MYTHBOUND", 64, UI.GOLD, true)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.Size = UDim2.new(1, 0, 0, 72)
	title.LayoutOrder = 1
	title.Parent = column

	local subtitle = UI.label("Choose your class · Choose your path · Tame the myths", 20, UI.MUTED)
	subtitle.TextXAlignment = Enum.TextXAlignment.Center
	subtitle.LayoutOrder = 2
	subtitle.Parent = column

	local row = UI.make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 74),
		LayoutOrder = 3,
		Parent = column,
	}, {
		UI.make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
		}),
	})

	local details = UI.panel({ Size = UDim2.new(1, 0, 0, 96), LayoutOrder = 4, Parent = column })
	UI.padding(14).Parent = details
	local description = UI.label("", 18)
	description.TextWrapped = true
	description.Size = UDim2.new(1, 0, 0, 46)
	description.TextYAlignment = Enum.TextYAlignment.Top
	description.Parent = details
	local stats = UI.label("", 15, UI.MUTED)
	stats.Position = UDim2.fromOffset(0, 50)
	stats.Parent = details

	local buttons: { [string]: TextButton } = {}
	local function refresh()
		local info = ClassData.classes[selected]
		description.Text = info.description
		stats.Text = statsText(info)
		for id, button in buttons do
			local chosen = id == selected
			button.BackgroundColor3 = if chosen then Color3.fromRGB(150, 110, 45) else Color3.fromRGB(44, 36, 58)
		end
	end

	for index, id in ClassData.order do
		local info = ClassData.classes[id]
		local button = UI.button(`{info.name}\n{info.tagline}`, {
			Size = UDim2.new(0.19, -8, 1, 0),
			TextSize = 17,
			LayoutOrder = index,
			Parent = row,
		})
		button.Activated:Connect(function()
			selected = id
			refresh()
		end)
		buttons[id] = button
	end

	local begin = UI.button(beginText(), {
		Size = UDim2.fromOffset(260, 52),
		TextSize = 22,
		BackgroundColor3 = Color3.fromRGB(60, 44, 80),
		LayoutOrder = 5,
		Parent = column,
	})
	local hint = UI.label("Click a class, then begin. Controller: D-pad to choose, A to confirm.", 14, UI.MUTED)
	hint.TextXAlignment = Enum.TextXAlignment.Center
	hint.LayoutOrder = 6
	hint.Parent = column

	if player.Character then
		local cancel = UI.button("Back to the game", {
			Size = UDim2.fromOffset(200, 40),
			TextSize = 16,
			LayoutOrder = 7,
			Parent = column,
		})
		cancel.Activated:Connect(function()
			ClassSelect.close()
		end)
	end

	-- Wait until the server has built the world before letting anyone in.
	if not workspace:GetAttribute("WorldReady") then
		begin.Text = "Building Hearthmoor…"
		begin.Active = false
		task.spawn(function()
			while not workspace:GetAttribute("WorldReady") do
				workspace:GetAttributeChangedSignal("WorldReady"):Wait()
			end
			begin.Text = beginText()
			begin.Active = true
		end)
	end

	begin.Activated:Connect(function()
		if not workspace:GetAttribute("WorldReady") then
			return
		end
		Net.event("ChooseClass"):FireServer(selected)
		ClassSelect.close()
		if onChosen then
			onChosen()
		end
	end)

	refresh()
	-- The save may finish loading while this screen is already open.
	local savedWatch = player:GetAttributeChangedSignal("SavedClass"):Connect(function()
		local saved = player:GetAttribute("SavedClass") :: string?
		if not player.Character and saved and ClassData.classes[saved] then
			selected = saved
			refresh()
			if begin.Active then
				begin.Text = beginText()
			end
		end
	end)
	screen.Destroying:Connect(function()
		savedWatch:Disconnect()
	end)
	screen.Parent = player:WaitForChild("PlayerGui")
	if ClassSelect.onToggle then
		ClassSelect.onToggle(true)
	end

	-- Controllers can't point and click: put the selection on the chosen class so the D-pad
	-- moves between buttons and A presses them. Also when a controller is picked up later.
	local function focusForGamepad()
		if gui and not GuiService.SelectedObject then
			GuiService.SelectedObject = buttons[selected]
		end
	end
	if UserInputService.GamepadEnabled and isGamepad(UserInputService:GetLastInputType()) then
		focusForGamepad()
	end
	gamepadWatch = UserInputService.LastInputTypeChanged:Connect(function(inputType)
		if isGamepad(inputType) then
			focusForGamepad()
		end
	end)
end

return ClassSelect
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">CompanionPanel</string><ProtectedString name="Source"><![CDATA[-- The companion panel (P, controller D-pad left, a Pets button on phones): every companion you
-- own, which ones are out, and buttons to bring one out, send it home or release it.
-- The list comes from the server (Companions event); the buttons only send requests
-- (CompanionSetActive, CompanionRelease). Works with mouse, controller and touch.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CreatureData = require(Shared:WaitForChild("CreatureData"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))

local CompanionPanel = {}

export type Row = { uid: number, id: string, name: string, active: boolean, allowed: boolean, knockedOut: number }

local setActiveEvent = Net.event("CompanionSetActive")
local releaseEvent = Net.event("CompanionRelease")

local ROW_HEIGHT = 46
local RELEASE_RED = Color3.fromRGB(150, 50, 45)

local gui: ScreenGui
local panel: Frame
local header: TextLabel
local list: Frame
local empty: TextLabel
local roster: { Row } = {}
local limit = 1
local stableSize = 6
local receivedAt = 0 -- when the list arrived, to count knock-out timers down
local confirmUid: number? = nil -- Release was pressed once for this one; the next press confirms
local statusLabels: { [number]: TextLabel } = {}
local canOpen: () -> boolean = function()
	return true
end

-- Called when the panel opens, so other panels can close.
CompanionPanel.onOpen = nil :: (() -> ())?

function CompanionPanel.isOpen(): boolean
	return gui ~= nil and panel.Visible
end

local function usingGamepad(): boolean
	return UserInputService:GetLastInputType().Name:sub(1, 7) == "Gamepad"
end

local function statusText(row: Row): string
	local left = math.ceil(row.knockedOut - (os.clock() - receivedAt))
	if row.knockedOut > 0 and left > 0 then
		return if row.active then `Knocked out · {left} s` else `Recovering · {left} s`
	elseif row.active then
		return "Out with you"
	elseif not row.allowed then
		return "Needs a Beast Tamer"
	end
	return "At home"
end

local function addRow(row: Row, order: number): GuiObject
	local creature = CreatureData.creatures[row.id]
	local frame = UI.make("Frame", {
		Name = `Companion{row.uid}`,
		BackgroundColor3 = Color3.fromRGB(36, 30, 48),
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		LayoutOrder = order,
		Parent = list,
	}, { UI.corner(8) })
	UI.make("Frame", {
		BackgroundColor3 = if creature then creature.color else UI.MUTED,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		Parent = frame,
	}, { UI.corner(12) })
	local name = UI.label(row.name, 15, UI.INK, true)
	name.Position = UDim2.fromOffset(42, 4)
	name.Size = UDim2.new(1, -250, 0, 20)
	name.Parent = frame
	local status = UI.label(statusText(row), 12, if row.active then UI.GOLD else UI.MUTED)
	status.Position = UDim2.fromOffset(42, 23)
	status.Size = UDim2.new(1, -250, 0, 18)
	status.Parent = frame
	statusLabels[row.uid] = status

	local toggle = UI.button(if row.active then "Send home" else "Bring out", {
		Name = "Toggle",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -96, 0.5, 0),
		Size = UDim2.fromOffset(104, 32),
		TextSize = 14,
		-- Green when it can come out; plain for Send home, or when this class can't bring it out.
		BackgroundColor3 = if row.active or not row.allowed then Color3.fromRGB(44, 36, 58) else Color3.fromRGB(70, 110, 60),
		Parent = frame,
	})
	toggle.Activated:Connect(function()
		confirmUid = nil
		setActiveEvent:FireServer(row.uid, not row.active) -- the server explains if it can't
	end)
	local confirming = confirmUid == row.uid
	local release = UI.button(if confirming then "Sure?" else "Release", {
		Name = "Release",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(80, 32),
		TextSize = 14,
		BackgroundColor3 = if confirming then RELEASE_RED else Color3.fromRGB(44, 36, 58),
		Parent = frame,
	})
	release.Activated:Connect(function()
		if confirmUid == row.uid then
			confirmUid = nil
			releaseEvent:FireServer(row.uid)
		else
			confirmUid = row.uid -- ask once more: releasing can't be undone
			release.Text = "Sure?"
			release.BackgroundColor3 = RELEASE_RED
		end
	end)
	return toggle
end

function CompanionPanel.refresh()
	if not gui then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	table.clear(statusLabels)
	local outCount = 0
	local first: GuiObject? = nil
	for order, row in roster do
		if row.active then
			outCount += 1
		end
		local button = addRow(row, order)
		first = first or button
	end
	header.Text = `Companions · {outCount} / {limit} out · {#roster} / {stableSize} owned`
	empty.Visible = #roster == 0
	-- Keep controller selection inside the panel after rebuilding it.
	if panel.Visible and usingGamepad() then
		local selected = GuiService.SelectedObject
		if not selected or not selected:IsDescendantOf(gui) then
			GuiService.SelectedObject = first
		end
	end
end

-- The server's list: every companion the player owns, how many can be out, and how many can be owned.
function CompanionPanel.setRoster(rows: { Row }, newLimit: number, newStableSize: number)
	roster = rows
	limit = newLimit
	stableSize = newStableSize
	receivedAt = os.clock()
	if confirmUid then
		local still = false
		for _, row in rows do
			if row.uid == confirmUid then
				still = true
			end
		end
		if not still then
			confirmUid = nil
		end
	end
	CompanionPanel.refresh()
end

function CompanionPanel.close()
	if not gui then
		return
	end
	panel.Visible = false
	confirmUid = nil
	local selected = GuiService.SelectedObject
	if selected and selected:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
end

function CompanionPanel.toggle()
	if panel.Visible then
		CompanionPanel.close()
	elseif canOpen() then
		if CompanionPanel.onOpen then
			CompanionPanel.onOpen()
		end
		panel.Visible = true
		CompanionPanel.refresh()
		-- Knock-out timers count down while the panel is open.
		task.spawn(function()
			while panel.Visible do
				task.wait(1)
				for _, row in roster do
					local label = statusLabels[row.uid]
					if label and label.Parent then
						label.Text = statusText(row)
					end
				end
			end
		end)
	end
end

-- `allowed` says whether the panel may open now (not during dialogue or class select).
function CompanionPanel.init(parent: Instance, allowed: () -> boolean)
	canOpen = allowed
	gui = UI.make("ScreenGui", {
		Name = "Companions",
		ResetOnSpawn = false,
		DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	panel = UI.panel({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 380),
		Visible = false,
		Parent = gui,
	})
	UI.padding(14).Parent = panel
	header = UI.label("Companions", 18, UI.GOLD, true)
	header.Size = UDim2.new(1, -90, 0, 24)
	header.Parent = panel
	local closeButton = UI.button("Close", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -2),
		Size = UDim2.fromOffset(80, 28),
		TextSize = 14,
		Parent = panel,
	})
	closeButton.Activated:Connect(CompanionPanel.close)
	list = UI.make("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -36),
		Parent = panel,
	}, {
		UI.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	empty = UI.label("No companions yet. Carry Meat to a fox in the south meadow and feed it (F) to earn its trust. Beast Tamers can also weaken a wolf or boar and use Tame Beast.", 14, UI.MUTED)
	empty.TextWrapped = true
	empty.TextYAlignment = Enum.TextYAlignment.Top
	empty.Position = UDim2.fromOffset(0, 40)
	empty.Size = UDim2.new(1, 0, 0, 80)
	empty.Parent = panel

	ContextActionService:BindAction("MythboundCompanions", function(_, state)
		if state == Enum.UserInputState.Begin then
			CompanionPanel.toggle()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.P, Enum.KeyCode.DPadLeft)
	pcall(function()
		ContextActionService:SetTitle("MythboundCompanions", "Pets")
		ContextActionService:SetPosition("MythboundCompanions", UDim2.new(1, -300, 1, -230))
	end)

	CompanionPanel.refresh()
	gui.Parent = parent
end

return CompanionPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Player input: attack, dash, lock-on, first person, mouse-look and the controls panel.
--
-- Mouse-look (X) locks the mouse to the middle of the screen so moving it turns the camera,
-- like Roblox's Shift Lock but without needing it switched on in Roblox's settings. It is for
-- trackpads and anyone who doesn't want to hold the right button. It pauses by itself while a
-- menu or dialogue is open, so the pointer is free to click.
-- Uses ContextActionService so keyboard, controller and touch all work; on phones the
-- `true` argument adds an on-screen button for that action.

local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local ClassData = require(Shared:WaitForChild("ClassData"))
local Net = require(Shared:WaitForChild("Net"))
local HUD = require(script.Parent:WaitForChild("HUD"))

local Controls = {}

local player = Players.LocalPlayer
local attackEvent = Net.event("Attack")
local dashEvent = Net.event("Dash")
local skillEvent = Net.event("UseSkill")

local attackHeld = false
local attackInput: InputObject? = nil
local attackCooldown = 0
local dashCooldown = 0
local skillCooldown = { 0, 0 } -- seconds left, per slot (Q, E); set when the server confirms
local skillDuration = { 1, 1 }
local lockTarget: Model? = nil
local recentTarget: Model? = nil
local recentTargetTime = 0
local lockMarker: BillboardGui? = nil
local firstPerson = false
local mouseLook = false
local lockingMouse = false -- true while mouse-look is holding the pointer in the middle

local function character(): (Model?, Humanoid?, BasePart?)
	local c = player.Character
	if not c then
		return nil, nil, nil
	end
	local humanoid = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return c, humanoid, root
end

local function alive(model: Model?): boolean
	if not model or not model.Parent then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function rootOf(model: Model): BasePart?
	return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Lock-on --------------------------------------------------------------------------------

local function setLock(model: Model?)
	if lockMarker then
		lockMarker:Destroy()
		lockMarker = nil
	end
	lockTarget = model
	if model then
		local root = rootOf(model)
		if root then
			local marker = Instance.new("BillboardGui")
			marker.Name = "LockOnMarker"
			marker.Size = UDim2.fromOffset(36, 36)
			marker.StudsOffset = Vector3.new(0, ((model:GetAttribute("HitHeight") :: number?) or 4) + 1.5, 0)
			marker.AlwaysOnTop = true
			marker.Adornee = root
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.fromScale(1, 1)
			label.Text = "◎"
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(255, 220, 120)
			label.TextStrokeTransparency = 0.3
			label.Parent = marker
			marker.Parent = player:WaitForChild("PlayerGui")
			lockMarker = marker
		end
	end
end

local function findLockTarget(): Model?
	local _, _, root = character()
	if not root then
		return nil
	end
	local camera = workspace.CurrentCamera
	local look = flat(camera.CFrame.LookVector)
	look = if look.Magnitude > 0.01 then look.Unit else flat(root.CFrame.LookVector).Unit
	local best: Model? = nil
	local bestScore = math.huge
	for _, inst in CollectionService:GetTagged(Config.TAG_DAMAGEABLE) do
		if inst:IsA("Model") and alive(inst) then
			local targetRoot = rootOf(inst)
			if targetRoot then
				local to = flat(targetRoot.Position - root.Position)
				local distance = to.Magnitude
				if distance <= Config.LOCK_RANGE and distance > 0.1 then
					local angle = math.acos(math.clamp(to.Unit:Dot(look), -1, 1))
					if angle < math.rad(70) or distance < 25 then
						local score = distance + angle * 40 - (if inst:GetAttribute("Hostile") then 20 else 0)
						if score < bestScore then
							best = inst
							bestScore = score
						end
					end
				end
			end
		end
	end
	return best
end

-- Actions ----------------------------------------------------------------------------------

local function attack()
	local _, _, root = character()
	local info = ClassData.get(player:GetAttribute("Class"))
	if not root or not info then
		return
	end
	attackCooldown = info.interval
	local aim = workspace.CurrentCamera.CFrame.LookVector
	if lockTarget and alive(lockTarget) then
		local targetRoot = rootOf(lockTarget)
		if targetRoot then
			aim = targetRoot.Position - root.Position
		end
	end
	-- Turn to face the attack.
	local facing = flat(aim)
	if facing.Magnitude > 0.01 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + facing)
	end
	attackEvent:FireServer(aim, lockTarget)
end

-- Asks the server to use skill `slot` (1 = Q, 2 = E), aimed like a basic attack.
local function useSkill(slot: number)
	local _, _, root = character()
	if not root or skillCooldown[slot] > 0 then
		return
	end
	local aim = workspace.CurrentCamera.CFrame.LookVector
	if lockTarget and alive(lockTarget) then
		local targetRoot = rootOf(lockTarget)
		if targetRoot then
			aim = targetRoot.Position - root.Position
		end
	end
	local facing = flat(aim)
	if facing.Magnitude > 0.01 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + facing)
	end
	skillEvent:FireServer(slot, aim, lockTarget)
end

local function dash()
	local _, humanoid, root = character()
	if not humanoid or not root or dashCooldown > 0 then
		return
	end
	dashCooldown = Config.DASH_COOLDOWN
	local direction = flat(humanoid.MoveDirection)
	if direction.Magnitude < 0.1 then
		direction = flat(root.CFrame.LookVector)
	end
	direction = direction.Unit

	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root
	local push = Instance.new("LinearVelocity")
	push.Name = "Dash"
	push.Attachment0 = attachment
	push.RelativeTo = Enum.ActuatorRelativeTo.World
	push.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	push.PrimaryTangentAxis = Vector3.xAxis
	push.SecondaryTangentAxis = Vector3.zAxis
	push.PlaneVelocity = Vector2.new(direction.X, direction.Z) * Config.DASH_SPEED
	push.MaxForce = 1e6
	push.Parent = root
	Debris:AddItem(push, Config.DASH_TIME)
	Debris:AddItem(attachment, Config.DASH_TIME)
	dashEvent:FireServer()
end

local function setMouseLook(on: boolean)
	mouseLook = on
	HUD.setCrosshair(firstPerson or mouseLook)
	HUD.toast(if on then "Mouse-look on (X to turn off)" else "Mouse-look off")
end

local function setFirstPerson(on: boolean)
	firstPerson = on
	if on then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
		-- Push the camera back out to a normal third-person distance.
		player.CameraMinZoomDistance = 12
		task.delay(0.1, function()
			player.CameraMinZoomDistance = 0.5
		end)
	end
	HUD.setCrosshair(firstPerson or mouseLook)
end

-- Called by Main when the server reports damage, so the target frame can follow your last hit.
function Controls.noteHit(model: Model)
	recentTarget = model
	recentTargetTime = os.clock()
end

function Controls.reset()
	attackHeld = false
	setLock(nil)
	skillCooldown[1], skillCooldown[2] = 0, 0
end

-- Called when the server says a skill went off, to start its cooldown on the HUD.
function Controls.onSkillUsed(slot: number, cooldown: number)
	if slot == 1 or slot == 2 then
		skillCooldown[slot] = cooldown
		skillDuration[slot] = math.max(cooldown, 0.01)
	end
end

local function stillHeld(input: InputObject): boolean
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseButton1 then
		return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	elseif kind == Enum.UserInputType.Keyboard then
		return UserInputService:IsKeyDown(input.KeyCode)
	elseif kind.Name:sub(1, 7) == "Gamepad" then
		return UserInputService:IsGamepadButtonDown(kind, input.KeyCode)
	end
	return true -- touch buttons report their own release
end

-- Labels and places the on-screen button that phones get for an action (does nothing on PC).
local function touchButton(action: string, title: string, position: UDim2)
	pcall(function()
		ContextActionService:SetTitle(action, title)
		ContextActionService:SetPosition(action, position)
	end)
end

function Controls.start(isBlocked: () -> boolean)
	ContextActionService:BindAction("MythboundAttack", function(_, state, input)
		attackHeld = state == Enum.UserInputState.Begin
		attackInput = if attackHeld then input else nil
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.J, Enum.KeyCode.ButtonR2)
	touchButton("MythboundAttack", "Attack", UDim2.new(1, -150, 1, -150))

	ContextActionService:BindAction("MythboundDash", function(_, state)
		if state == Enum.UserInputState.Begin and not isBlocked() then
			dash()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
	touchButton("MythboundDash", "Dash", UDim2.new(1, -220, 1, -90))

	ContextActionService:BindAction("MythboundLockOn", function(_, state)
		if state == Enum.UserInputState.Begin and not isBlocked() then
			if lockTarget then
				setLock(nil)
			else
				setLock(findLockTarget())
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.T, Enum.KeyCode.ButtonR3, Enum.UserInputType.MouseButton3)
	touchButton("MythboundLockOn", "Lock", UDim2.new(1, -220, 1, -170))

	for slot, binding in { { Enum.KeyCode.Q, Enum.KeyCode.ButtonL1 }, { Enum.KeyCode.E, Enum.KeyCode.ButtonR1 } } do
		local action = `MythboundSkill{slot}`
		ContextActionService:BindAction(action, function(_, state)
			if state == Enum.UserInputState.Begin and not isBlocked() then
				useSkill(slot)
			end
			return Enum.ContextActionResult.Pass
		end, true, binding[1], binding[2])
		touchButton(action, if slot == 1 then "Q" else "E", UDim2.new(1, -90 - slot * 70, 1, -230))
	end

	ContextActionService:BindAction("MythboundView", function(_, state)
		if state == Enum.UserInputState.Begin and not isBlocked() then
			setFirstPerson(not firstPerson)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.ButtonL3)

	ContextActionService:BindAction("MythboundMouseLook", function(_, state)
		if state == Enum.UserInputState.Begin and not isBlocked() then
			setMouseLook(not mouseLook)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.X)

	-- Runs just after Roblox's camera each frame, so this has the last word on the mouse.
	RunService:BindToRenderStep("MythboundMouseLook", Enum.RenderPriority.Camera.Value + 1, function()
		local want = mouseLook and not firstPerson and not isBlocked() and character() ~= nil
		if want then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
			lockingMouse = true
		elseif lockingMouse then
			lockingMouse = false
			UserInputService.MouseIconEnabled = true
			if not firstPerson then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end
	end)

	ContextActionService:BindAction("MythboundHelp", function(_, state)
		if state == Enum.UserInputState.Begin then
			HUD.toggleControls()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.F1)

	RunService.RenderStepped:Connect(function(dt)
		attackCooldown = math.max(0, attackCooldown - dt)
		dashCooldown = math.max(0, dashCooldown - dt)
		local info = ClassData.get(player:GetAttribute("Class"))
		local interval = if info then info.interval else 1
		HUD.setCooldowns(1 - attackCooldown / interval, 1 - dashCooldown / Config.DASH_COOLDOWN)
		for slot = 1, 2 do
			skillCooldown[slot] = math.max(0, skillCooldown[slot] - dt)
		end
		HUD.setSkillCooldowns(1 - skillCooldown[1] / skillDuration[1], 1 - skillCooldown[2] / skillDuration[2])
		HUD.update(dt)

		-- If the button was released over a menu we never hear about it, so double-check.
		if attackHeld and attackInput and not stillHeld(attackInput) then
			attackHeld = false
		end

		local _, humanoid, root = character()
		if lockTarget then
			local targetRoot = if alive(lockTarget) then rootOf(lockTarget :: Model) else nil
			if not targetRoot or not root or (targetRoot.Position - root.Position).Magnitude > Config.LOCK_RANGE * 1.3 then
				setLock(nil)
			end
		end
		if humanoid and root then
			if lockTarget then
				-- Keep facing the locked target while moving.
				humanoid.AutoRotate = false
				local targetRoot = rootOf(lockTarget)
				if targetRoot then
					local to = flat(targetRoot.Position - root.Position)
					if to.Magnitude > 0.5 then
						root.CFrame = CFrame.lookAt(root.Position, root.Position + to)
					end
				end
			else
				humanoid.AutoRotate = true
			end
			if attackHeld and attackCooldown <= 0 and not isBlocked() then
				attack()
			end
		end

		-- Target frame: the locked target, otherwise whatever you hit in the last few seconds.
		local shown = lockTarget
		if not shown and recentTarget and os.clock() - recentTargetTime < 4 and alive(recentTarget) then
			shown = recentTarget
		end
		HUD.setTarget(shown)
	end)
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Visual effects drawn on each player's own screen: damage numbers, sword swings,
-- bolts and arrows, and hit sparks. The server decides what happens; these only show it.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Effects = {}

local folder: Folder? = nil
local function getFolder(): Folder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "LocalEffects"
		f.Parent = workspace
		folder = f
	end
	return folder :: Folder
end

local function effectPart(props: { [string]: any }): BasePart
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = getFolder()
	return part
end

local KIND_COLORS = {
	normal = Color3.fromRGB(255, 255, 255),
	crit = Color3.fromRGB(255, 210, 70),
	hurt = Color3.fromRGB(255, 90, 80),
	heal = Color3.fromRGB(120, 240, 140),
}

function Effects.damageNumber(position: Vector3, amount: number, kind: string)
	local anchor = Instance.new("Attachment")
	anchor.Parent = workspace.Terrain
	anchor.WorldPosition = position + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(100, 40)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = if kind == "crit" then 30 else 22
	label.TextColor3 = KIND_COLORS[kind] or KIND_COLORS.normal
	label.TextStrokeTransparency = 0.3
	label.Text = tostring(amount) .. (if kind == "crit" then "!" else "")
	label.Parent = gui
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(gui, info, { StudsOffset = Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 0.9)
end

function Effects.spark(position: Vector3, color: Color3)
	for _ = 1, 6 do
		local direction = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit
		local part = effectPart({ Size = Vector3.new(0.4, 0.4, 0.4), CFrame = CFrame.new(position), Color = color })
		TweenService:Create(part, TweenInfo.new(0.3), {
			CFrame = CFrame.new(position + direction * 3),
			Size = Vector3.new(0.05, 0.05, 0.05),
			Transparency = 1,
		}):Play()
		Debris:AddItem(part, 0.35)
	end
end

-- Loot lying on the ground: a small bobbing gem in the item's colour with its name. Only the
-- owner is sent drops, so in co-op each player sees just their own.
local drops: { [number]: BasePart } = {}

function Effects.showDrop(id: number, color: Color3, name: string, count: number, position: Vector3)
	local gem = effectPart({
		Name = "Drop",
		Size = Vector3.new(1.2, 1.2, 1.2),
		CFrame = CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = color,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 6
	light.Brightness = 1.5
	light.Parent = gem
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(120, 24)
	tag.StudsOffset = Vector3.new(0, 1.6, 0)
	tag.MaxDistance = 60
	tag.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = if count > 1 then `{name} ×{count}` else name
	label.Parent = tag
	tag.Parent = gem
	drops[id] = gem
	local start = os.clock()
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		if not gem.Parent then
			connection:Disconnect()
			return
		end
		local t = os.clock() - start
		gem.CFrame = CFrame.new(position + Vector3.new(0, math.sin(t * 3) * 0.3, 0)) * CFrame.Angles(math.rad(45), t * 1.5, math.rad(45))
	end)
end

function Effects.removeDrop(id: number)
	local gem = drops[id]
	if gem then
		drops[id] = nil
		Effects.spark(gem.Position, gem.Color)
		gem:Destroy()
	end
end

-- A flat ring of light expanding to `radius` (novas, explosions, heals, taunts).
function Effects.burst(position: Vector3, radius: number, color: Color3)
	local upright = CFrame.Angles(0, 0, math.rad(90))
	local ring = effectPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		CFrame = CFrame.new(position) * upright,
		Color = color,
		Transparency = 0.2,
	})
	TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.4)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = math.min(60, radius * 1.5)
	light.Brightness = 3
	light.Parent = ring
end

-- Makes a character see-through while its Vanished attribute is set (Ninja Vanish).
-- Your own character stays a little more visible so you can see where you are.
function Effects.watchCharacter(character: Model, isLocal: boolean)
	local function apply()
		local amount = if character:GetAttribute("Vanished") then (if isLocal then 0.6 else 0.85) else 0
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") or part:IsA("Decal") then
				part.LocalTransparencyModifier = amount
			end
		end
	end
	character:GetAttributeChangedSignal("Vanished"):Connect(apply)
end

-- Golden rings rising around a character who just levelled up.
function Effects.levelUp(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local base = root.Position - Vector3.new(0, 2.5, 0)
	local upright = CFrame.Angles(0, 0, math.rad(90))
	for i = 0, 2 do
		task.delay(i * 0.15, function()
			local ring = effectPart({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.25, 4, 4),
				CFrame = CFrame.new(base) * upright,
				Color = Color3.fromRGB(255, 214, 110),
				Transparency = 0.25,
			})
			TweenService:Create(ring, TweenInfo.new(0.9, Enum.EasingStyle.Quad), {
				Size = Vector3.new(0.25, 12, 12),
				CFrame = CFrame.new(base + Vector3.new(0, 7, 0)) * upright,
				Transparency = 1,
			}):Play()
			Debris:AddItem(ring, 0.95)
		end)
	end
	Effects.spark(root.Position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 230, 150))
end

-- A flat crescent of light in front of a melee attacker.
function Effects.swing(position: Vector3, direction: Vector3, color: Color3, range: number)
	local look = CFrame.lookAt(position, position + direction)
	local part = effectPart({
		Size = Vector3.new(range * 1.3, 0.2, range * 0.55),
		CFrame = look * CFrame.Angles(0, 0, math.rad(math.random(-15, 15))),
		Color = color,
		Transparency = 0.35,
	})
	TweenService:Create(part, TweenInfo.new(0.18), { Transparency = 1, Size = part.Size * Vector3.new(1.15, 1, 1.25) }):Play()
	Debris:AddItem(part, 0.2)
end

-- Draws a bolt or arrow flying from `start`. It stops at the first solid thing it meets,
-- the same way the server's projectile does.
function Effects.bolt(start: Vector3, velocity: Vector3, color: Color3, lifetime: number, arrow: boolean, shooter: Instance?, size: number?)
	local part = if arrow
		then effectPart({ Size = Vector3.new(0.25, 0.25, 3), Color = color, Material = Enum.Material.Wood })
		else effectPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * (size or 1.3), Color = color })
	if not arrow then
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 10
		light.Brightness = 2
		light.Parent = part
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { getFolder() }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	if shooter then
		table.insert(exclude, shooter)
	end
	local companions = workspace:FindFirstChild("Companions")
	if companions then
		table.insert(exclude, companions) -- bolts pass through companions, as on the server
	end
	params.FilterDescendantsInstances = exclude

	local position = start
	local age = 0
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function(dt)
		age += dt
		local step = velocity * dt
		local result = workspace:Raycast(position, step, params)
		if result or age >= lifetime then
			connection:Disconnect()
			if result then
				Effects.spark(result.Position, color)
			end
			part:Destroy()
			return
		end
		position += step
		part.CFrame = CFrame.lookAt(position, position + velocity)
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- In-game interface: health, cooldowns, target frame, dialogue, controls panel,
-- toasts, the area banner, the hurt flash, the first-person crosshair and the death screen.
-- Also the health chips for your companions (read from the replicated models in
-- workspace.Companions) and the trust meter shown while you feed a creature.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ClassData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ClassData"))
local SkillData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SkillData"))
local UI = require(script.Parent:WaitForChild("UI"))

local HUD = {}

local player = Players.LocalPlayer

local CONTROLS = table.concat({
	"<b>Move</b>  WASD · left stick",
	"<b>Look</b>  X mouse-look on/off · arrow keys · right mouse · right stick",
	"<b>Attack</b>  click or J · right trigger      <b>Skills</b>  Q · L1   E · R1",
	"<b>Jump</b>  Space · A      <b>Dash</b>  C · B      <b>Bag</b>  Tab · D-pad up",
	"<b>Potion</b>  H · D-pad down      <b>Companions</b>  P · D-pad left",
	"<b>Talk, gather, feed</b>  F · Y      <b>Lock on</b>  T · R3",
	"<b>Zoom</b>  scroll or I / O      <b>First person</b>  V · L3",
	"<b>This panel</b>  F1",
}, "\n")

local gui: ScreenGui
local classLabel: TextLabel
local hpFill: Frame
local hpText: TextLabel
local xpFill: Frame
local manaFill: Frame
local skillFills: { Frame } = {}
local skillLabels: { TextLabel } = {}
local className = "Adventurer"
local attackFill: Frame
local dashFill: Frame
local targetPanel: Frame
local targetName: TextLabel
local targetFill: Frame
local dialogue: TextButton
local dialogueSpeaker: TextLabel
local dialogueText: TextLabel
local controls: Frame
local controlsHint: TextLabel
local toastList: Frame
local banner: TextLabel
local vignette: Frame
local crosshair: Frame
local deathScreen: Frame
local trustPanel: Frame
local trustTitle: TextLabel
local trustFill: Frame
local trustHint: TextLabel
local companionList: Frame

type CompanionChip = { back: Frame, fill: Frame, label: TextLabel }
local companionChips: { [Model]: CompanionChip } = {}
local companionTimer = 0
local COMPANION_GREEN = Color3.fromRGB(95, 175, 95)

local dialogueLines: { string } = {}
local dialogueIndex = 0
local dialogueClosedAt = 0
local controlsOpen = true
local controlsTimer = 30
local lastHealth = 0

HUD.onChangeClass = nil :: (() -> ())?

-- The HUD's ScreenGui, so other HUD pieces (the quest tracker) show and hide with it.
function HUD.getGui(): ScreenGui
	return gui
end

-- Class, level and the XP bar, from the Level / XP / XPNext attributes the server keeps up to date.
local function refreshProgress()
	local level = (player:GetAttribute("Level") :: number?) or 1
	local xp = (player:GetAttribute("XP") :: number?) or 0
	local nextXp = (player:GetAttribute("XPNext") :: number?) or 1
	classLabel.Text = `{className} · Level {level}`
	xpFill.Size = UDim2.fromScale(math.clamp(xp / math.max(nextXp, 1), 0, 1), 1)
end

local function refreshMana()
	local mana = (player:GetAttribute("Mana") :: number?) or 0
	local maxMana = (player:GetAttribute("MaxMana") :: number?) or 1
	manaFill.Size = UDim2.fromScale(math.clamp(mana / math.max(maxMana, 1), 0, 1), 1)
end

-- One small health bar per companion of yours that is out, under the status panel.
local function refreshCompanions()
	local seen: { [Model]: boolean } = {}
	local folder = workspace:FindFirstChild("Companions")
	if folder then
		for _, model in folder:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if model:IsA("Model") and humanoid and model:GetAttribute("OwnerId") == player.UserId then
				seen[model] = true
				local chip = companionChips[model]
				if not chip then
					local back, fill = UI.bar(COMPANION_GREEN, 18)
					back.Name = "Companion"
					back.Parent = companionList
					local label = UI.label("", 12, UI.INK, true)
					label.TextXAlignment = Enum.TextXAlignment.Center
					label.Size = UDim2.fromScale(1, 1)
					label.ZIndex = 3
					label.Parent = back
					chip = { back = back, fill = fill, label = label }
					companionChips[model] = chip
				end
				local knocked = model:GetAttribute("KnockedOut") == true
				local name = (model:GetAttribute("CompanionName") :: string?) or model.Name
				chip.label.Text = if knocked then `{name} · knocked out` else name
				chip.fill.Size = UDim2.fromScale(if knocked then 0 else math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1), 1)
			end
		end
	end
	for model, chip in companionChips do
		if not seen[model] then
			chip.back:Destroy()
			companionChips[model] = nil
		end
	end
end

-- The trust meter, shown while you feed a creature. `trust` is 0-1.
function HUD.setTrust(name: string, trust: number, feedsLeft: number)
	trustTitle.Text = `{name} · trust`
	trustFill.Size = UDim2.fromScale(math.clamp(trust, 0, 1), 1)
	trustHint.Text = `Stay calm and feed it again ({feedsLeft} more). Don't attack, dash, jump or walk off.`
	trustPanel.Visible = true
end

function HUD.hideTrust()
	trustPanel.Visible = false
end

-- 0 = just used, 1 = ready.
function HUD.setSkillCooldowns(q: number, e: number)
	skillFills[1].Size = UDim2.fromScale(math.clamp(q, 0, 1), 1)
	skillFills[2].Size = UDim2.fromScale(math.clamp(e, 0, 1), 1)
end

function HUD.isDialogueOpen(): boolean
	return dialogue ~= nil and dialogue.Visible
end

local function closeDialogue()
	dialogue.Visible = false
	dialogueClosedAt = os.clock()
	ContextActionService:UnbindAction("MythboundDialogue")
	-- Prompts come back a moment later, so the key that closed the dialogue can't reopen it.
	task.delay(0.3, function()
		if not dialogue.Visible then
			ProximityPromptService.Enabled = true
		end
	end)
end

local function advanceDialogue()
	dialogueIndex += 1
	if dialogueIndex > #dialogueLines then
		closeDialogue()
	else
		dialogueText.Text = dialogueLines[dialogueIndex]
	end
end

function HUD.showDialogue(speaker: string, lines: { string })
	-- The key that closed the last dialogue can re-trigger the prompt; ignore that.
	if dialogue.Visible or os.clock() - dialogueClosedAt < 0.4 or #lines == 0 then
		return
	end
	-- While talking, prompts are switched off on this client. Otherwise F (the prompt key) would
	-- trigger the prompt again and restart the conversation instead of advancing it.
	ProximityPromptService.Enabled = false
	dialogueLines = lines
	dialogueIndex = 1
	dialogueSpeaker.Text = speaker
	dialogueText.Text = lines[1]
	dialogue.Visible = true
	ContextActionService:BindActionAtPriority("MythboundDialogue", function(_, state)
		if state == Enum.UserInputState.Begin then
			advanceDialogue()
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.F, Enum.KeyCode.E, Enum.KeyCode.Return, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonY)
end

function HUD.toast(text: string)
	local label = UI.make("TextLabel", {
		BackgroundColor3 = UI.PANEL,
		BackgroundTransparency = 0.2,
		Size = UDim2.fromOffset(340, 34),
		Text = text,
		TextColor3 = UI.INK,
		Font = UI.FONT_BOLD,
		TextSize = 16,
		Parent = toastList,
	}, { UI.corner(8) })
	task.delay(3, function()
		local fade = TweenInfo.new(0.5)
		TweenService:Create(label, fade, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		task.wait(0.5)
		label:Destroy()
	end)
end

function HUD.banner(text: string)
	banner.Text = text
	banner.TextTransparency = 1
	banner.TextStrokeTransparency = 1
	TweenService:Create(banner, TweenInfo.new(0.8), { TextTransparency = 0, TextStrokeTransparency = 0.5 }):Play()
	task.delay(3.5, function()
		TweenService:Create(banner, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

function HUD.setCooldowns(attack: number, dash: number)
	attackFill.Size = UDim2.fromScale(math.clamp(attack, 0, 1), 1)
	dashFill.Size = UDim2.fromScale(math.clamp(dash, 0, 1), 1)
end

function HUD.setTarget(model: Model?)
	if not model or not model.Parent then
		targetPanel.Visible = false
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		targetPanel.Visible = false
		return
	end
	targetPanel.Visible = true
	targetName.Text = humanoid.DisplayName ~= "" and humanoid.DisplayName or model.Name
	targetFill.Size = UDim2.fromScale(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 1)
end

-- A dot in the middle of the screen, for first person and mouse-look.
function HUD.setCrosshair(on: boolean)
	crosshair.Visible = on
end

-- Hides the whole HUD (behind the class select screen, and before the first spawn).
function HUD.setVisible(on: boolean)
	gui.Enabled = on
end

function HUD.toggleControls()
	controlsOpen = not controlsOpen
	controlsTimer = 0 -- once toggled by hand it stays as the player left it
end

function HUD.update(dt: number)
	if controlsTimer > 0 then
		controlsTimer -= dt
		if controlsTimer <= 0 then
			controlsOpen = false
		end
	end
	controls.Visible = controlsOpen and not dialogue.Visible
	controlsHint.Visible = not controls.Visible and not dialogue.Visible
	vignette.BackgroundTransparency = math.min(1, vignette.BackgroundTransparency + dt * 1.5)
	companionTimer -= dt
	if companionTimer <= 0 then
		companionTimer = 0.2
		refreshCompanions()
	end
end

local function onHealth(health: number, maxHealth: number)
	hpFill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
	hpText.Text = string.format("%d / %d", math.ceil(health), maxHealth)
	if health < lastHealth then
		vignette.BackgroundTransparency = 0.72
	end
	lastHealth = health
end

function HUD.bindCharacter(character: Model)
	deathScreen.Visible = false
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local info = ClassData.get(player:GetAttribute("Class"))
	className = if info then info.name else "Adventurer"
	refreshProgress()
	for slot, key in { "Q", "E" } do
		local skill = info and SkillData.forClass(info.id, slot)
		skillLabels[slot].Text = if skill then `{key} · {skill.name}` else key
	end
	lastHealth = humanoid.Health
	onHealth(humanoid.Health, humanoid.MaxHealth)
	humanoid.HealthChanged:Connect(function(health)
		onHealth(health, humanoid.MaxHealth)
	end)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		onHealth(humanoid.Health, humanoid.MaxHealth)
	end)
	humanoid.Died:Connect(function()
		deathScreen.Visible = true
	end)
end

function HUD.init()
	gui = UI.make("ScreenGui", {
		Name = "MythboundHUD",
		Enabled = false, -- shown once the character spawns
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
	})

	vignette = UI.make("Frame", {
		BackgroundColor3 = UI.RED,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 60),
		Position = UDim2.fromOffset(0, -60),
		ZIndex = 0,
		Parent = gui,
	})

	-- Health and cooldowns, top left.
	local status = UI.panel({ Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(280, 132), Parent = gui })
	UI.padding(10).Parent = status
	classLabel = UI.label("", 17, UI.GOLD, true)
	classLabel.Parent = status
	local hpBack
	hpBack, hpFill = UI.bar(UI.RED, 18)
	hpBack.Position = UDim2.fromOffset(0, 26)
	hpBack.Parent = status
	hpText = UI.label("", 13, UI.INK, true)
	hpText.TextXAlignment = Enum.TextXAlignment.Center
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.ZIndex = 3
	hpText.Parent = hpBack
	local chips = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 18), Parent = status })
	local manaBack
	manaBack, manaFill = UI.bar(Color3.fromRGB(80, 130, 230), 7)
	manaBack.Name = "ManaBar"
	manaBack.Position = UDim2.fromOffset(0, 46)
	manaBack.Parent = status
	for _, name in { "Mana", "MaxMana" } do
		player:GetAttributeChangedSignal(name):Connect(refreshMana)
	end
	local skillRow = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 18), Parent = status })
	local function chip(text: string, x: number, row: Frame?): (Frame, TextLabel)
		local back, fill = UI.bar(Color3.fromRGB(150, 120, 60), 18)
		back.Size = UDim2.new(0.5, -4, 1, 0)
		back.Position = UDim2.new(x, if x > 0 then 4 else 0, 0, 0)
		back.Parent = row or chips
		local label = UI.label(text, 12, UI.INK, true)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.Size = UDim2.fromScale(1, 1)
		label.ZIndex = 3
		label.Parent = back
		return fill, label
	end
	attackFill = chip("Attack", 0)
	dashFill = chip("Dash", 0.5)
	for slot = 1, 2 do
		skillFills[slot], skillLabels[slot] = chip(if slot == 1 then "Q" else "E", (slot - 1) * 0.5, skillRow)
	end
	refreshMana()
	local xpBack
	xpBack, xpFill = UI.bar(Color3.fromRGB(110, 175, 245), 8)
	xpBack.Name = "XPBar"
	xpBack.Position = UDim2.fromOffset(0, 102)
	xpBack.Parent = status
	for _, name in { "Level", "XP", "XPNext" } do
		player:GetAttributeChangedSignal(name):Connect(refreshProgress)
	end
	refreshProgress()

	-- Companion health chips, under the status panel.
	companionList = UI.make("Frame", {
		Name = "Companions",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 154),
		Size = UDim2.fromOffset(280, 90),
		Parent = gui,
	}, {
		UI.make("UIListLayout", { Padding = UDim.new(0, 4) }),
	})

	-- Trust meter, bottom centre, while feeding a creature.
	trustPanel = UI.panel({
		Name = "TrustMeter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(420, 72),
		Visible = false,
		Parent = gui,
	})
	UI.padding(10).Parent = trustPanel
	trustTitle = UI.label("", 15, UI.GOLD, true)
	trustTitle.Parent = trustPanel
	local trustBack
	trustBack, trustFill = UI.bar(Color3.fromRGB(240, 150, 70), 14)
	trustBack.Position = UDim2.fromOffset(0, 24)
	trustBack.Parent = trustPanel
	trustHint = UI.label("", 12, UI.MUTED)
	trustHint.Position = UDim2.fromOffset(0, 42)
	trustHint.Parent = trustPanel

	local change = UI.button("Change class", {
		Name = "ChangeClass",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(140, 34),
		TextSize = 14,
		Parent = gui,
	})
	change.Activated:Connect(function()
		if HUD.onChangeClass then
			HUD.onChangeClass()
		end
	end)

	-- Target frame, top centre.
	targetPanel = UI.panel({
		Name = "TargetFrame",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(300, 56),
		Visible = false,
		Parent = gui,
	})
	UI.padding(8).Parent = targetPanel
	targetName = UI.label("", 15, UI.INK, true)
	targetName.TextXAlignment = Enum.TextXAlignment.Center
	targetName.Parent = targetPanel
	local targetBack
	targetBack, targetFill = UI.bar(UI.RED, 12)
	targetBack.Position = UDim2.fromOffset(0, 24)
	targetBack.Parent = targetPanel

	-- Area banner.
	banner = UI.make("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.fromOffset(600, 50),
		Font = UI.FONT_BOLD,
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 240, 210),
		TextStrokeColor3 = Color3.fromRGB(40, 25, 10),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Text = "",
		Parent = gui,
	})

	-- Toasts, right side.
	toastList = UI.make("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 180), -- below the quest tracker
		Size = UDim2.fromOffset(340, 300),
		Parent = gui,
	}, {
		UI.make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right }),
	})

	-- Dialogue box, bottom centre. Clicking it also advances.
	dialogue = UI.make("TextButton", {
		Name = "Dialogue",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = UI.PANEL,
		BackgroundTransparency = 0.08,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(0.6, 0, 0, 140),
		Visible = false,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(UI.GOLD), UI.padding(16), UI.make("UISizeConstraint", { MinSize = Vector2.new(320, 0), MaxSize = Vector2.new(760, 200) }) })
	dialogueSpeaker = UI.label("", 20, UI.GOLD, true)
	dialogueSpeaker.Parent = dialogue
	dialogueText = UI.label("", 18)
	dialogueText.TextWrapped = true
	dialogueText.TextYAlignment = Enum.TextYAlignment.Top
	dialogueText.Position = UDim2.fromOffset(0, 30)
	dialogueText.Size = UDim2.new(1, 0, 1, -50)
	dialogueText.Parent = dialogue
	local more = UI.label("F, Enter or click to continue", 13, UI.MUTED)
	more.TextXAlignment = Enum.TextXAlignment.Right
	more.AnchorPoint = Vector2.new(0, 1)
	more.Position = UDim2.fromScale(0, 1)
	more.Parent = dialogue
	dialogue.Activated:Connect(advanceDialogue)

	-- Controls panel, bottom left; tucks itself away after 30 seconds.
	controls = UI.panel({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(470, 194),
		Parent = gui,
	})
	UI.padding(12).Parent = controls
	local controlsText = UI.label(CONTROLS, 14)
	controlsText.RichText = true
	controlsText.TextYAlignment = Enum.TextYAlignment.Top
	controlsText.Size = UDim2.fromScale(1, 1)
	controlsText.LineHeight = 1.15
	controlsText.Parent = controls
	controlsHint = UI.label("F1  Controls", 13, UI.MUTED)
	controlsHint.AnchorPoint = Vector2.new(0, 1)
	controlsHint.Position = UDim2.new(0, 18, 1, -10)
	controlsHint.Size = UDim2.fromOffset(200, 20)
	controlsHint.Parent = gui

	crosshair = UI.make("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = gui,
	}, { UI.corner(3) })

	deathScreen = UI.make("Frame", {
		Name = "DeathScreen",
		BackgroundColor3 = Color3.fromRGB(20, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.new(1, 0, 1, 60),
		Position = UDim2.fromOffset(0, -60),
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	local fell = UI.label("You fell. Returning to Hearthmoor…", 34, Color3.fromRGB(255, 220, 210), true)
	fell.TextXAlignment = Enum.TextXAlignment.Center
	fell.AnchorPoint = Vector2.new(0.5, 0.5)
	fell.Position = UDim2.fromScale(0.5, 0.5)
	fell.Size = UDim2.fromOffset(700, 50)
	fell.ZIndex = 11
	fell.Parent = deathScreen

	gui.Parent = player:WaitForChild("PlayerGui")
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">InventoryUI</string><ProtectedString name="Source"><![CDATA[-- The bag (Tab, controller D-pad up) and the workbench panel (opened by the workbench prompt).
-- Counts come from the server (Inventory event); buttons only send requests (UseItem, Craft).
-- H (controller D-pad down) drinks a healing potion. Works with mouse, controller and touch.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemData = require(Shared:WaitForChild("ItemData"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))

local InventoryUI = {}

local player = Players.LocalPlayer
local useEvent = Net.event("UseItem")
local craftEvent = Net.event("Craft")

local counts: { [string]: number } = {}
local gui: ScreenGui
local bagPanel: Frame
local grid: Frame
local detailName: TextLabel
local detailText: TextLabel
local useButton: TextButton
local craftPanel: Frame
local craftList: Frame
local selectedItem: string? = nil
local canOpen: () -> boolean = function()
	return true
end

-- Called when the bag or the workbench opens, so other panels can close.
InventoryUI.onOpen = nil :: (() -> ())?

function InventoryUI.isOpen(): boolean
	return gui ~= nil and (bagPanel.Visible or craftPanel.Visible)
end

function InventoryUI.count(itemId: string): number
	return counts[itemId] or 0
end

local function usingGamepad(): boolean
	return UserInputService:GetLastInputType().Name:sub(1, 7) == "Gamepad"
end

local function refreshDetail()
	local item = selectedItem and ItemData.items[selectedItem]
	if item and (counts[item.id] or 0) > 0 then
		detailName.Text = `{item.name} ×{counts[item.id]}`
		detailText.Text = item.description
		useButton.Visible = item.usable == true
	else
		detailName.Text = ""
		detailText.Text = if next(counts) then "Choose an item." else "Your bag is empty. Defeat creatures, or gather wheat, honey and apples in the village."
		useButton.Visible = false
	end
end

local function slot(item: ItemData.Item, count: number, order: number)
	local button = UI.button("", {
		Name = item.id,
		Size = UDim2.fromOffset(84, 84),
		LayoutOrder = order,
		BackgroundColor3 = if selectedItem == item.id then Color3.fromRGB(110, 85, 45) else Color3.fromRGB(44, 36, 58),
		Parent = grid,
	})
	UI.make("Frame", {
		BackgroundColor3 = item.color,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(34, 34),
		Parent = button,
	}, { UI.corner(17) })
	local name = UI.label(item.name, 12, UI.INK, true)
	name.TextXAlignment = Enum.TextXAlignment.Center
	name.Position = UDim2.fromOffset(0, 46)
	name.TextWrapped = true
	name.Size = UDim2.new(1, 0, 0, 16)
	name.Parent = button
	local amount = UI.label(`×{count}`, 13, UI.GOLD, true)
	amount.TextXAlignment = Enum.TextXAlignment.Center
	amount.Position = UDim2.fromOffset(0, 62)
	amount.Size = UDim2.new(1, 0, 0, 18)
	amount.Parent = button
	button.Activated:Connect(function()
		selectedItem = item.id
		InventoryUI.refresh()
	end)
	return button
end

local function recipeRow(recipe: ItemData.Recipe, order: number)
	local item = ItemData.items[recipe.id]
	local parts = {}
	local ready = true
	for itemId, need in recipe.ingredients do
		local have = counts[itemId] or 0
		if have < need then
			ready = false
		end
		table.insert(parts, `{need} {ItemData.items[itemId].name} ({have})`)
	end
	table.sort(parts)
	local row = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = order, Parent = craftList })
	local title = UI.label(item.name, 16, UI.GOLD, true)
	title.Size = UDim2.new(1, -110, 0, 22)
	title.Parent = row
	local needs = UI.label(table.concat(parts, " + "), 13, if ready then UI.INK else UI.MUTED)
	needs.Position = UDim2.fromOffset(0, 24)
	needs.Size = UDim2.new(1, -110, 0, 20)
	needs.Parent = row
	local craft = UI.button("Craft", {
		Name = "Craft_" .. recipe.id,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(96, 36),
		TextSize = 15,
		BackgroundColor3 = if ready then Color3.fromRGB(70, 110, 60) else Color3.fromRGB(50, 44, 58),
		AutoButtonColor = ready,
		Parent = row,
	})
	craft.Activated:Connect(function()
		if ready then
			craftEvent:FireServer(recipe.id)
		end
	end)
	return craft
end

function InventoryUI.refresh()
	if not gui then
		return
	end
	for _, child in grid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local first: GuiObject? = nil
	for order, itemId in ItemData.order do
		local count = counts[itemId] or 0
		if count > 0 then
			local button = slot(ItemData.items[itemId], count, order)
			first = first or button
		end
	end
	refreshDetail()
	for _, child in craftList:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local firstCraft: GuiObject? = nil
	for order, recipe in ItemData.recipes do
		local button = recipeRow(recipe, order)
		firstCraft = firstCraft or button
	end
	-- Keep controller selection inside an open panel after rebuilding it.
	if usingGamepad() then
		local selected = GuiService.SelectedObject
		if not selected or not selected:IsDescendantOf(gui) then
			GuiService.SelectedObject = if craftPanel.Visible then firstCraft elseif bagPanel.Visible then first else nil
		end
	end
end

function InventoryUI.setCounts(newCounts: { [string]: number })
	counts = newCounts
	InventoryUI.refresh()
end

local function close()
	bagPanel.Visible = false
	craftPanel.Visible = false
	local selected = GuiService.SelectedObject
	if selected and selected:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
end

function InventoryUI.toggleBag()
	if bagPanel.Visible then
		close()
	elseif canOpen() then
		if InventoryUI.onOpen then
			InventoryUI.onOpen()
		end
		bagPanel.Visible = true
		InventoryUI.refresh()
	end
end

-- The workbench prompt calls this (through OpenCrafting): shows recipes beside the bag.
function InventoryUI.openCrafting()
	if not canOpen() then
		return
	end
	if InventoryUI.onOpen then
		InventoryUI.onOpen()
	end
	bagPanel.Visible = true
	craftPanel.Visible = true
	InventoryUI.refresh()
end

-- `allowed` says whether the bag may open now (not during dialogue or class select).
function InventoryUI.init(parent: Instance, allowed: () -> boolean)
	canOpen = allowed
	gui = UI.make("ScreenGui", {
		Name = "Inventory",
		ResetOnSpawn = false,
		DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	bagPanel = UI.panel({
		Name = "Bag",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, 10, 0.5, 0),
		Size = UDim2.fromOffset(420, 360),
		Visible = false,
		Parent = gui,
	})
	UI.padding(14).Parent = bagPanel
	local title = UI.label("Bag", 20, UI.GOLD, true)
	title.Parent = bagPanel
	local closeButton = UI.button("Close", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -2),
		Size = UDim2.fromOffset(80, 28),
		TextSize = 14,
		Parent = bagPanel,
	})
	closeButton.Activated:Connect(close)
	grid = UI.make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 180),
		Parent = bagPanel,
	}, {
		UI.make("UIGridLayout", { CellSize = UDim2.fromOffset(84, 84), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	detailName = UI.label("", 17, UI.INK, true)
	detailName.Position = UDim2.fromOffset(0, 226)
	detailName.Parent = bagPanel
	detailText = UI.label("", 14, UI.MUTED)
	detailText.TextWrapped = true
	detailText.TextYAlignment = Enum.TextYAlignment.Top
	detailText.Position = UDim2.fromOffset(0, 252)
	detailText.Size = UDim2.new(1, -110, 0, 60)
	detailText.Parent = bagPanel
	useButton = UI.button("Use", {
		Name = "Use",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(96, 36),
		TextSize = 15,
		Visible = false,
		Parent = bagPanel,
	})
	useButton.Activated:Connect(function()
		if selectedItem then
			useEvent:FireServer(selectedItem)
		end
	end)

	craftPanel = UI.panel({
		Name = "Workbench",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0.5, -10, 0.5, 0),
		Size = UDim2.fromOffset(380, 360),
		Visible = false,
		Parent = gui,
	})
	UI.padding(14).Parent = craftPanel
	local craftTitle = UI.label("Workbench", 20, UI.GOLD, true)
	craftTitle.Parent = craftPanel
	craftList = UI.make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -36),
		Parent = craftPanel,
	}, {
		UI.make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	ContextActionService:BindAction("MythboundBag", function(_, state)
		if state == Enum.UserInputState.Begin then
			InventoryUI.toggleBag()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.DPadUp)
	-- Roblox's player list claims Tab before ContextActionService sees it, so listen directly
	-- (but not while the player is typing in a text box).
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Tab and not UserInputService:GetFocusedTextBox() then
			InventoryUI.toggleBag()
		end
	end)
	pcall(function()
		ContextActionService:SetTitle("MythboundBag", "Bag")
		ContextActionService:SetPosition("MythboundBag", UDim2.new(1, -300, 1, -90))
	end)
	ContextActionService:BindAction("MythboundPotion", function(_, state)
		if state == Enum.UserInputState.Begin and canOpen() then
			-- Always ask: the server explains if there are none left.
			useEvent:FireServer("healing_potion")
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.H, Enum.KeyCode.DPadDown)
	pcall(function()
		ContextActionService:SetTitle("MythboundPotion", "Potion")
		ContextActionService:SetPosition("MythboundPotion", UDim2.new(1, -300, 1, -160))
	end)

	refreshDetail()
	gui.Parent = parent
end

-- Closes everything (when the class screen or a dialogue opens, or the character dies).
function InventoryUI.close()
	if gui then
		close()
	end
end

return InventoryUI
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000026"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Client entry point: class select, HUD, controls, effects, the bag and the companion panel.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local ClassSelect = require(script.Parent:WaitForChild("ClassSelect"))
local CompanionPanel = require(script.Parent:WaitForChild("CompanionPanel"))
local Controls = require(script.Parent:WaitForChild("Controls"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local InventoryUI = require(script.Parent:WaitForChild("InventoryUI"))
local ItemData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemData"))
local QuestTracker = require(script.Parent:WaitForChild("QuestTracker"))

local player = Players.LocalPlayer

-- Our own health bar replaces Roblox's. SetCore can fail if called too early, so retry briefly.
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

HUD.init()
QuestTracker.init(HUD.getGui())
InventoryUI.init(player:WaitForChild("PlayerGui"), function()
	return player.Character ~= nil and not HUD.isDialogueOpen() and not ClassSelect.isOpen()
end)
CompanionPanel.init(player:WaitForChild("PlayerGui"), function()
	return player.Character ~= nil and not HUD.isDialogueOpen() and not ClassSelect.isOpen()
end)
-- Only one panel at a time: opening the bag closes the companion panel and the other way round.
CompanionPanel.onOpen = InventoryUI.close
InventoryUI.onOpen = CompanionPanel.close
HUD.onChangeClass = function()
	ClassSelect.open()
end

-- The HUD shows only while you have a character and the class screen is closed.
local classScreenOpen = false
local function refreshHUD()
	HUD.setVisible(player.Character ~= nil and not classScreenOpen)
end
ClassSelect.onToggle = function(open: boolean)
	classScreenOpen = open
	if open then
		InventoryUI.close()
		CompanionPanel.close()
		HUD.hideTrust()
	end
	refreshHUD()
end

Controls.start(function()
	return HUD.isDialogueOpen() or ClassSelect.isOpen() or InventoryUI.isOpen() or CompanionPanel.isOpen()
end)

local firstSpawn = true
local function onCharacter(character: Model)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	camera.CameraSubject = humanoid
	-- Start behind the character, looking the way it faces (towards the Elder on arrival),
	-- instead of keeping whatever angle the menu camera had.
	local root = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if root then
		local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
		camera.CFrame = CFrame.lookAt(root.Position - look * 16 + Vector3.new(0, 7, 0), root.Position + Vector3.new(0, 2, 0))
	end
	Controls.reset()
	HUD.bindCharacter(character)
	refreshHUD()
	if firstSpawn then
		firstSpawn = false
		HUD.banner("Hearthmoor Village")
		HUD.toast("Talk to Elder Maren to begin")
	end
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

Net.event("DamageNumber").OnClientEvent:Connect(function(model: Model?, position: Vector3, amount: number, kind: string, attacker: Player?)
	Effects.damageNumber(position, amount, kind)
	if attacker == player and model then
		Controls.noteHit(model)
	end
end)

Net.event("Effect").OnClientEvent:Connect(function(kind: string, ...)
	if kind == "swing" then
		Effects.swing(...)
	elseif kind == "bolt" then
		Effects.bolt(...)
	elseif kind == "burst" then
		Effects.burst(...)
	elseif kind == "spark" then
		Effects.spark(...)
	end
end)

Net.event("Dialogue").OnClientEvent:Connect(function(speaker: string, lines: { string })
	HUD.showDialogue(speaker, lines)
end)

Net.event("Toast").OnClientEvent:Connect(function(text: string)
	HUD.toast(text)
end)

Net.event("SkillUsed").OnClientEvent:Connect(function(slot: number, cooldown: number)
	Controls.onSkillUsed(slot, cooldown)
end)

-- Watch every character (yours and other players') for the Ninja's Vanish.
local function watchPlayer(other: Player)
	other.CharacterAdded:Connect(function(character)
		Effects.watchCharacter(character, other == player)
	end)
	if other.Character then
		Effects.watchCharacter(other.Character, other == player)
	end
end
Players.PlayerAdded:Connect(watchPlayer)
for _, other in Players:GetPlayers() do
	watchPlayer(other)
end

Net.event("Inventory").OnClientEvent:Connect(function(counts)
	InventoryUI.setCounts(counts)
end)

Net.event("OpenCrafting").OnClientEvent:Connect(function()
	InventoryUI.openCrafting()
end)

Net.event("DropSpawned").OnClientEvent:Connect(function(id: number, itemId: string, count: number, position: Vector3)
	local item = ItemData.get(itemId)
	if item then
		Effects.showDrop(id, item.color, item.name, count, position)
	end
end)

Net.event("DropTaken").OnClientEvent:Connect(function(id: number)
	Effects.removeDrop(id)
end)

Net.event("Companions").OnClientEvent:Connect(function(rows, limit: number, stableSize: number)
	CompanionPanel.setRoster(rows, limit, stableSize)
end)

-- The trust meter while feeding a creature: "progress" (detail = feeds left), "tamed"
-- (detail = the creature's name) or "failed" (detail = why, or "" to say nothing).
Net.event("Taming").OnClientEvent:Connect(function(model: Model?, trust: number, state: string, detail: any)
	if state == "progress" then
		HUD.setTrust(if model then model.Name else "Creature", trust, detail)
	elseif state == "tamed" then
		HUD.hideTrust()
		HUD.banner(`{detail} tamed!`)
		HUD.toast(`The {string.lower(detail)} will follow you and fight for you`)
	else
		HUD.hideTrust()
		if typeof(detail) == "string" and detail ~= "" then
			HUD.toast(detail)
		end
	end
end)

Net.event("QuestUpdate").OnClientEvent:Connect(function(quests)
	QuestTracker.update(quests)
end)

Net.event("LevelUp").OnClientEvent:Connect(function(who: Player, level: number)
	if who.Character then
		Effects.levelUp(who.Character)
	end
	if who == player then
		HUD.banner(`Level {level}!`)
	end
end)

-- First visit: choose a class. The world must exist before the server will spawn us.
ClassSelect.open()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">QuestTracker</string><ProtectedString name="Source"><![CDATA[-- The quest tracker (top right) and the "!" / "?" markers over quest givers. The server sends
-- this player's quests through QuestUpdate; markers exist only on this player's screen, so in
-- co-op each player sees their own.

local Players = game:GetService("Players")

local UI = require(script.Parent:WaitForChild("UI"))

local QuestTracker = {}

local player = Players.LocalPlayer
local panel: Frame
local rows: Frame
local markers: { [string]: BillboardGui } = {}
local lastQuests: { { [string]: any } } = {}

-- Where each quest giver's head is in the world.
local GIVER_PATHS = {
	elder = { "Village", "ElderMaren", "Head" },
}

local function giverHead(giver: string): BasePart?
	local inst: Instance? = workspace
	for _, name in GIVER_PATHS[giver] or {} do
		inst = inst and inst:FindFirstChild(name)
	end
	return if inst and inst:IsA("BasePart") then inst else nil
end

-- Shows `symbol` over the giver, or hides the marker when it is nil. Returns false if the giver
-- hasn't streamed in yet.
local function setMarker(giver: string, symbol: string?): boolean
	local gui = markers[giver]
	if gui and not gui.Parent then
		gui = nil -- removed (e.g. the giver's model was rebuilt); make a new one
	end
	if not gui then
		local head = giverHead(giver)
		if not head then
			return false
		end
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "QuestMarker"
		billboard.ResetOnSpawn = false -- keep it when the player respawns
		billboard.Size = UDim2.fromOffset(44, 56)
		billboard.StudsOffset = Vector3.new(0, 5, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 250
		billboard.Adornee = head
		local label = Instance.new("TextLabel")
		label.Name = "Symbol"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = UI.GOLD
		label.TextStrokeTransparency = 0.2
		label.Parent = billboard
		billboard.Parent = player:WaitForChild("PlayerGui")
		markers[giver] = billboard
		gui = billboard
	end
	gui.Enabled = symbol ~= nil
	(gui:FindFirstChild("Symbol") :: TextLabel).Text = symbol or ""
	return true
end

local function row(title: string, detail: string)
	local frame = UI.make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = rows,
	})
	local heading = UI.label(title, 16, UI.GOLD, true)
	heading.Parent = frame
	local line = UI.label(detail, 14, UI.INK)
	line.Position = UDim2.fromOffset(0, 22)
	line.Parent = frame
end

function QuestTracker.update(quests: { { [string]: any } })
	lastQuests = quests
	for _, child in rows:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local shown = 0
	local giverSymbol: { [string]: string } = {}
	for _, quest in quests do
		if quest.status == "active" then
			row(quest.title, `{quest.summary}: {quest.progress} / {quest.count}`)
			shown += 1
		elseif quest.status == "ready" then
			row(quest.title, `Return to {quest.giverName}`)
			shown += 1
			if giverSymbol[quest.giver] ~= "!" then
				giverSymbol[quest.giver] = "?"
			end
		elseif quest.status == "available" then
			giverSymbol[quest.giver] = "!"
		end
	end
	panel.Size = UDim2.fromOffset(300, 34 + shown * 48)
	panel.Visible = shown > 0
	local missing = false
	for giver in GIVER_PATHS do
		if not setMarker(giver, giverSymbol[giver]) then
			missing = true
		end
	end
	if missing then
		-- A giver hasn't arrived yet; try again shortly.
		task.delay(1, function()
			if lastQuests == quests then
				QuestTracker.update(quests)
			end
		end)
	end
end

function QuestTracker.init(parent: ScreenGui)
	panel = UI.panel({
		Name = "QuestTracker",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 60),
		Size = UDim2.fromOffset(300, 80),
		Visible = false,
		Parent = parent,
	})
	UI.padding(10).Parent = panel
	local heading = UI.label("Quests", 13, UI.MUTED, true)
	heading.Parent = panel
	rows = UI.make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 1, -20),
		Parent = panel,
	}, {
		UI.make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

return QuestTracker
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Small helpers and the shared look for all interface pieces.

local UI = {}

UI.INK = Color3.fromRGB(236, 230, 218)
UI.MUTED = Color3.fromRGB(170, 162, 150)
UI.GOLD = Color3.fromRGB(240, 196, 90)
UI.PANEL = Color3.fromRGB(24, 20, 34)
UI.PANEL_EDGE = Color3.fromRGB(120, 96, 60)
UI.RED = Color3.fromRGB(205, 55, 50)
UI.FONT = Enum.Font.Gotham
UI.FONT_BOLD = Enum.Font.GothamBold

-- Creates an instance, sets properties, adds children. Parent is set last.
function UI.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.make("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.stroke(color: Color3?, thickness: number?): UIStroke
	return UI.make("UIStroke", {
		Color = color or UI.PANEL_EDGE,
		Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(pixels: number): UIPadding
	local p = UDim.new(0, pixels)
	return UI.make("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function UI.panel(props: { [string]: any }): Frame
	local frame = UI.make("Frame", {
		BackgroundColor3 = UI.PANEL,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
	}, { UI.corner(10), UI.stroke() })
	for key, value in props do
		if key ~= "Parent" then
			frame[key] = value
		end
	end
	if props.Parent then
		frame.Parent = props.Parent
	end
	return frame
end

function UI.label(text: string, size: number?, color: Color3?, bold: boolean?): TextLabel
	return UI.make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 18,
		TextColor3 = color or UI.INK,
		Font = if bold then UI.FONT_BOLD else UI.FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, (size or 18) + 6),
	})
end

-- A horizontal bar. Returns the background frame and the fill frame.
function UI.bar(color: Color3, height: number): (Frame, Frame)
	local back = UI.make("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 34, 48),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height),
	}, { UI.corner(4) })
	local fill = UI.make("Frame", {
		Name = "Fill",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = back,
	}, { UI.corner(4) })
	return back, fill
end

function UI.button(text: string, props: { [string]: any }?): TextButton
	local button = UI.make("TextButton", {
		BackgroundColor3 = Color3.fromRGB(44, 36, 58),
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Text = text,
		TextColor3 = UI.INK,
		Font = UI.FONT_BOLD,
		TextSize = 18,
	}, { UI.corner(8), UI.stroke() })
	if props then
		for key, value in props do
			if key ~= "Parent" then
				button[key] = value
			end
		end
		if props.Parent then
			button.Parent = props.Parent
		end
	end
	return button
end

return UI
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Players" referent="RBX0000002C"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool><float name="RespawnTime">3</float></Properties></Item></roblox>
